---
import "@/styles/global.css"
import { execSync } from "node:child_process"
import { Font } from "astro:assets"
import { faq } from "@/data/faq"

function getLastModified() {
  try {
    const committedAt = execSync("git log -1 --format=%cI", {
      encoding: "utf8",
    }).trim()
    if (committedAt) return new Date(committedAt).toISOString()
  } catch {}
  return new Date().toISOString()
}

const lastModified = getLastModified()

// Zgody cookies, GTM i Meta Pixel – tylko produkcja (dev nie zaśmieca statystyk)
const enableGoogleTagManager = import.meta.env.PROD
const enableMetaPixel = import.meta.env.PROD

const priceValidUntil = new Date(
  Date.UTC(new Date().getUTCFullYear(), 11, 31)
).toISOString()

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  canonical?: string | false
  ogType?: "website" | "article"
  /** Extra JSON-LD nodes appended to the site graph (e.g. Article, BreadcrumbList). */
  jsonLd?: Record<string, unknown>[]
  /** Enable only on pages that actually render the homepage FAQ. */
  includeFaqSchema?: boolean
}

const {
  title = "Sprawdź pomysł na aplikację w 4 tygodnie | Karol Modelski",
  description = "Masz pomysł na aplikację? Zbuduję jej pierwszą wersję w 4 tygodnie. Bez szukania programistów i znajomości technologii – od pomysłu do działającego produktu.",
  noindex = false,
  canonical,
  ogType = "website",
  jsonLd = [],
  includeFaqSchema = false,
} = Astro.props

const canonicalURL =
  canonical === false
    ? null
    : (canonical ?? new URL(Astro.url.pathname, Astro.site)).toString()
const ogURL = canonicalURL ?? new URL("/", Astro.site).toString()
const ogImage = new URL("/og-image.png", Astro.site)

const pageURL =
  canonicalURL ?? new URL(Astro.url.pathname, Astro.site).toString()

const structuredData = noindex
  ? null
  : {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": `${pageURL}#webpage`,
          url: pageURL,
          name: title,
          description,
          inLanguage: "pl-PL",
          isPartOf: { "@id": "https://www.karolmodelski.pl/#website" },
          about: { "@id": "https://www.karolmodelski.pl/#organization" },
          dateModified: lastModified,
        },
        {
          "@type": "Organization",
          "@id": "https://www.karolmodelski.pl/#organization",
          name: "Karol Modelski",
          url: "https://www.karolmodelski.pl/",
          logo: "https://www.karolmodelski.pl/logo.png",
          image: "https://www.karolmodelski.pl/og-image.png",
          email: "kontakt@karolmodelski.pl",
          telephone: "+48664598563",
          taxID: "6112800950",
          description:
            "Pomagam osobom z pomysłem na aplikację zamienić go w pierwszy działający produkt – od uporządkowania pomysłu, przez projektowanie i programowanie, po uruchomienie aplikacji i przygotowanie jej do pierwszych testów. Prowadzę projekt i zespół specjalistów, a pierwsza działająca wersja powstaje w 4 tygodnie.",
          areaServed: "PL",
          knowsLanguage: "pl",
          address: {
            "@type": "PostalAddress",
            addressCountry: "PL",
          },
          sameAs: [
            "https://www.linkedin.com/in/karol-modelski/",
            "https://g.page/r/CZSVfAGtTiIzEBM",
            "https://github.com/CodeWithKarol",
            "https://x.com/modelski_karol",
            "https://karol-modelski.medium.com/",
            "https://karol-modelski.hashnode.dev/",
          ],
          contactPoint: {
            "@type": "ContactPoint",
            contactType: "sales",
            email: "kontakt@karolmodelski.pl",
            telephone: "+48664598563",
            availableLanguage: ["pl"],
          },
          founder: { "@id": "https://www.karolmodelski.pl/#person" },
        },
        {
          "@type": "Person",
          "@id": "https://www.karolmodelski.pl/#person",
          name: "Karol Modelski",
          url: "https://www.karolmodelski.pl/",
          image: "https://www.karolmodelski.pl/karol-modelski.webp",
          jobTitle: "Twórca aplikacji i produktów cyfrowych",
          description:
            "Techniczny partner pomysłodawców i inwestorów: po latach pracy przy zaawansowanych systemach dla banków i korporacji pomaga budować produkty, które mają sens – najpierw ustala, co w pomyśle jest najważniejsze, a potem zamienia to w działającą aplikację webową w 4 tygodnie, z gwarancją terminu i przeniesieniem 100% majątkowych praw autorskich w uzgodnionym zakresie na klienta.",
          knowsAbout: [
            "tworzenie aplikacji",
            "Pierwsza działająca wersja aplikacji w 4 tygodnie",
            "produkty cyfrowe",
            "walidacja pomysłów na rynku",
            "ograniczanie zakresu produktu (MVP)",
            "programowanie systemów bankowych",
            "React",
            "Astro",
          ],
          sameAs: [
            "https://www.linkedin.com/in/karol-modelski/",
            "https://g.page/r/CZSVfAGtTiIzEBM",
            "https://github.com/CodeWithKarol",
            "https://x.com/modelski_karol",
            "https://karol-modelski.medium.com/",
            "https://karol-modelski.hashnode.dev/",
          ],
          worksFor: { "@id": "https://www.karolmodelski.pl/#organization" },
        },
        {
          "@type": "WebSite",
          "@id": "https://www.karolmodelski.pl/#website",
          url: "https://www.karolmodelski.pl/",
          name: "Karol Modelski",
          inLanguage: "pl-PL",
          publisher: { "@id": "https://www.karolmodelski.pl/#organization" },
        },
        {
          "@type": "Service",
          "@id": "https://www.karolmodelski.pl/#proces",
          name: "Proces w 4 tygodnie – od pomysłu do działającej aplikacji webowej",
          provider: { "@id": "https://www.karolmodelski.pl/#organization" },
          serviceType: "Tworzenie aplikacji i produktów cyfrowych",
          areaServed: "PL",
          url: "https://www.karolmodelski.pl/#proces",
          description:
            "Tworzenie działającej aplikacji webowej, własnej strony i podglądu zachowań użytkowników w 4 tygodnie – z gwarancją terminu i przeniesieniem 100% majątkowych praw autorskich w uzgodnionym zakresie na klienta.",
          offers: {
            "@type": "Offer",
            url: "https://www.karolmodelski.pl/#konsultacja",
            description:
              "Pierwsza działająca wersja w 4 tygodnie, pełny odbiór z poprawkami zwykle 6–8 tygodni. Stała cena za uzgodniony zakres, bez dopłat za poprawki niezgodności z ustaleniami. Kary umowne za zawinione opóźnienie na zasadach określonych w umowie; 3 miesiące gwarancji technicznej – błędy i usterki w uzgodnionym zakresie usuwamy bez dodatkowych opłat.",
            priceCurrency: "PLN",
            price: "29500",
            priceSpecification: {
              "@type": "PriceSpecification",
              price: "29500",
              priceCurrency: "PLN",
              valueAddedTaxIncluded: true,
            },
            priceValidUntil,
            availability: "https://schema.org/InStock",
          },
        },
        ...(includeFaqSchema
          ? [
              {
                "@type": "FAQPage",
                "@id": `${pageURL}#faq`,
                mainEntity: faq.map(({ question, answer }) => ({
                  "@type": "Question",
                  name: question,
                  acceptedAnswer: {
                    "@type": "Answer",
                    text: answer.replace(/\n\n/g, " "),
                  },
                })),
              },
            ]
          : []),
        ...jsonLd,
      ],
    }
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {enableGoogleTagManager && <script is:inline>
      ;(function (w, d, s, l, i) {
        w[l] = w[l] || []
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" })
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : ""
        j.async = true
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl
        f.parentNode.insertBefore(j, f)
      })(window, document, "script", "dataLayer", "GTM-N3QL4956")
    </script>}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f5f2" />
    <Font cssVariable="--font-inter" preload />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Karol Modelski" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Karol Modelski" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={ogURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Karol Modelski – pierwsza działająca wersja Twojego pomysłu w 4 tygodnie"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@modelski_karol" />
    <meta name="twitter:creator" content="@modelski_karol" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Karol Modelski – pierwsza działająca wersja Twojego pomysłu w 4 tygodnie"
    />

    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        try {
          var saved = localStorage.getItem("theme")
          if (
            saved === "dark" ||
            (!saved && matchMedia("(prefers-color-scheme: dark)").matches)
          )
            root.classList.add("dark")
        } catch (e) {}

        function syncThemeToggle() {
          var btn = document.getElementById("theme-toggle")
          if (btn)
            btn.setAttribute(
              "aria-pressed",
              root.classList.contains("dark") ? "true" : "false"
            )
        }

        document.addEventListener("click", function (ev) {
          var t = ev.target
          if (t && t.closest && t.closest("#theme-toggle")) {
            var dark = root.classList.toggle("dark")
            try {
              localStorage.setItem("theme", dark ? "dark" : "light")
            } catch (e) {}
            syncThemeToggle()
          }
        })

        function ready(fn) {
          if (document.readyState !== "loading") fn()
          else document.addEventListener("DOMContentLoaded", fn)
        }

        ready(function () {
          syncThemeToggle()
          var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches

          var revealNodes = Array.prototype.filter.call(
            document.querySelectorAll(
              "main section[id] :is(h2,h3,figure,blockquote,dl,[data-reveal]), main section[id] :is(ol,ul) > li"
            ),
            function (el) {
              return !el.closest("astro-island")
            }
          )
          if (
            !reduce &&
            "IntersectionObserver" in window &&
            revealNodes.length
          ) {
            revealNodes.forEach(function (el) {
              el.classList.add("will-reveal")
              var parent = el.parentElement
              if (parent) {
                var sibs = Array.prototype.filter.call(
                  parent.children,
                  function (c) {
                    return c.classList.contains("will-reveal")
                  }
                )
                var idx = sibs.indexOf(el)
                if (idx > 0) el.style.transitionDelay = idx * 70 + "ms"
              }
            })
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (e) {
                  if (e.isIntersecting) {
                    e.target.classList.add("is-visible")
                    io.unobserve(e.target)
                  }
                })
              },
              { rootMargin: "0px 0px -6% 0px", threshold: 0.08 }
            )
            revealNodes.forEach(function (el) {
              io.observe(el)
            })
          }

          var counters = document.querySelectorAll("[data-count]")
          if (!reduce && counters.length && "IntersectionObserver" in window) {
            var fmt = function (n) {
              return String(Math.round(n)).replace(
                /\B(?=(\d{3})+(?!\d))/g,
                "\u00a0"
              )
            }
            var cio = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (e) {
                  if (!e.isIntersecting) return
                  var el = e.target
                  cio.unobserve(el)
                  var target = parseFloat(el.getAttribute("data-count"))
                  var suffix = el.getAttribute("data-suffix") || ""
                  var start = performance.now()
                  var dur = 1100
                  function tick(now) {
                    var p = Math.min((now - start) / dur, 1)
                    var eased = 1 - Math.pow(1 - p, 3)
                    el.textContent = fmt(target * eased) + suffix
                    if (p < 1) requestAnimationFrame(tick)
                    else el.textContent = fmt(target) + suffix
                  }
                  requestAnimationFrame(tick)
                })
              },
              { threshold: 0.4 }
            )
            counters.forEach(function (c) {
              cio.observe(c)
            })
          }

          var header = document.getElementById("site-header")
          if (header) {
            var onScroll = function () {
              header.classList.toggle("is-scrolled", window.scrollY > 8)
            }
            onScroll()
            window.addEventListener("scroll", onScroll, { passive: true })
          }

          var progress = document.getElementById("scroll-progress")
          if (progress) {
            var updateProgress = function () {
              var h = document.documentElement
              var max = h.scrollHeight - h.clientHeight
              var p = max > 0 ? h.scrollTop / max : 0
              progress.style.transform = "scaleX(" + p + ")"
            }
            updateProgress()
            window.addEventListener("scroll", updateProgress, { passive: true })
            window.addEventListener("resize", updateProgress)
          }

          var numberedSections = Array.prototype.slice.call(
            document.querySelectorAll("main > section[id]")
          )
          var navLinks = Array.prototype.slice.call(
            document.querySelectorAll("#site-header nav a[href^='#']")
          )
          if (numberedSections.length && "IntersectionObserver" in window) {
            var setActive = function (id) {
              navLinks.forEach(function (a) {
                var active = a.getAttribute("href") === "#" + id
                a.classList.toggle("is-active", active)
                if (active) a.setAttribute("aria-current", "location")
                else a.removeAttribute("aria-current")
              })
            }
            var sio = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (e) {
                  if (e.isIntersecting) setActive(e.target.id)
                })
              },
              { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
            )
            numberedSections.forEach(function (s) {
              sio.observe(s)
            })
          }

          document
            .querySelectorAll("#site-header a[href^='#']")
            .forEach(function (a) {
              a.addEventListener("click", function () {
                var d = a.closest("details")
                if (d) d.open = false
              })
            })

          var mcta = document.getElementById("mobile-cta")
          if (mcta) {
            var mctaShown = false
            var contact = document.getElementById("kontakt")
            var updateMcta = function () {
              var past = window.scrollY > 560
              var nearContact =
                contact &&
                contact.getBoundingClientRect().top < window.innerHeight * 0.9
              var shouldShow = past && !nearContact
              if (shouldShow !== mctaShown) {
                mctaShown = shouldShow
                mcta.classList.toggle("is-visible", shouldShow)
              }
            }
            updateMcta()
            window.addEventListener("scroll", updateMcta, { passive: true })
            window.addEventListener("resize", updateMcta)
          }
        })
      })()
    </script>
    {enableMetaPixel && (
      <>
        <script is:inline>
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return
            n = f.fbq = function () {
              n.callMethod
                ? n.callMethod.apply(n, arguments)
                : n.queue.push(arguments)
            }
            if (!f._fbq) f._fbq = n
            n.push = n
            n.loaded = !0
            n.version = "2.0"
            n.queue = []
            t = b.createElement(e)
            t.async = !0
            t.src = v
            s = b.getElementsByTagName(e)[0]
            s.parentNode.insertBefore(t, s)
          })(
            window,
            document,
            "script",
            "https://connect.facebook.net/en_US/fbevents.js"
          )
          fbq("consent", "revoke")
          fbq("init", "1536323148175556")
          fbq("track", "PageView")

          // Meta Consent Mode – pixel dostaje zgodę dopiero z CookieYes (GTM).
          ;(function () {
            function applyConsent(categories) {
              var granted = !!(categories && categories.advertisement)
              window.__metaConsent = granted
              if (typeof window.fbq === "function")
                window.fbq("consent", granted ? "grant" : "revoke")
            }

            document.addEventListener(
              "cookieyes_banner_load",
              function (event) {
                applyConsent(event.detail && event.detail.categories)
              }
            )

            document.addEventListener(
              "cookieyes_consent_update",
              function (event) {
                var detail = (event && event.detail) || {}
                applyConsent(
                  detail.categories || {
                    advertisement:
                      (detail.accepted || []).indexOf("advertisement") !== -1,
                  }
                )
              }
            )

            function readConsent() {
              if (typeof window.getCkyConsent !== "function") return
              try {
                applyConsent(window.getCkyConsent().categories)
              } catch (e) {}
            }

            readConsent()
            if (document.readyState === "loading")
              document.addEventListener("DOMContentLoaded", readConsent)
          })()
        </script>

        {/*
          Zdarzenia konwersji (Meta Pixel, tylko po zgodzie na „advertisement”):
          - Lead    – kliknięcie CTA prowadzącego do Calendly,
          - Contact – kliknięcie e-maila, WhatsAppa lub numeru telefonu.
          content_name wskazuje miejsce CTA (np. konsultacja, proces,
          kontakt), a content_category źródło akcji.
        */}
        <script is:inline>
          ;(function () {
            function ctaLocation(link) {
              if (link.id) return link.id
              var scope =
                link.closest && link.closest("section[id], #mobile-cta, header")
              if (!scope) return "page"
              if (scope.tagName === "HEADER") return "header"
              return scope.id || "page"
            }

            function conversionFor(href) {
              if (href.indexOf("calendly.com") !== -1)
                return { event: "Lead", category: "calendly" }
              if (
                href.indexOf("wa.me") !== -1 ||
                href.indexOf("api.whatsapp.com") !== -1
              )
                return { event: "Contact", category: "whatsapp" }
              if (href.indexOf("mailto:") === 0)
                return { event: "Contact", category: "email" }
              if (href.indexOf("tel:") === 0)
                return { event: "Contact", category: "phone" }
              return null
            }

            document.addEventListener("click", function (ev) {
              if (!window.__metaConsent || typeof window.fbq !== "function")
                return
              var target = ev.target
              var link =
                target && target.closest ? target.closest("a[href]") : null
              if (!link) return

              var conversion = conversionFor(link.getAttribute("href") || "")
              if (!conversion) return

              window.fbq("track", conversion.event, {
                content_name: ctaLocation(link),
                content_category: conversion.category,
              })
            })
          })()
        </script>
      </>
    )}
  </head>
  <body>
    {enableGoogleTagManager && (
      <noscript>
        <iframe
          src="https://www.googletagmanager.com/ns.html?id=GTM-N3QL4956"
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <slot />
  </body>
</html>
