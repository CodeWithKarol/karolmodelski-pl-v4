  noindex = false,
  canonical,
} = Astro.props

const canonicalURL =
  canonical === false
    ? null
    : (canonical ?? new URL(Astro.url.pathname, Astro.site)).toString()
const ogURL = canonicalURL ?? new URL("/", Astro.site).toString()
const ogImage = new URL("/og-image.png", Astro.site)

