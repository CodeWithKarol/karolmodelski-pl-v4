---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f5f2" />
    <Font cssVariable="--font-inter" preload />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Karol Modelski" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Karol Modelski" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={ogURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Karol Modelski – pierwsza działająca wersja Twojego pomysłu w 4 tygodnie"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@modelski_karol" />
    <meta name="twitter:creator" content="@modelski_karol" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Karol Modelski – pierwsza działająca wersja Twojego pomysłu w 4 tygodnie"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        try {
          var saved = localStorage.getItem("theme")
          if (
            saved === "dark" ||
            (!saved && matchMedia("(prefers-color-scheme: dark)").matches)
          )
            root.classList.add("dark")
        } catch (e) {}

        function syncThemeToggle() {
          var btn = document.getElementById("theme-toggle")
          if (btn)
            btn.setAttribute(
              "aria-pressed",
              root.classList.contains("dark") ? "true" : "false"
            )
        }

        document.addEventListener("click", function (ev) {
          var t = ev.target
          if (t && t.closest && t.closest("#theme-toggle")) {
            var dark = root.classList.toggle("dark")
            try {
              localStorage.setItem("theme", dark ? "dark" : "light")
            } catch (e) {}
            syncThemeToggle()
          }
        })

        function ready(fn) {
          if (document.readyState !== "loading") fn()
          else document.addEventListener("DOMContentLoaded", fn)
        }

        ready(function () {
          syncThemeToggle()
          var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches

          var revealNodes = Array.prototype.filter.call(
            document.querySelectorAll(
              "main section[id] :is(h2,h3,figure,blockquote,dl,[data-reveal]), main section[id] :is(ol,ul) > li"
            ),
            function (el) {
              return !el.closest("astro-island")
            }
          )
          if (
            !reduce &&
            "IntersectionObserver" in window &&
            revealNodes.length
          ) {
            revealNodes.forEach(function (el) {
              el.classList.add("will-reveal")
              var parent = el.parentElement
              if (parent) {
                var sibs = Array.prototype.filter.call(
                  parent.children,
                  function (c) {
                    return c.classList.contains("will-reveal")
                  }
                )
                var idx = sibs.indexOf(el)
                if (idx > 0) el.style.transitionDelay = idx * 70 + "ms"
              }
            })
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (e) {
                  if (e.isIntersecting) {
                    e.target.classList.add("is-visible")
                    io.unobserve(e.target)
                  }
                })
              },
              { rootMargin: "0px 0px -6% 0px", threshold: 0.08 }
            )
            revealNodes.forEach(function (el) {
              io.observe(el)
            })
          }

          var counters = document.querySelectorAll("[data-count]")
          if (!reduce && counters.length && "IntersectionObserver" in window) {
            var fmt = function (n) {
              return String(Math.round(n)).replace(
                /\B(?=(\d{3})+(?!\d))/g,
                "\u00a0"
              )
            }
            var cio = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (e) {
                  if (!e.isIntersecting) return
                  var el = e.target
                  cio.unobserve(el)
                  var target = parseFloat(el.getAttribute("data-count"))
                  var suffix = el.getAttribute("data-suffix") || ""
                  var start = performance.now()
                  var dur = 1100
                  function tick(now) {
                    var p = Math.min((now - start) / dur, 1)
                    var eased = 1 - Math.pow(1 - p, 3)
                    el.textContent = fmt(target * eased) + suffix
                    if (p < 1) requestAnimationFrame(tick)
                    else el.textContent = fmt(target) + suffix
                  }
                  requestAnimationFrame(tick)
                })
              },
              { threshold: 0.4 }
            )
            counters.forEach(function (c) {
              cio.observe(c)
            })
          }

          var header = document.getElementById("site-header")
          if (header) {
            var onScroll = function () {
              header.classList.toggle("is-scrolled", window.scrollY > 8)
            }
            onScroll()
            window.addEventListener("scroll", onScroll, { passive: true })
          }

          var progress = document.getElementById("scroll-progress")
          if (progress) {
            var updateProgress = function () {
              var h = document.documentElement
              var max = h.scrollHeight - h.clientHeight
              var p = max > 0 ? h.scrollTop / max : 0
              progress.style.transform = "scaleX(" + p + ")"
            }
            updateProgress()
            window.addEventListener("scroll", updateProgress, { passive: true })
            window.addEventListener("resize", updateProgress)
          }

          var numberedSections = Array.prototype.slice.call(
            document.querySelectorAll("main > section[id]")
          )
          var navLinks = Array.prototype.slice.call(
            document.querySelectorAll("#site-header nav a[href^='#']")
          )
          if (numberedSections.length && "IntersectionObserver" in window) {
            var setActive = function (id) {
              navLinks.forEach(function (a) {
                var active = a.getAttribute("href") === "#" + id
                a.classList.toggle("is-active", active)
                if (active) a.setAttribute("aria-current", "location")
                else a.removeAttribute("aria-current")
              })
            }
            var sio = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (e) {
                  if (e.isIntersecting) setActive(e.target.id)
                })
              },
              { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
            )
            numberedSections.forEach(function (s) {
              sio.observe(s)
            })
          }

          document
            .querySelectorAll("#site-header a[href^='#']")
            .forEach(function (a) {
              a.addEventListener("click", function () {
                var d = a.closest("details")
                if (d) d.open = false
              })
            })

          var mcta = document.getElementById("mobile-cta")
          if (mcta) {
            var mctaShown = false
            var contact = document.getElementById("kontakt")
            var updateMcta = function () {
              var past = window.scrollY > 560
              var nearContact =
                contact &&
                contact.getBoundingClientRect().top < window.innerHeight * 0.9
              var shouldShow = past && !nearContact
              if (shouldShow !== mctaShown) {
                mctaShown = shouldShow
                mcta.classList.toggle("is-visible", shouldShow)
              }
            }
            updateMcta()
            window.addEventListener("scroll", updateMcta, { passive: true })
            window.addEventListener("resize", updateMcta)
          }
        })
      })()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
