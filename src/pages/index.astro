---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import HeroProductShowcase from "@/components/hero-product-showcase.astro"
import KeyOfferMetrics from "@/components/key-offer-metrics.astro"
import FeaturedCaseStudy from "@/components/featured-case-study.astro"
import CollaborationSplit from "@/components/collaboration-split.astro"
import ProductOutcomeGrid from "@/components/product-outcome-grid.astro"
import OfferSummary from "@/components/offer-summary.astro"
import PersonalIntroduction from "@/components/personal-introduction.astro"
import ProjectTimeline from "@/components/project-timeline.astro"
import TrustFeatures from "@/components/trust-features.astro"
import SectionHeading from "@/components/section-heading.astro"
import FaqAccordion from "@/components/faq-accordion"
import KnowledgePreview from "@/components/knowledge-preview.astro"
import FinalCTA from "@/components/final-cta.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight } from "lucide-react"
---

<Layout includeFaqSchema>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="home" />

  <main id="main">
    <HeroProductShowcase />
    <KeyOfferMetrics />
    <FeaturedCaseStudy />
    <CollaborationSplit />
    <ProductOutcomeGrid />
    <OfferSummary />
    <PersonalIntroduction />
    <ProjectTimeline />
    <TrustFeatures />

    <section id="faq" class="section-y border-t border-line bg-paper">
      <div class="shell">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <SectionHeading
              eyebrow="08 · Najczęstsze pytania"
              title="Masz wątpliwości?"
              lead="Cztery pytania, które słyszę najczęściej przed decyzją."
            />
          </div>

          <div class="lg:col-span-7 lg:col-start-6">
            <FaqAccordion client:visible />

            <div class="mt-8 border-t border-line pt-6">
              <a
                href="/faq/"
                class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                Wszystkie pytania i odpowiedzi
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
              <p class="mt-2 max-w-md text-sm leading-relaxed text-pretty text-ink-soft">
                Koszty, etapy realizacji i bezpieczeństwo pomysłu.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <KnowledgePreview />
    <FinalCTA />
  </main>

  <div
    id="mobile-cta"
    class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 px-4 py-3 backdrop-blur md:hidden"
  >
    <a
      href="/rozmowa/"
      class={cn(
        buttonVariants({ size: "lg" }),
        "h-11 w-full gap-2 rounded-[6px] px-4 text-base whitespace-nowrap"
      )}
    >
      Umów bezpłatną rozmowę
      <ArrowRight />
    </a>
  </div>

  <CompactFooter />

  <script is:inline>
    ;(() => {
      const clips = Array.prototype.slice.call(
        document.querySelectorAll("main video[data-clip]")
      )
      if (!clips.length) return

      const btn = document.querySelector("[data-clip-toggle]")
      const label = btn ? btn.querySelector("[data-clip-label]") : null
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
      let enabled = !reduce.matches

      const render = () => {
        if (!btn) return
        btn.dataset.state = enabled ? "playing" : "paused"
        if (label) {
          label.textContent = enabled
            ? "Wstrzymaj nagrania"
            : "Odtwórz nagrania"
        }
      }

      const sync = () => {
        clips.forEach((clip) => {
          const shouldPlay =
            enabled && clip.dataset.inView === "true" && !document.hidden
          if (shouldPlay) {
            if (clip.paused) {
              const p = clip.play()
              if (p && p.catch) p.catch(() => {})
            }
          } else if (!clip.paused) {
            clip.pause()
          }
        })
      }

      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.dataset.inView = entry.isIntersecting
                ? "true"
                : "false"
            })
            sync()
          },
          { threshold: 0.35 }
        )
        clips.forEach((clip) => io.observe(clip))
      } else {
        clips.forEach((clip) => {
          clip.dataset.inView = "true"
        })
      }

      document.addEventListener("visibilitychange", sync)

      if (btn) {
        btn.addEventListener("click", () => {
          enabled = !enabled
          render()
          sync()
        })
      }

      if (reduce.addEventListener) {
        reduce.addEventListener("change", (event) => {
          enabled = !event.matches
          render()
          sync()
        })
      }

      render()
      sync()
    })()
  </script>
</Layout>
