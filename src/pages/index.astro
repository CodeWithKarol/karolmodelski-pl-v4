]

const paymentStages = [
  {
    share: "40%",
    amount: "11 800 zł",
    title: "1. część – Na start prac",
    description:
      "Wpłacasz w dniu podpisania umowy i formalnego zobowiązania do poufności. Dzięki temu rezerwuję czas swój i zespołu wyłącznie na Twój projekt, ustalamy szczegóły i od razu ruszamy z budową wyglądu oraz działającego serca aplikacji.",
