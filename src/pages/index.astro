---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import wystapienie from "@/assets/images/karol-modelski-wystapienie.webp"
// Grafiki dawnych sekcji procesu i zakresu wyłączone do czasu nowych wersji (miały wypalone treści i wyceny, których już nie używamy).
// import proces from "@/assets/images/od-pomyslu-do-produktu.png"
// import scope from "@/assets/images/nie-budujemy-wszystkiego-naraz.png"
// import stack from "@/assets/images/kompletny-start-projektu.png"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { wiedzaArticlePath, wiedzaCategoryLabel } from "@/data/wiedza"
import { getReadingTime } from "@/lib/reading-time"
import FaqAccordion from "@/components/faq-accordion"
import ProfileAvatar from "@/components/profile-avatar"
import {
  ArrowRight,
  BadgeCheck,
  Check,
  FileCheck2,
  Lock,
  Pause,
  Play,
  ShieldCheck,
} from "lucide-react"

const outcomeItems = [
  {
    title: "Sam wypróbujesz swój produkt",
    description: "Zobaczysz, jak działa jego najważniejsza funkcja.",
  },
  {
    title: "Pokażesz go innym",
    description: "Wyślesz link partnerowi, znajomemu lub pierwszym testerom.",
  },
  {
    title: "Zaczniesz obserwować zachowania użytkowników",
    description:
      "Podstawowa analityka pomoże Ci zobaczyć, z czego korzystają i czy wracają.",
  },
  {
    title: "Podejmiesz kolejne decyzje na podstawie doświadczeń",
    description:
      "Zamiast od razu inwestować w kolejne funkcje, zastanowisz się, co rzeczywiście warto rozwijać.",
  },
]

const problemQuestions = [
  "Komu powierzyć pomysł, żeby ktoś naprawdę zrozumiał, co chcę stworzyć?",
  "Jak zabezpieczyć swoje rozwiązanie przed wykorzystaniem przez inne osoby?",
  "Czy potrzebuję całego zespołu i skąd mam wiedzieć, że dobrze wykonuje swoją pracę?",
  "Ile to naprawdę powinno kosztować i co dostanę za te pieniądze?",
  "Czy muszę od razu budować całą aplikację, czy można zacząć od czegoś mniejszego?",
]

const guarantees = [
  {
    title: "Poufność",
    description:
      "Możemy podpisać NDA, zanim opowiesz mi o szczegółach pomysłu.",
  },
  {
    title: "Stała cena za ustalony zakres",
    description: "Wiesz, co dokładnie powstanie i ile za to zapłacisz.",
  },
  {
    title: "Płatności etapami",
    description:
      "Nie wpłacasz całej kwoty na początku. Rozliczamy projekt w trzech częściach.",
  },
  {
    title: "Kod, prawa i gwarancja",
    description:
      "Po zakończeniu i rozliczeniu otrzymujesz kod oraz uzgodnione prawa do produktu. Masz także trzy miesiące gwarancji technicznej na warunkach zapisanych w umowie.",
  },
]

const packageItems = [
  "Ustalenie zakresu i plan realizacji",
  "Projekt wyglądu aplikacji",
  "Działająca pierwsza wersja w przeglądarce",
  "Strona internetowa produktu",
  "Podstawowa analityka",
  "Koordynacja całej realizacji",
  "Kod źródłowy i uzgodnione prawa do produktu",
]

type ProcessStep = {
  title: string
  description: string
}

const process: ProcessStep[] = [
  {
    title: "Przed rozpoczęciem — ustalamy zakres",
    description:
      "Wspólnie wybieramy najważniejsze funkcje, ustalamy cenę i zapisujemy warunki w umowie.",
  },
  {
    title: "Pierwsze 4 tygodnie — budujemy aplikację",
    description:
      "Przygotowujemy wygląd, programujemy uzgodnione funkcje i uruchamiamy pierwszą działającą wersję.",
  },
  {
    title: "Zwykle tygodnie 5–8 — odbiór i przekazanie",
    description:
      "Sprawdzasz produkt, wykonujemy wymagane poprawki i po rozliczeniu przekazuję Ci kod oraz uzgodnione prawa.",
  },
]

interface CollaborationStep {
  label: string
  title: string
  description: string
}

const collaborationSteps: CollaborationStep[] = [
  {
    label: "Ty",
    title: "Ty opowiadasz o swojej wizji",
    description:
      "Własnymi słowami. Bez dokumentacji technicznej i wiedzy programistycznej.",
  },
  {
    label: "Ty i ja",
    title: "Wspólnie ustalamy, co zbudować najpierw",
    description:
      "Oddzielamy najważniejsze funkcje od tych, które mogą poczekać.",
  },
  {
    label: "Ja",
    title: "Ja organizuję realizację, Ty oceniasz efekty",
    description:
      "Regularnie pokazuję postępy, a Ty decydujesz, czy produkt zmierza we właściwym kierunku.",
  },
]

const wiedzaEntries = (await getCollection("wiedza")).sort(
  (a, b) => a.data.order - b.data.order
)
const wiedzaHighlights = wiedzaEntries.slice(0, 3)
const readingTimeFor = (entry: (typeof wiedzaEntries)[number]) =>
  getReadingTime(entry.body)
const cardParagraphsFor = (entry: (typeof wiedzaEntries)[number]) =>
  (entry.data.cardDescription ?? entry.data.description)
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean)
---

<Layout includeFaqSchema>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="home" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-20 pb-16 sm:px-6 sm:pt-24 sm:pb-20">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10">
          <div class="rise lg:col-span-6">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              Masz pomysł na własną aplikację?
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl xl:text-6xl">
              Zamień swój pomysł w działającą aplikację.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink-soft">
              Bez szukania programistów i budowania wszystkiego od razu. W 4
              tygodnie przygotuję pierwszą działającą wersję Twojego produktu,
              którą będziesz mógł uruchomić, pokazać innym i zacząć testować.
            </p>

            <p class="mt-4 max-w-xl text-base leading-relaxed text-pretty text-ink-soft">
              Nie musisz znać się na technologii ani mieć gotowej dokumentacji.
              Pomogę Ci wybrać najważniejsze funkcje i zajmę się całą
              realizacją.
            </p>

            <div class="mt-9 flex flex-col items-start gap-4">
              <a
                id="konsultacja"
                href="/rozmowa/"
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Sprawdźmy, czy Twój pomysł da się zrealizować
                <ArrowRight />
              </a>
              <p class="max-w-md text-sm leading-relaxed text-pretty text-ink-soft">
                Bezpłatna rozmowa · 20 minut · Bez zobowiązań
              </p>
            </div>

            <p class="mt-6 max-w-md border-t border-line pt-4 text-sm leading-relaxed text-pretty text-ink-soft">
              29 500 zł brutto za uzgodniony pakiet · umowa o poufności (NDA)
              przed szczegółową rozmową
            </p>
          </div>

          <figure
            class="rise mx-auto w-full max-w-[19rem] lg:col-span-6 lg:max-w-[20rem]"
            style="animation-delay:.12s"
          >
            <div class="overflow-hidden rounded-[1.75rem] border border-line bg-ink p-1 shadow-[0_35px_80px_-55px_rgba(20,20,20,0.5)]">
              <video
                data-clip
                class="block aspect-[9/16] w-full rounded-[1.4rem] object-cover"
                src="/showcase/numerabble-landing.webm"
                poster="/showcase/numerabble-landing.webp"
                width="720"
                height="1280"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Strona produktu gry Numerabble — przewijanie widoku na telefonie"
              ></video>
            </div>

            <figcaption class="mt-4">
              <span class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                Przykład realizacji
              </span>
              <span class="mt-2 block text-sm leading-relaxed text-pretty text-ink-soft">
                Strona produktu gry Numerabble, zbudowana razem z pierwszą
                wersją aplikacji.{" "}
                <a
                  href="/realizacje/numerabble/"
                  class="font-medium text-ink underline underline-offset-4 hover:no-underline"
                >
                  Poznaj historię tej realizacji
                </a>
              </span>
            </figcaption>
          </figure>
        </div>

        <dl class="mt-16 grid grid-cols-1 gap-y-6 border-t border-line pt-8 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-8 lg:grid-cols-4">
          <div>
            <dt class="font-mono text-[11px] leading-4 tracking-[0.16em] text-ink-soft uppercase sm:min-h-8">
              Pierwsza działająca wersja
            </dt>
            <dd class="mt-2 font-heading text-2xl font-semibold sm:text-3xl">
              4 tygodnie
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] leading-4 tracking-[0.16em] text-ink-soft uppercase sm:min-h-8">
              Pierwsza wersja i kompleksowa realizacja
            </dt>
            <dd class="mt-2 font-heading text-2xl font-semibold text-signal-ink sm:text-3xl">
              29 500 zł{" "}
              <span class="text-base font-medium tracking-normal text-ink-soft">
                brutto
              </span>
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] leading-4 tracking-[0.16em] text-ink-soft uppercase sm:min-h-8">
              Zwykle cały proces z odbiorem i poprawkami
            </dt>
            <dd class="mt-2 font-heading text-2xl font-semibold sm:text-3xl">
              6–8 tygodni
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] leading-4 tracking-[0.16em] text-ink-soft uppercase sm:min-h-8">
              Gwarancja techniczna
            </dt>
            <dd class="mt-2 font-heading text-2xl font-semibold sm:text-3xl">
              3 miesiące
            </dd>
          </div>
        </dl>
        <p class="mt-6 text-sm leading-relaxed text-pretty text-ink-soft">
          Czas liczy się od wspólnego ustalenia zakresu i skompletowania
          materiałów oraz dostępów.
        </p>
      </div>
    </section>
    <section class="border-y border-line bg-surface-muted">
      <div class="mx-auto max-w-[75rem] px-4 py-6 sm:px-6">
        <ul class="grid grid-cols-1 divide-y divide-line text-sm text-ink-soft sm:grid-cols-2 sm:gap-x-6 sm:gap-y-4 sm:divide-y-0 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-line">
          <li class="flex items-center gap-2.5 py-2 sm:py-0 lg:justify-center lg:px-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line bg-paper text-signal">
              <Lock className="size-4" />
            </span>
            <span class="leading-snug text-pretty">
              Umowa o poufności przed rozmową
            </span>
          </li>
          <li class="flex items-center gap-2.5 py-2 sm:py-0 lg:justify-center lg:px-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line bg-paper text-signal">
              <FileCheck2 className="size-4" />
            </span>
            <span class="leading-snug text-pretty">
              Pełne prawa do produktu
            </span>
          </li>
          <li class="flex items-center gap-2.5 py-2 sm:py-0 lg:justify-center lg:px-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line bg-paper text-signal">
              <BadgeCheck className="size-4" />
            </span>
            <span class="leading-snug text-pretty">Stała cena ryczałtowa</span>
          </li>
          <li class="flex items-center gap-2.5 py-2 sm:py-0 lg:justify-center lg:px-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line bg-paper text-signal">
              <ShieldCheck className="size-4" />
            </span>
            <span class="leading-snug text-pretty">3 miesiące gwarancji</span>
          </li>
        </ul>
      </div>
    </section>

    <div class="bg-paper px-4 py-6 sm:px-6">
      <div class="mx-auto flex max-w-[75rem] flex-col gap-4 rounded-xl border border-line px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
        <div>
          <p class="font-heading text-base font-semibold text-balance text-ink">
            Wolisz najpierw zabezpieczyć swój pomysł?
          </p>
          <p class="mt-1 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft">
            Rozumiem. Możemy podpisać umowę o poufności, zanim opowiesz mi o
            szczegółach swojego rozwiązania.
          </p>
        </div>
        <a
          href="mailto:kontakt@karolmodelski.pl?subject=Umowa%20o%20poufno%C5%9Bci"
          class={cn(
            buttonVariants({ size: "sm" }),
            "h-11 shrink-0 rounded-[6px] px-4 text-sm"
          )}
        >
          Napisz w sprawie NDA
          <ArrowRight />
        </a>
      </div>
    </div>

    <section
      id="przyklad"
      class="border-t border-line bg-paper px-4 py-20 sm:px-6 sm:py-32"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Przykład realizacji
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">
              Pomysł sprzed prawie 30 lat. Dziś można już w niego zagrać.
            </h2>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Mój klient przez wiele lat rozwijał pomysł na własną grę
              matematyczną.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Miał przemyślane zasady i mnóstwo pomysłów na kolejne możliwości:
              rozgrywki online, rankingi, turnieje i różne tryby gry.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              Tylko czy trzeba było budować to wszystko od razu?
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Zaproponowałem, żebyśmy zaczęli od podstaw.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Najpierw stworzymy wersję, w której można zagrać z komputerem.
              Udostępnimy ją przez przeglądarkę i zaczniemy sprawdzać, jak
              ludzie z niej korzystają.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              I właśnie tak powstała pierwsza działająca wersja Numerabble.
            </p>

            <figure class="mt-12">
              <div class="overflow-hidden rounded-2xl border border-line bg-ink shadow-[0_35px_80px_-55px_rgba(20,20,20,0.5)]">
                <video
                  data-clip
                  class="block aspect-[4/3] w-full object-cover"
                  src="/showcase/numerabble-gameplay.webm"
                  poster="/showcase/numerabble-gameplay.webp"
                  width="960"
                  height="720"
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-label="Rozgrywka w grze Numerabble — plansza, żetony gracza i zestaw komputera"
                ></video>
              </div>
              <figcaption class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="max-w-xl text-sm leading-relaxed text-pretty text-ink-soft">
                  To prawdziwa gra, a nie wizualizacja pomysłu. Można ją
                  uruchomić w przeglądarce i rozegrać partię.
                </p>
                <button
                  type="button"
                  data-clip-toggle
                  data-state="playing"
                  class="inline-flex shrink-0 items-center gap-2 self-start rounded-md border border-line px-3 py-1.5 font-mono text-[11px] tracking-[0.14em] text-ink-soft uppercase transition-colors hover:border-ink/25 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                >
                  <Pause
                    data-clip-icon-pause
                    className="size-3.5"
                    aria-hidden="true"
                  />
                  <Play
                    data-clip-icon-play
                    className="size-3.5"
                    aria-hidden="true"
                  />
                  <span data-clip-label>Wstrzymaj nagrania</span>
                </button>
              </figcaption>
            </figure>

            <div class="mt-10 border-t border-line pt-8">
              <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
                <a
                  href="/rozmowa/"
                  class={cn(
                    buttonVariants({ size: "lg" }),
                    "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                  )}
                >
                  Porozmawiajmy o Twoim pomyśle
                  <ArrowRight />
                </a>
                <a
                  href="/realizacje/numerabble/"
                  class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                >
                  Zobacz, jak powstało Numerabble
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              </div>
              <p class="mt-4 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft">
                Poznaj całą historię: od pierwszych rozmów i ustalania zasad,
                przez cztery tygodnie pracy, aż po pierwsze testy i poprawki.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="problemy"
      class="border-t border-line bg-surface-muted px-4 py-20 sm:px-6 sm:py-32"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Problem
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">
              Masz pomysł na aplikację, ale nie wiesz, komu powierzyć jego
              realizację?
            </h2>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Być może myślisz o niej od miesięcy. A może rozwijasz ten pomysł
              już od kilku lat.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Wiesz, jak aplikacja powinna działać. Widzisz, komu mogłaby się
              przydać. Masz pomysły na funkcje, wygląd i możliwości dalszego
              rozwoju.
            </p>
            <p class="mt-6 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              Ale gdy próbujesz przejść do realizacji, pojawiają się pytania:
            </p>

            <ol class="mt-10 border-t border-line">
              {problemQuestions.map((question, index) => (
                <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] items-baseline gap-3 border-b border-line py-5 sm:grid-cols-[3rem_minmax(0,1fr)] sm:gap-6 sm:py-6">
                  <span class="font-mono text-xs tracking-[0.16em] text-signal-ink">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p class="font-heading text-lg leading-snug font-semibold text-balance text-ink sm:text-xl">
                    {question}
                  </p>
                </li>
              ))}
            </ol>

            <p class="mt-10 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Nie musisz znać odpowiedzi na wszystkie te pytania, zanim
              zaczniesz.
            </p>

            <div class="relative mt-10 border-t border-line pt-8">
              <span
                class="absolute -top-px left-0 h-px w-20 bg-signal"
                aria-hidden="true"
              />
              <p class="max-w-3xl font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Właśnie od tego zaczniemy współpracę: uporządkujemy Twój pomysł
                i sprawdzimy, co warto zbudować w pierwszej kolejności.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="model"
      class="border-t border-line bg-paper px-4 py-20 sm:px-6 sm:py-32"
    >
