          .forEach((details) => {
            details.open = mq.matches
          })
      }
      sync()
      mq.addEventListener("change", sync)
    })()
  </script>

  <script is:inline>
    ;(() => {
      const clips = Array.prototype.slice.call(
        document.querySelectorAll("main video[data-clip]")
      )
      if (!clips.length) return

      const btn = document.querySelector("[data-clip-toggle]")
      const label = btn ? btn.querySelector("[data-clip-label]") : null
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
      let enabled = !reduce.matches

      const render = () => {
        if (!btn) return
        btn.dataset.state = enabled ? "playing" : "paused"
        if (label) {
          label.textContent = enabled
            ? "Wstrzymaj nagrania"
            : "Odtwórz nagrania"
        }
      }

      const sync = () => {
        clips.forEach((clip) => {
          const shouldPlay =
            enabled && clip.dataset.inView === "true" && !document.hidden
          if (shouldPlay) {
            if (clip.paused) {
              const p = clip.play()
              if (p && p.catch) p.catch(() => {})
            }
          } else if (!clip.paused) {
            clip.pause()
          }
        })
      }

      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.dataset.inView = entry.isIntersecting
                ? "true"
                : "false"
            })
            sync()
          },
          { threshold: 0.35 }
        )
        clips.forEach((clip) => io.observe(clip))
      } else {
        clips.forEach((clip) => {
          clip.dataset.inView = "true"
        })
      }

      document.addEventListener("visibilitychange", sync)

      if (btn) {
        btn.addEventListener("click", () => {
          enabled = !enabled
          render()
          sync()
        })
      }

      if (reduce.addEventListener) {
        reduce.addEventListener("change", (event) => {
          enabled = !event.matches
          render()
          sync()
        })
      }

      render()
      sync()
    })()
  </script>
