---

<Layout>
  <header
    id="site-header"
    class="relative sticky top-0 z-40 border-b border-transparent bg-paper/85 backdrop-blur"
  >
    <div
      class="mx-auto flex h-16 max-w-[75rem] items-center justify-between gap-4 px-4 sm:px-6"
    >
      <div class="flex items-center gap-3">
        <a
          href="#"
          class="flex items-center"
          aria-label="Karol Modelski — strona główna"
        >
          <img
            src="/logo-compact.svg"
            alt="Karol Modelski"
            class="h-8 w-auto sm:h-9 dark:hidden"
          />
          <img
            src="/logo-compact-on-dark.svg"
            alt=""
            aria-hidden="true"
            class="hidden h-8 w-auto sm:h-9 dark:block"
          />
        </a>
        <span
          id="section-indicator"
          class="hidden font-mono text-[11px] tracking-[0.16em] text-ink-soft tabular-nums sm:inline"
          >01 / 11</span
        >
      </div>

      <nav class="hidden items-center gap-8 text-sm text-ink-soft md:flex">
        <a class="transition-colors hover:text-ink" href="#proces">Proces</a>
        <a class="transition-colors hover:text-ink" href="#rozliczenie"
          >Rozliczenie</a
        >
        <a class="transition-colors hover:text-ink" href="#o-mnie">O mnie</a>
        <a class="transition-colors hover:text-ink" href="#faq">FAQ</a>
      </nav>

      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Przełącz tryb ciemny"
          class="flex size-9 items-center justify-center rounded-lg border border-line bg-transparent text-ink transition-colors hover:bg-secondary"
        >
          <svg
            class="theme-sun size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
          </svg>
          <svg
            class="theme-moon size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a
          href="https://calendly.com/kontakt-karolmodelski/konsultacja"
          target="_blank"
          rel="noopener noreferrer"
          class={cn(
            buttonVariants({ size: "sm" }),
            "hidden h-9 rounded-[6px] px-4 text-sm sm:inline-flex"
          )}
        >
          Porozmawiajmy (20 min)
        </a>

        <details class="relative md:hidden">
          <summary
            class="flex size-9 cursor-pointer list-none items-center justify-center rounded-lg border border-line text-ink [&::-webkit-details-marker]:hidden"
            aria-label="Menu"
          >
            <Menu className="size-5" />
          </summary>
          <div
            class="absolute top-full right-0 mt-2 w-60 rounded-xl border border-line bg-paper p-2 shadow-lg"
          >
            <nav class="flex flex-col">
              <a
                class="rounded-lg px-3 py-2.5 text-sm text-ink-soft hover:bg-secondary hover:text-ink"
                href="#problemy">Problem</a
              >
              <a
                class="rounded-lg px-3 py-2.5 text-sm text-ink-soft hover:bg-secondary hover:text-ink"
                href="#proces">Proces</a
              >
              <a
                class="rounded-lg px-3 py-2.5 text-sm text-ink-soft hover:bg-secondary hover:text-ink"
                href="#rozliczenie">Rozliczenie</a
              >
              <a
                class="rounded-lg px-3 py-2.5 text-sm text-ink-soft hover:bg-secondary hover:text-ink"
                href="#o-mnie">O mnie</a
              >
              <a
                class="rounded-lg px-3 py-2.5 text-sm text-ink-soft hover:bg-secondary hover:text-ink"
                href="#faq">FAQ</a
              >
            </nav>
            <a
              href="https://calendly.com/kontakt-karolmodelski/konsultacja"
              target="_blank"
              rel="noopener noreferrer"
              class={cn(
                buttonVariants({ size: "sm" }),
                "mt-1 h-10 w-full rounded-[6px] text-sm"
              )}
            >
              Porozmawiajmy (20 min)
            </a>
          </div>
        </details>
      </div>
    </div>
    <span
      id="scroll-progress"
      aria-hidden="true"
      class="absolute inset-x-0 -bottom-px h-[2px] origin-left scale-x-0 bg-signal"
    ></span>
  </header>

  <main>
    <section
      class="relative overflow-hidden bg-paper px-4 pt-20 pb-16 sm:px-6 sm:pt-24 sm:pb-20"
    >
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      >
      </div>

      <div class="mx-auto max-w-[75rem]">
        <div
          class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10"
        >
          <div class="rise lg:col-span-5">
            <p
              class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase"
            >
              <span class="h-px w-8 bg-signal"></span>
              Dla pomysłodawców i przyszłych twórców aplikacji
            </p>

            <h1
              class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
            >
              Nie budujemy samej aplikacji. Budujemy dowód, że Twój pomysł
              naprawdę się opłaca.
            </h1>

            <p
              class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink-soft"
            >
              W 4 tygodnie dostajesz działający produkt, stronę z analityką
              zachowań użytkowników oraz materiały do rozmów z inwestorami.
            </p>

