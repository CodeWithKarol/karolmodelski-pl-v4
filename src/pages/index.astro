---
import Layout from "@/layouts/main.astro"
import { Image } from "astro:assets"
import wystapienie from "@/assets/images/karol-modelski-wystapienie.webp"
import { buttonVariants } from "@/components/ui/button"
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"
import { cn } from "@/lib/utils"
import FaqAccordion from "@/components/faq-accordion"
import ProfileAvatar from "@/components/profile-avatar"
import { ArrowRight, Check, Mail, MapPin, MessageCircle } from "lucide-react"

const eyebrow = "Zamiast 100 000 zł i 5 miesięcy w agencji IT"

const nextStartMonth = new Intl.DateTimeFormat("pl-PL", {
  month: "long",
  year: "numeric",
}).format(new Date(new Date().getFullYear(), new Date().getMonth() + 1, 1))

const problems = [
  {
    title: "Kupujesz same rysunki i obietnice",
    description:
      "Płacisz kilkanaście tysięcy złotych, czekasz 3 miesiące i dostajesz ładną prezentację w pliku graficznym. Problem w tym, że w nic nie da się kliknąć na żywo, nic w środku nie działa i nikt nie może tego faktycznie sprawdzić. Mija czas, a Ty nadal nie masz w ręku niczego, co mogłoby przynieść zysk.",
  },
  {
    title: "Wydajesz 100 000 zł, zanim ktokolwiek to zobaczy",
    description:
      "Agencja przez pół roku buduje skomplikowane formularze, panele administracyjne i konta, zamiast po prostu dać ludziom sprawdzić to, co w Twoim pomyśle najważniejsze. Najgorszy moment to ten, w którym po wydaniu wszystkich oszczędności okazuje się, że odbiorcy oczekiwali czegoś zupełnie innego.",
  },
]

