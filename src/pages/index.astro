---
import Layout from "@/layouts/main.astro"
import { Image } from "astro:assets"
import wystapienie from "@/assets/images/karol-modelski-wystapienie.webp"
import { Badge } from "@/components/ui/badge"
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert"
import { buttonVariants } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"
import { cn } from "@/lib/utils"
import FaqAccordion from "@/components/faq-accordion"
import ProfileAvatar from "@/components/profile-avatar"
import {
  ArrowRight,
  ChartColumn,
  Check,
  Cpu,
  Handshake,
  Lock,
  Mail,
  MapPin,
  MessageCircle,
  Palette,
  Presentation,
  Rocket,
  ShieldCheck,
  Target,
  TrendingDown,
  Wallet,
} from "lucide-react"

const eyebrow = "Zamiast 100 000 zł i 5 miesięcy w agencji IT"

const nextStartMonth = new Intl.DateTimeFormat("pl-PL", {
  month: "long",
  year: "numeric",
}).format(new Date(new Date().getFullYear(), new Date().getMonth() + 1, 1))

const benefits = [
  {
    icon: Rocket,
    title: "Działający produkt w 30 dni",
    description:
      "Twoi pierwsi użytkownicy mogą od razu uruchomić Twój produkt na dowolnym telefonie lub komputerze – bez barier, bez czekania i bez skomplikowanego instalowania.",
  },
  {
    icon: ChartColumn,
    title: "Jasne odpowiedzi zamiast domysłów",
    description:
      "Od razu widzisz czarno na białym: ile osób weszło, jak długo korzystali, ilu wraca każdego dnia i ilu poleca to znajomym.",
  },
  {
    icon: Handshake,
    title: "Mocna karta przetargowa",
    description:
      "Gdy rozmawiasz z inwestorami lub partnerami, nie opowiadasz o marzeniach z prezentacji – kładziesz na stole działający produkt i wyniki pierwszych testów.",
  },
  {
    icon: ShieldCheck,
    title: "Jeden partner i święty spokój",
    description:
      "Masz jednego zaufanego opiekuna, który pilnuje całego procesu, budżetu i terminów. Ty zajmujesz się biznesem i kontaktami z klientami.",
  },
]

const problems = [
  {
    icon: Presentation,
    title: "Kupujesz same rysunki i obietnice",
    description:
      "Płacisz kilkanaście tysięcy złotych, czekasz 3 miesiące i dostajesz ładną prezentację w pliku graficznym. Problem w tym, że w nic nie da się kliknąć na żywo, nic w środku nie działa i nikt nie może tego faktycznie sprawdzić. Mija czas, a Ty nadal nie masz w ręku niczego, co mogłoby przynieść zysk.",
  },
  {
    icon: Wallet,
    title: "Wydajesz 100 000 zł, zanim ktokolwiek to zobaczy",
    description:
      "Agencja przez pół roku buduje skomplikowane formularze, panele administracyjne i formalności, zamiast po prostu dać ludziom sprawdzić to, co w Twoim pomyśle najważniejsze. Najgorszy moment to ten, w którym po wydaniu wszystkich oszczędności okazuje się, że odbiorcy oczekiwali czegoś zupełnie innego.",
  },
]

const businessGoal = {
  title: "Cel biznesu jest prosty",
  description:
    "Nie chodzi o to, żeby miesiącami dyskutować i planować, tylko żeby jak najszybciej zobaczyć, czy ludzie z tego korzystają, wracają i chcą za to płacić.",
}

const comparisonColumns = [
  {
    title: "Tradycyjna agencja IT",
    ours: false,
  },
  {
    title: "Agencja od samych grafik",
    ours: false,
  },
  {
    title: "Współpraca ze mną (30 dni)",
    ours: true,
  },
]

const comparisonRows = [
  {
    label: "Kiedy widzisz realny efekt?",
    values: [
      "Za 4–6 miesięcy (albo wcale)",
      "Po 2–3 miesiącach rysowania",
      "Już po 30 dniach kalendarzowych",
    ],
  },
  {
    label: "Co realnie dostajesz?",
    values: [
      "Rachunki za godziny i stertę dokumentów",
      "Rysunki, w które nie da się kliknąć ani ich przetestować",
      "Działający produkt, własną stronę i prawdziwych użytkowników",
    ],
  },
  {
    label: "Rozmowy z inwestorami",
    values: [
      "Opowiadasz o planach ze slajdów",
      "Pokazujesz nieruchomy szkic",
      "Pokazujesz działający biznes i opinie pierwszych klientów",
    ],
  },
  {
    label: "Koszty i budżet",
    values: [
      "Budżet bez dna, który ciągle rośnie",
      "Koszt za sam szkic, potem płacisz od nowa",
      "Z góry ustalona, bezpieczna kwota bez niespodzianek",
    ],
  },
  {
    label: "Co z tym robisz dalej?",
    values: [
      "Często trzeba zaczynać od początku",
      "Trzeba budować od zera",
      "Sprawdzony fundament, na którym od razu budujesz dalej i zarabiasz",
    ],
  },
]

const deliverables = [
  {
    icon: Palette,
    title: "Atrakcyjny wygląd, który przyciąga uwagę",
    description:
      "Przygotowuję dopracowany, intuicyjny styl wizualny, który budzi zaufanie i sprawia, że korzystanie z produktu jest proste i przyjemne.",
    points: [
      "Otrzymujesz gotowe materiały graficzne, które możesz od razu wykorzystać w promocji, mediach i rozmowach biznesowych.",
    ],
  },
  {
    icon: Cpu,
    title: "Działające serce Twojego pomysłu",
    description:
      "Uruchamiam to, co najważniejsze: unikalną funkcję, która wciąga użytkowników, wywołuje efekt „wow” i sprawia, że po pierwszej minucie nie chcą odłożyć telefonu czy zamknąć przeglądarki.",
    points: [
      "Każdy może to od razu włączyć i przetestować na dowolnym urządzeniu.",
    ],
  },
]

const process = [
  {
    badge: "Dni 1–7",
    title: "Tydzień 1 · Wygląd projektu i pierwsze wrażenie",
    description:
      "Wspólnie ustalamy, jak Twój produkt ma działać krok po kroku, a ja przygotowuję dla Ciebie 2 zupełnie różne style wizualne do wyboru. Już po tygodniu widzisz na własne oczy, jak Twój pomysł będzie wyglądał w rękach pierwszych użytkowników.",
  },
  {
    badge: "Dni 8–21",
    title: "Tydzień 2–3 · Uruchomienie",
    description:
      "Sprawiam, że projekt ożywa. Buduję to, co w Twoim pomyśle najważniejsze – tak, by każdy mógł to od razu włączyć na telefonie lub komputerze, sprawdzić w praktyce i poczuć frajdę z korzystania.",
  },
  {
    badge: "Dni 22–30",
    title: "Tydzień 4 · Własna strona i twarde fakty o rynku",
    description:
      "Uruchamiam Twoją oficjalną stronę internetową z opisem projektu oraz włączam system sprawdzający reakcje ludzi: widzisz, jak długo z tego korzystają, czy wracają kolejnego dnia i czy polecają ją dalej. W 30. dniu odbierasz gotowy, w 100% Twój produkt, który możesz od razu pokazywać rynkowi i partnerom.",
  },
]

const bonuses = [
  {
    value: "4 500 zł – w pakiecie",
    title: "Bonus 1: Gotowa, elegancka strona z Twoją nazwą",
    description:
      "Zamiast szukać kolejnych wykonawców i płacić za osobną stronę, przygotowuję dla Ciebie czytelną wizytówkę w internecie. W prosty sposób wyjaśnia ona ludziom, dlaczego Twój pomysł jest wyjątkowy, budzi zaufanie i zachęca do natychmiastowego wypróbowania.",
  },
  {
    value: "3 000 zł – w pakiecie",
    title: "Bonus 2: Narzędzie pokazujące prawdę o reakcjach odbiorców",
    description:
      "Nie musisz zgadywać, czy projekt się podoba. Włączam prosty podgląd, na którym czarno na białym widzisz: jak długo ludzie korzystają z rozwiązania, czy wracają kolejnego dnia i czy polecają ją dalej. Dodatkowo, gdy ktoś zamyka stronę, zadaję mu jedno krótkie pytanie, dzięki czemu od razu poznajesz szczere opinie pierwszych użytkowników.",
  },
  {
    value: "3 500 zł – w pakiecie",
    title: "Bonus 3: Budowanie rozgłosu na żywo od pierwszego dnia",
    description:
      "Dzielę się ciekawostkami i postępami z powstawania Twojego projektu w internecie. Pokazuję kulisy tworzenia, dzięki czemu ludzie zaczynają kibicować Twojemu pomysłowi, a Ty gromadzisz wokół siebie pierwszych zaciekawionych odbiorców jeszcze zanim oficjalnie wystartujesz.",
  },
]
---

<Layout>
  <main>
    <section
      class="relative flex min-h-svh items-center justify-center overflow-hidden px-4 py-20 sm:px-6 sm:py-24"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_at_center,black,transparent_72%)] bg-[size:64px_64px] opacity-40"
        >
        </div>
        <div
          class="absolute -top-40 left-1/2 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"
        >
        </div>
        <div
          class="absolute -right-32 -bottom-48 h-[28rem] w-[28rem] rounded-full bg-primary/5 blur-3xl"
        >
        </div>
      </div>

      <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
        <Badge
          variant="outline"
          className="h-auto max-w-full rounded-2xl bg-background/60 px-3 py-1.5 text-balance whitespace-normal text-muted-foreground backdrop-blur sm:py-1 sm:whitespace-nowrap"
        >
          <TrendingDown data-icon="inline-start" className="opacity-70" />
          {eyebrow}
        </Badge>

        <h1
          class="mt-5 text-3xl leading-[1.15] font-semibold tracking-tight text-balance sm:mt-6 sm:text-4xl sm:leading-[1.1] md:text-5xl lg:text-6xl"
        >
          Zamieniam Twój pomysł w działającą aplikację{" "}
          <span class="relative isolate whitespace-nowrap">
            <span
              aria-hidden="true"
              class="absolute inset-x-[-0.15em] inset-y-[0.08em] -z-10 rounded-md bg-primary/10"
            ></span>
            w 30 dni
          </span>{" "}
          – gotową do pokazania pierwszym odbiorcom.
        </h1>

        <p
          class="mt-6 max-w-2xl text-base leading-relaxed text-pretty text-muted-foreground sm:text-lg"
        >
          W 30 dni zamieniam Twój pomysł w działającą aplikację gotową do
          pokazania światu. Odbierasz kompletne narzędzie i na twardych danych
          sprawdzasz, czy pomysł ma wzięcie na rynku.
        </p>

        <div class="mt-10 flex w-full flex-col items-center gap-4">
          <a
            id="konsultacja"
            href="https://calendly.com/kontakt-karolmodelski/konsultacja"
            target="_blank"
            rel="noopener noreferrer"
            class={cn(
              buttonVariants({ size: "lg" }),
              "h-auto min-h-12 w-full gap-2 rounded-full px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto sm:py-0 sm:whitespace-nowrap"
            )}
          >
            Umów 20-minutową rozmowę o swoim pomyśle
            <ArrowRight />
          </a>
          <p
            class="mx-auto max-w-md text-center text-sm leading-relaxed text-pretty text-muted-foreground"
          >
            Wspólnie wybierzemy najważniejsze elementy na start, aby bezpiecznie
            sprawdzić rynek i nie zmarnować budżetu.
          </p>
        </div>
      </div>
    </section>

    <section id="problemy" class="border-t px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-5xl">
        <div class="max-w-2xl">
          <p
            class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
          >
            Gdzie uciekają pieniądze?
          </p>
          <h2
            class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
          >
            Dlaczego tradycyjny start z agencją to najczęściej bolesna lekcja?
          </h2>
          <p
            class="mt-4 text-base leading-relaxed text-pretty text-muted-foreground"
          >
            Gdy masz pomysł na aplikację lub narzędzie internetowe, tradycyjna
            ścieżka najczęściej prowadzi w jedną z dwóch ślepych uliczek:
          </p>
        </div>

        <div class="mt-10 max-w-3xl">
          <p
            class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
          >
            Dwie ślepe uliczki
          </p>
          <div class="mt-5 space-y-4">
            {
              problems.map(({ icon: Icon, title, description }) => (
                <Alert
                  variant="destructive"
                  className="border-destructive/40 p-4"
                >
                  <Icon />
                  <AlertTitle className="text-base text-balance text-red-700 dark:text-red-400">
                    {title}
                  </AlertTitle>
                  <AlertDescription className="leading-relaxed text-muted-foreground!">
                    {description}
                  </AlertDescription>
                </Alert>
              ))
            }
          </div>

          <p
            class="mt-10 text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
          >
            O co naprawdę chodzi
          </p>
          <Alert className="mt-5 bg-muted/40 p-4">
            <Target className="text-muted-foreground" />
            <AlertTitle className="text-base text-balance">
              {businessGoal.title}
            </AlertTitle>
            <AlertDescription className="leading-relaxed">
              {businessGoal.description}
            </AlertDescription>
          </Alert>
        </div>
      </div>
    </section>

    <section id="droga" class="border-t px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <p
              class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
            >
              Twoja droga do efektów
            </p>
            <h2
              class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
            >
              Od Twojego pomysłu do działającego produktu w 4 tygodnie
            </h2>
            <p
              class="mt-4 text-base leading-relaxed text-pretty text-muted-foreground"
            >
              Zamiast budować wielkie projekty w ciemno, skupiam się na jednym:
              dowiezieniu działającego produktu w ręce pierwszych odbiorców.
            </p>
          </div>

          <ul class="lg:col-span-7">
            {
              benefits.map(({ icon: Icon, title, description }) => (
                <li class="flex gap-4 border-t py-6 first:border-t-0 first:pt-0">
                  <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted text-foreground">
                    <Icon className="size-5" />
                  </div>
                  <div>
                    <h3 class="font-medium">{title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-pretty text-muted-foreground">
                      {description}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="proces" class="border-t px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
          <p
            class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
          >
            Przebieg współpracy
          </p>
          <h2
            class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
          >
            Jak wygląda 30 dni – krok po kroku do Twojego działającego projektu
          </h2>
          <p
            class="mt-4 text-base leading-relaxed text-pretty text-muted-foreground"
          >
            Dokładnie wiesz, co dzieje się na każdym etapie – bez niedomówień i
            bez czekania w niepewności.
          </p>
        </div>

        <ol class="mt-10 max-w-3xl">
          {
            process.map(({ badge, title, description }) => (
              <li class="relative border-l border-border pb-10 pl-6 last:pb-0 sm:pl-8">
                <span
                  aria-hidden="true"
                  class="absolute top-1.5 -left-[7px] size-3.5 rounded-full border-2 border-background bg-foreground"
                />
                <Badge variant="outline">{badge}</Badge>
                <h3 class="mt-3 text-lg font-medium text-balance">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-pretty text-muted-foreground sm:text-base">
                  {description}
                </p>
              </li>
            ))
          }
        </ol>

        <p
          class="mt-8 max-w-2xl text-base leading-relaxed text-pretty text-muted-foreground sm:text-lg"
        >
          <strong class="font-semibold text-foreground"
            >Ile pracy jest po Twojej stronie?</strong
          >{" "}
          Dokładnie tyle, ile trzeba, żeby dobrze zrozumieć Twój pomysł: kilka wspólnych,
          rzeczowych rozmów, na których ustalimy zasady i wybierzemy wygląd, a na
          koniec odbiór gotowego projektu. Nie musisz znać się na technologii, pilnować
          ludzi ani zajmować się technicznymi detalami – całą realizację i dowiezienie
          tematu w 30 dni biorę na siebie.
        </p>
      </div>
    </section>

    <section id="porownanie" class="border-t px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
          <p
            class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
          >
            Porównanie korzyści
          </p>
          <h2
            class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
          >
            Na czym Ci zależy?
          </h2>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-4 md:hidden">
          {
            comparisonColumns.map((column, columnIndex) => (
              <Card className={cn(column.ours && "bg-muted/40")}>
                <CardHeader>
                  <CardTitle>{column.title}</CardTitle>
                </CardHeader>
                <CardContent>
                  <dl>
                    {comparisonRows.map((row) => (
                      <div class="border-t py-3 first:border-t-0 first:pt-0">
                        <dt class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
                          {row.label}
                        </dt>
                        <dd
                          class={cn(
                            "mt-1 text-sm leading-relaxed",
                            column.ours
                              ? "font-medium text-foreground"
                              : "text-muted-foreground"
                          )}
                        >
                          {row.values[columnIndex]}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </CardContent>
              </Card>
            ))
          }
        </div>

        <div class="mt-10 hidden md:block">
          <Table>
            <TableCaption className="sr-only">
              Porównanie ścieżek budowy produktu cyfrowego
            </TableCaption>
            <TableHeader>
              <TableRow className="hover:bg-transparent">
                <TableHead
                  className="w-[15rem] border-r px-3 py-3 align-bottom whitespace-normal text-muted-foreground sm:py-4"
                >
                  Cecha
                </TableHead>
                {
                  comparisonColumns.map((column) => (
                    <TableHead
                      className={cn(
                        "px-3 py-3 align-bottom whitespace-normal sm:py-4",
                        column.ours && "rounded-t-lg bg-muted/50"
                      )}
                    >
                      <span class="block text-sm font-medium text-foreground">
                        {column.title}
                      </span>
                    </TableHead>
                  ))
                }
              </TableRow>
            </TableHeader>
            <TableBody>
              {
                comparisonRows.map((row) => (
                  <TableRow className="hover:bg-transparent">
                    <TableCell className="border-r px-3 py-3 align-top text-sm font-medium whitespace-normal text-foreground sm:py-4">
                      {row.label}
                    </TableCell>
                    {row.values.map((value, index) => (
                      <TableCell
                        className={cn(
                          "px-3 py-3 align-top text-sm whitespace-normal text-muted-foreground sm:py-4",
                          index === 2 &&
                            "bg-muted/30 font-medium text-foreground"
                        )}
                      >
                        {value}
                      </TableCell>
                    ))}
                  </TableRow>
                ))
              }
            </TableBody>
          </Table>
        </div>
      </div>
    </section>

    <section id="otrzymujesz" class="border-t px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
          <p
            class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
          >
            Co dokładnie otrzymujesz?
          </p>
          <h2
            class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
          >
            Kompletne narzędzie pod klucz, gotowe do sprawdzania rynku
          </h2>
        </div>

        <div class="mt-10 max-w-3xl">
          <ul class="space-y-8">
            {
              deliverables.map(({ icon: Icon, title, description, points }) => (
                <li class="flex items-start gap-3 sm:gap-5">
                  <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-muted text-muted-foreground sm:size-10">
                    <Icon className="size-5" />
                  </div>
                  <div>
                    <h3 class="text-base font-medium text-balance sm:text-lg">
                      {title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-pretty text-muted-foreground sm:text-base">
                      {description}
                    </p>
