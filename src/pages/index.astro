const process = [
  {
    badge: "Tygodnie 1–2",
    title: "Wygląd i serce mechanizmu",
    description:
      "Równolegle projektujemy wygląd (dwa różne kierunki wizualne do wyboru) i budujemy kluczowy silnik Twojego produktu. Dzięki temu grafika nie blokuje prac programistycznych.",
    yourPart:
      "4–6 godzin na starcie (2–4 spotkania na omówienie zasad i zakresu) + ok. 1 godzina na wybór stylu wizualnego.",
  },
  {
    badge: "Tygodnie 3–4",
    title: "Pełna funkcja, strona i badanie rynku",
    description:
      "Rozbudowujemy kluczową funkcję, uruchamiamy Twoją stronę internetową oraz włączamy podgląd reakcji ludzi: widzisz, ile osób wchodzi, jak długo klikają i czy wracają kolejnego dnia.",
    yourPart:
      "ok. 1 godzina – klikasz w wersję testową na telefonie lub komputerze i przekazujesz nam swoją opinię.",
  },
  {
    badge: "Tygodnie 5–8",
    title: "Spokojne testy, poprawki i przekazanie praw",
    description:
      "Masz pełne 10 dni roboczych na przetestowanie narzędzia i spisanie ewentualnych uwag. My mamy do 7 dni roboczych na bezpłatne usunięcie zgłoszonych błędów. Na koniec przekazuję Ci produkt, stronę, kody źródłowe i 100% praw autorskich.",
    yourPart:
      "testujesz działanie produktu według prostej instrukcji i zgłaszasz uwagi.",
  },
]

const collaborationModel = [
  {
    title: "Ty robisz to, w czym jesteś najlepszy",
    description:
      "Opowiadasz mi o swoim pomyśle, dzielisz się wiedzą o swoich klientach i mówisz, co Ci się podoba, a co nie.",
  },
  {
    title: "Ja prowadzę cały projekt od strony technicznej",
    description:
      "Projektuję architekturę, piszę specyfikację, dobieram i koordynuję sprawdzony zespół specjalistów (grafik, deweloper, tester). Odpowiadam za jakość i termin, a Ty masz jeden punkt kontaktu.",
  },
  {
    title: "Święty spokój",
    description:
      "Nie zarządzasz ludźmi, nie tłumaczysz się programistom i nie pilnujesz grafików. Przychodzisz na krótkie, konkretne spotkania, gdzie pokazuję Ci postępy i pytam: „Idziemy w prawo czy w lewo?”. Ty wybierasz kierunek, my dowozimy efekt.",
  },
]
---

<Layout>
  <main>
    <section
      class="relative overflow-hidden bg-paper px-4 pt-32 pb-24 sm:px-6 sm:pt-40 sm:pb-32"
    >
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      >
      </div>

      <div class="mx-auto max-w-6xl">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="rise lg:col-span-7">
            <p
              class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase"
            >
              <span class="h-px w-8 bg-signal"></span>
              00 · Wstęp
            </p>

            <h1
              class="mt-6 font-heading text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl xl:text-7xl"
            >
              W 4 tygodnie sprawdź, czy Twój pomysł na aplikację ma wzięcie.
            </h1>

            <p
              class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink-soft"
            >
              Odbierasz działającą aplikację webową (bez instalowania
              czegokolwiek ze sklepu) i od razu widzisz, czy ludzie chcą z niej
              korzystać. Pierwsza wersja do testów powstaje w 4 tygodnie, a
              pełny odbiór z naniesieniem Twoich poprawek zamyka się zwykle w
              6–8 tygodniach.
            </p>

            <div class="mt-10 flex flex-col items-start gap-4">
              <a
                id="konsultacja"
                href="https://calendly.com/kontakt-karolmodelski/konsultacja"
                target="_blank"
                rel="noopener noreferrer"
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[4px] px-7 py-3 text-center text-base text-balance whitespace-normal sm:w-auto sm:py-0 sm:whitespace-nowrap"
                )}
              >
                Porozmawiajmy o projekcie – zarezerwuj 20 minut
                <ArrowRight />
              </a>
              <p
                class="max-w-md text-sm leading-relaxed text-pretty text-ink-soft"
              >
                Wspólnie wybierzemy najważniejsze serce pomysłu na start, aby
                bezpiecznie sprawdzić rynek i nie zmarnować budżetu.
              </p>
            </div>
          </div>

          <aside
            class="rise lg:col-span-5 lg:border-l lg:border-line lg:pl-10"
            style="animation-delay:.12s"
          >
            <dl class="border-y border-line">
              <div
                class="flex items-baseline justify-between gap-6 border-b border-line py-5"
              >
                <dt
                  class="font-mono text-xs tracking-[0.16em] text-ink-soft uppercase"
                >
                  Format
                </dt>
                <dd class="font-heading text-2xl font-semibold">4 tygodnie</dd>
              </div>
              <div
                class="flex items-baseline justify-between gap-6 border-b border-line py-5"
              >
                <dt
                  class="font-mono text-xs tracking-[0.16em] text-ink-soft uppercase"
                >
                  Wartość rynkowa
                </dt>
                <dd class="font-heading text-2xl font-semibold">125 000 zł</dd>
              </div>
              <div
                class="flex items-baseline justify-between gap-6 border-b border-line py-5"
              >
                <dt
                  class="font-mono text-xs tracking-[0.16em] text-ink-soft uppercase"
                >
                  Inwestycja
                </dt>
                <dd class="font-heading text-2xl font-semibold text-signal-ink">
                  29 500 zł
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-6 py-5">
                <dt
                  class="font-mono text-xs tracking-[0.16em] text-ink-soft uppercase"
                >
                  Dostępność
                </dt>
                <dd class="font-heading text-2xl font-semibold">1 / mies.</dd>
              </div>
            </dl>
            <p class="mt-5 font-mono text-xs tracking-wide text-ink-soft">
              {eyebrow}
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section
      id="problemy"
      class="border-t border-line bg-paper px-4 py-24 sm:px-6 sm:py-32"
    >
      <div class="mx-auto max-w-6xl">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p
              class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24"
            >
              01 · Problem
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2
              class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl"
            >
              Dlaczego start z agencją to najczęściej bolesna lekcja?
            </h2>
            <p
              class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink-soft"
            >
              Gdy masz pomysł na aplikację lub narzędzie internetowe, tradycyjna
              ścieżka najczęściej prowadzi w jedną z dwóch ślepych uliczek:
            </p>

            <p
              class="mt-12 font-mono text-xs tracking-[0.18em] text-ink-soft uppercase"
            >
              Dwie ślepe uliczki
            </p>
            <ol class="mt-4 border-t border-line">
              {
                problems.map(({ title, description }, index) => (
                  <li class="grid grid-cols-1 gap-3 border-b border-line py-8 sm:grid-cols-12 sm:gap-8">
                    <span class="font-mono text-sm text-signal-ink sm:col-span-1">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <div class="sm:col-span-11">
                      <h3 class="font-heading text-xl font-semibold text-balance sm:text-2xl">
                        {title}
                      </h3>
                      <p class="mt-3 max-w-2xl leading-relaxed text-pretty text-ink-soft">
                        {description}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ol>

            <p
              class="mt-10 max-w-2xl text-lg leading-relaxed text-balance text-pretty text-ink sm:text-xl"
            >
              <span class="font-semibold text-signal-ink"
                >Najgorszy scenariusz?</span
              >{" "}
              Po 6 miesiącach czekania i wydaniu 100 000 zł dowiadujesz się, że nikt
              tego nie potrzebuje – a agencja rozkłada ręce i wystawia kolejną fakturę
              za poprawki.
            </p>

            <blockquote class="mt-14 max-w-3xl border-l-2 border-signal pl-6">
              <p
                class="font-heading text-2xl leading-snug text-balance sm:text-3xl"
              >
                {businessGoal.title}.
              </p>
              <p
                class="mt-3 max-w-2xl text-lg leading-relaxed text-pretty text-ink-soft"
              >
                {businessGoal.description}
              </p>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <section
      id="model"
      class="border-t border-line bg-paper px-4 py-24 sm:px-6 sm:py-32"
    >
      <div class="mx-auto max-w-6xl">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p
              class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24"
            >
              02 · Model
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2
              class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl"
            >
              Nie musisz znać się na technologii. Prowadzę Cię krok po kroku od
              A do Z
            </h2>
            <p
              class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink-soft"
            >
              Tradycyjne agencje wymagają od Ciebie gotowych specyfikacji, każą
              wybierać bazy danych i zarzucają Cię pytaniami, na które nie znasz
              odpowiedzi. U mnie ten proces wygląda zupełnie inaczej:
            </p>

            <div
              class="mt-12 grid grid-cols-1 border-t border-line sm:grid-cols-3"
            >
              {
                collaborationModel.map(({ title, description }, index) => (
                  <div class="border-b border-line py-8 sm:border-b-0 sm:border-l sm:border-line sm:px-6 sm:first:border-l-0 sm:first:pl-0">
                    <span class="font-mono text-xs text-signal-ink">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="mt-3 font-heading text-xl font-semibold text-balance">
                      {title}
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                      {description}
                    </p>
                  </div>
                ))
              }
            </div>

