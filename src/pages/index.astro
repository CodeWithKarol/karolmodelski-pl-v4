  (a, b) => a.data.order - b.data.order
)
const wiedzaHighlights = wiedzaEntries.slice(0, 3)
const readingTimeFor = (entry: (typeof wiedzaEntries)[number]) =>
  getReadingTime(entry.body)
const cardParagraphsFor = (entry: (typeof wiedzaEntries)[number]) =>
  (entry.data.cardDescription ?? entry.data.description)
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean)
