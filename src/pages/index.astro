  {
    value: "5 000 zł",
    note: "Rynkowa wartość",
    title: "Czysty kod i pełna swoboda biznesowa",
    description:
      "Masz w umowie gwarancję, że nikt nie zażąda od Ciebie darmowego udostępniania kodu ani opłat licencyjnych. Możesz na tym w 100% legalnie i bezpiecznie zarabiać.",
    points: [],
  },
  {
    value: "5 000 zł",
    note: "Rynkowa wartość konsultacji i analizy",
    title: "Konkretny plan na kolejny krok (Wersja 2.0)",
