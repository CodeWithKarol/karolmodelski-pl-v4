---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { processFaq, processTimeline } from "@/data/jak-pracuje"
import { ArrowRight, Check, ChevronDown, Pause, Play } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/jak-pracuje/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle =
  "Jak wygląda tworzenie aplikacji krok po kroku? | Karol Modelski"
const metaDescription =
  "Poznaj proces tworzenia aplikacji: od pierwszej rozmowy i ustalenia zakresu, przez 4 tygodnie prac, aż po odbiór, poprawki i przekazanie produktu."

const consultationUrl = "/rozmowa/"

const summaryFacts = [
  { label: "Pierwsza wersja", value: "4 tygodnie" },
  { label: "Cały proces z odbiorem", value: "zwykle 6–8 tygodni" },
  { label: "Standardowy pakiet", value: "29 500 zł brutto" },
  { label: "Płatności", value: "40% / 40% / 20%" },
]

const firstStepQuestions = [
  "Co jest najważniejsze w Twoim pomyśle.",
  "Jak powinna działać pierwsza wersja.",
  "Co warto zostawić na później.",
]

const scopeItems = [
  "Najważniejsze funkcje pierwszej wersji.",
  "To, jak użytkownik będzie korzystać z aplikacji.",
  "Co dokładnie obejmuje realizacja.",
  "Jakie pomysły zostawiamy na następne etapy.",
  "Ile wyniesie koszt i jaki będzie harmonogram prac.",
]

const notNeeded = [
  "szukać programistów i projektantów.",
  "wybierać technologii, których nie znasz.",
  "rozdzielać pracy między specjalistów.",
  "codziennie sprawdzać, kto co zaprogramował.",
  "rozwiązywać problemów technicznych we własnym zakresie.",
]

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageURL}#faq`,
  mainEntity: processFaq.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: answer,
    },
  })),
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Jak pracuję",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[faqSchema, breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="jak-pracuje" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-24">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Jak pracuję</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-12">
          <div class="rise lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              Proces współpracy
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">
              Masz pomysł na aplikację? Zobacz, jak przeprowadzę Cię przez jej
              realizację.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Ty opowiadasz mi, co chcesz stworzyć. Ja pomagam ustalić zakres,
              organizuję zespół i prowadzę realizację. Po drodze wspólnie
              sprawdzamy efekty.
            </p>

            <p class="mt-6 max-w-xl border-l-2 border-signal pl-4 text-sm leading-relaxed text-pretty font-medium text-ink sm:text-base">
              4 tygodnie prac nad pierwszą działającą wersją. Zwykle 6–8 tygodni
              całego procesu wraz z odbiorem i poprawkami.
            </p>

            <div class="mt-8 flex flex-col items-start gap-4">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Porozmawiajmy o Twoim pomyśle
                <ArrowRight />
              </a>
              <p class="text-sm leading-relaxed text-pretty text-ink-soft">
                Bezpłatna rozmowa · 20 minut · Bez zobowiązań
              </p>
            </div>
          </div>

          <aside class="rise lg:col-span-5" style="animation-delay:.12s">
            <div class="rounded-2xl border border-line bg-surface-muted p-6 sm:p-8 lg:sticky lg:top-24">
              <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                W skrócie
              </p>

              <dl class="mt-4 border-t border-line">
                {summaryFacts.map(({ label, value }) => (
                  <div class="border-b border-line py-3">
                    <dt class="font-mono text-[10px] tracking-[0.12em] text-ink-soft uppercase">
                      {label}
                    </dt>
                    <dd class="mt-1 font-heading text-base font-semibold text-ink sm:text-lg">
                      {value}
                    </dd>
                  </div>
                ))}
              </dl>

              <a
                href="/oferta/"
                class="mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                Zobacz pełny zakres oferty
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section
      id="start"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Start
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Najpierw musimy dobrze zrozumieć Twój pomysł.
            </h2>

            <div
              id="pierwsza-rozmowa"
              class="mt-8 scroll-mt-24 border-t border-line pt-8"
            >
              <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Poznajemy pomysł
              </h3>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
                Zaczynamy od rozmowy.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Opowiadasz mi, co chcesz stworzyć, dla kogo ma być aplikacja i
                co użytkownik powinien móc w niej zrobić.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Nie musisz znać technicznych nazw ani mieć gotowej dokumentacji.
                Możesz pokazać szkice, notatki, podobne aplikacje albo po prostu
                opowiedzieć o swoim pomyśle własnymi słowami.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Będę zadawał pytania i proponował rozwiązania. Czasami okaże
                się, że jakąś funkcję można zrobić prościej. Innym razem
                zauważymy problem, o którym wcześniej nie myślałeś.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                I bardzo dobrze, że takie rzeczy wychodzą na tym etapie, a nie
                dopiero pod koniec programowania.
              </p>

              <p class="mt-6 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
                Na koniec chcę wiedzieć trzy rzeczy:
              </p>
              <ul class="mt-4 max-w-2xl border-t border-line">
                {firstStepQuestions.map((item) => (
                  <li class="flex items-start gap-3 border-b border-line py-3">
                    <Check
                      className="mt-0.5 size-4 shrink-0 text-signal"
                      aria-hidden="true"
                    />
                    <span class="text-sm leading-relaxed text-pretty text-ink sm:text-base">
                      {item}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-10 max-w-2xl border-t border-line pt-8">
              <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Możesz przygotować się wcześniej
              </h3>
              <p class="mt-3 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Jeśli chcesz uporządkować pomysł przed naszą rozmową, pobierz
                bezpłatną checklistę z 12 pytaniami. Pomoże Ci zastanowić się
                nad najważniejszą funkcją, przyszłymi użytkownikami, budżetem i
                możliwymi problemami.
              </p>
              <a
                href="/checklista/"
                class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                Pobierz checklistę
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
              <p class="mt-1 text-sm leading-relaxed text-pretty text-ink-soft">
                Nie musisz jej wypełniać, żeby rozpocząć współpracę.
              </p>
            </div>

            <div
              id="ustalanie-zakresu"
              class="mt-12 scroll-mt-24 border-t border-line pt-8"
            >
              <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Ustalamy zakres
              </h3>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Nie wszystko, co można dodać do aplikacji, trzeba budować od
                razu. W trakcie pierwszych rozmów często okazuje się, że
                pomysłów jest więcej, niż początkowo się wydawało.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Przydałyby się konta użytkowników. Może jeszcze płatności,
                powiadomienia, statystyki i kilka dodatkowych ekranów? A gdyby w
                przyszłości aplikacja działała również na telefonach jako osobny
                program?
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                I jasne — wiele z tych rzeczy może mieć sens. Tylko każda
                kolejna funkcja to dodatkowy czas, praca i pieniądze. Dlatego
                wspólnie ustalamy, które elementy są naprawdę potrzebne na
                początku, a które mogą spokojnie poczekać.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
                Nie chodzi o to, żeby budować jak najmniej za wszelką cenę.
                Chodzi o stworzenie takiej pierwszej wersji, z której da się
                rzeczywiście korzystać i która pozwoli sprawdzić najważniejsze
                założenia Twojego pomysłu.
              </p>

              <p class="mt-6 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
                Na tym etapie ustalamy:
              </p>
              <ul class="mt-4 max-w-2xl border-t border-line">
                {scopeItems.map((item) => (
                  <li class="flex items-start gap-3 border-b border-line py-3">
                    <Check
                      className="mt-0.5 size-4 shrink-0 text-signal"
                      aria-hidden="true"
                    />
                    <span class="text-sm leading-relaxed text-pretty text-ink sm:text-base">
                      {item}
                    </span>
                  </li>
                ))}
              </ul>

              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
                Zapisujemy to w ustaleniach projektowych i umowie. Dzięki temu
                obaj wiemy, co mamy zbudować, zanim rozpoczniemy programowanie.
              </p>
            </div>

            <div
              id="doprecyzowanie"
              class="mt-12 scroll-mt-24 border-t border-line pt-8"
            >
              <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Doprecyzowujemy zasady działania
              </h3>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Sam opis pomysłu często nie wystarcza do rozpoczęcia
                programowania.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Trzeba jeszcze ustalić, co stanie się w konkretnych sytuacjach.
              </p>

              <p class="mt-6 max-w-2xl border-l-2 border-signal pl-5 text-base leading-relaxed text-pretty text-ink sm:text-lg">
                Co zobaczy użytkownik po kliknięciu przycisku? Co jeśli
                wprowadzi niepoprawne dane? Czy może cofnąć działanie? Kiedy
                aplikacja powinna pokazać komunikat albo zakończyć dany proces?
              </p>

              <p class="mt-6 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Nie musisz sam znać odpowiedzi na wszystkie takie pytania.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Pomogę Ci je uporządkować. W razie potrzeby przygotujemy listę
                założeń i możliwych rozwiązań, które wspólnie omówimy i
                zatwierdzimy.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Dzięki temu mój zespół wie, co ma zbudować, a Ty wiesz, jak
                aplikacja powinna działać.
              </p>
              <p class="mt-6 max-w-2xl border-t border-line pt-6 text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
                Nie chodzi o tworzenie dokumentacji dla samej dokumentacji.
                Chodzi o ograniczenie nieporozumień, poprawek i niepotrzebnych
                kosztów.
              </p>
            </div>

            <div class="mt-10 max-w-2xl border-t border-line pt-8">
              <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Czy zawsze zaczynamy od budowy aplikacji?
              </h3>
              <p class="mt-3 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Nie.
              </p>
              <p class="mt-3 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Czasami podczas pierwszej rozmowy okazuje się, że projekt wymaga
                dokładniejszej analizy, zanim będzie można rozsądnie zaplanować
                jego realizację.
              </p>
              <p class="mt-3 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                W takiej sytuacji mogę zaproponować osobny, płatny etap
                przygotowania planu pierwszej wersji.
              </p>
              <p class="mt-3 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Nie jest to jednak obowiązkowe.
              </p>
              <p class="mt-3 text-base leading-relaxed text-pretty text-ink sm:text-lg">
                Jeżeli Twój pomysł pasuje do mojego standardowego pakietu,
                ustalenie zakresu i najważniejszych zasad działania jest już
                częścią współpracy.
              </p>
            </div>

            <div class="mt-12 border-t border-line pt-8">
              <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Ustalamy warunki współpracy
              </h3>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Chcę, żebyś wiedział, na co się umawiamy. Przed rozpoczęciem
                prac omawiamy zakres projektu, termin, cenę, sposób płatności i
                zasady odbioru.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Standardowy pakiet pierwszej działającej wersji aplikacji
                kosztuje{" "}
                <strong class="font-semibold text-ink">29 500 zł brutto</strong>
                . Nie oznacza to jednak, że za tę kwotę da się zbudować dowolnie
                rozbudowany produkt.
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Najpierw sprawdzamy, czy Twój pomysł można rozsądnie podzielić
                na etapy i czy uzgodniona pierwsza wersja mieści się w pakiecie.
                Jeżeli projekt wymaga większej liczby funkcji, niestandardowych
                integracji albo dodatkowych prac, powiem Ci o tym przed
                rozpoczęciem realizacji.
              </p>

              <div class="mt-6 max-w-2xl rounded-xl border border-line bg-paper p-5 sm:p-6">
                <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                  Rozliczenie
                </p>
                <p class="mt-2 font-heading text-xl font-semibold text-ink sm:text-2xl">
                  40% / 40% / 20%
                </p>
                <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft">
                  Nie musisz wpłacać całej kwoty na samym początku. W umowie
                  ustalamy również sposób sprawdzania rezultatów, zasady
                  zgłaszania poprawek i przekazania produktu.
                </p>
                <a
                  href="/oferta/"
                  class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                >
                  Zobacz pełny zakres oferty i warunki współpracy
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              </div>

              <p class="mt-6 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft">
                A jeżeli zależy Ci na zabezpieczeniu pomysłu, możemy podpisać
                umowę o poufności jeszcze przed szczegółową rozmową.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="harmonogram"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Realizacja
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Jak będzie wyglądała realizacja?
            </h2>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pretty text-ink-soft">
              Od ustaleń do działającego produktu — tydzień po tygodniu.
            </p>

            <ol class="mt-10">
              {processTimeline.map(
                ({ label, title, description, you, me, effect }, index) => (
                  <li
                    id={
                      index === processTimeline.length - 1
                        ? "odbior"
                        : undefined
                    }
                    class="relative scroll-mt-24 border-t border-line py-8 last:border-b"
                  >
                    <span
                      aria-hidden="true"
                      class="absolute -top-[4.5px] left-0 size-2 rounded-full bg-signal ring-4 ring-paper"
                    />
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-10">
                      <div class="flex items-baseline justify-between gap-4 md:block">
                        <p class="font-mono text-xs tracking-[0.16em] text-signal-ink uppercase">
                          {label}
                        </p>
                        <p class="font-mono text-xs text-ink-soft md:mt-2">
                          {String(index + 1).padStart(2, "0")} / 05
                        </p>
                      </div>

                      <div>
                        <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                          {title}
                        </h3>
                        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                          {description}
                        </p>

                        <div class="mt-4 grid grid-cols-1 gap-4 border-t border-line pt-4 sm:grid-cols-2">
                          <div>
                            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
                              Co robisz Ty
                            </p>
                            <p class="mt-1 text-sm leading-relaxed text-pretty text-ink sm:text-base">
                              {you}
                            </p>
                          </div>
