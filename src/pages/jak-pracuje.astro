---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import SectionHeading from "@/components/section-heading.astro"
import ProjectJourney from "@/components/project-journey.astro"
import FaqAccordion from "@/components/faq-accordion"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { processFaq, processTimeline } from "@/data/jak-pracuje"
import { Image } from "astro:assets"
import planningPhoto from "@/assets/images/oferta-planning.webp"
import checklistPreview from "@/assets/images/checklista-preview.png"
import journeyO02 from "@/assets/images/journey-o02-planning.webp"
import journeyJ01 from "@/assets/images/journey-j01-functional-spec.webp"
import journeyJ03 from "@/assets/images/journey-j03-interface.webp"
import journeyJ04 from "@/assets/images/journey-j04-working-function.webp"
import journeyJ05 from "@/assets/images/journey-j05-handover.webp"
import { ArrowRight, Check, Pause, Play } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/jak-pracuje/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle =
  "Jak wygląda tworzenie aplikacji krok po kroku? | Karol Modelski"
const metaDescription =
  "Poznaj proces tworzenia aplikacji: od pierwszej rozmowy i ustalenia zakresu, przez 4 tygodnie prac, aż po odbiór, poprawki i przekazanie produktu."

const consultationUrl = "/rozmowa/"

const journeyMedia = [
  {
    src: journeyO02,
    alt: "Notatnik, dokumenty i laptop na biurku — ilustracja planowania zakresu projektu",
  },
  {
    src: journeyJ03,
    alt: "Wydruk makiety strony Numerabble i szkic interfejsu na papierze — ilustracja etapu projektu",
  },
  {
    src: journeyJ04,
    alt: "Wizualizacja laptopa z interfejsem gry Numerabble",
  },
  {
    src: journeyJ01,
    alt: "Szkice przepływu i specyfikacji funkcjonalnej na papierze — ilustracja etapu realizacji",
  },
  {
    src: journeyJ05,
    alt: "Czyste kartki i ołówek na biurku — ilustracja przekazania dokumentacji",
  },
]

const processMap = [
  {
    label: "Pomysł",
    description: "Rozmowa i najważniejsza potrzeba.",
  },
  {
    label: "Plan",
    description: "Zakres, cena, termin i odbiór.",
  },
  {
    label: "Projekt",
    description: "Ekrany i sposób obsługi.",
  },
  {
    label: "Produkt",
    description: "Działająca wersja i pierwsze testy.",
  },
]

const preparationSteps = [
  {
    id: "pierwsza-rozmowa",
    kicker: "Poznajemy pomysł",
    title: "Najpierw rozumiemy, co chcesz stworzyć.",
    description:
      "Opowiadasz mi o pomyśle, użytkownikach i najważniejszej potrzebie. Notatki, szkice lub rozmowa wystarczą.",
    result: "Wspólne rozumienie celu i priorytetów.",
  },
  {
    id: "ustalanie-zakresu",
    kicker: "Wybieramy zakres",
    title: "Określamy, co wchodzi do pierwszej wersji.",
    description:
      "Ustalamy najważniejszą funkcję, funkcje na później, cenę i termin. Zapisujemy to w planie i umowie.",
    result: "Uzgodniony zakres, cena, termin i kryteria odbioru.",
  },
  {
    id: "doprecyzowanie",
    kicker: "Doprecyzowujemy zasady",
    title: "Przechodzimy przez scenariusze i wyjątki.",
    description:
      "Doprecyzowujemy scenariusze, wyjątki i kryteria odbioru, zanim zaczniemy programować.",
    result: "Specyfikacja funkcjonalna gotowa do pracy.",
  },
]

const scopeRows = [
  { label: "Cel", value: "Sprawdzić pomysł z pierwszymi użytkownikami." },
  {
    label: "Zakres",
    value:
      "Najważniejsza funkcja, strona i analityka; nowe pomysły na później.",
  },
  { label: "Cena", value: "Stała za uzgodniony zakres." },
  { label: "Termin", value: "4 tygodnie prac; zwykle 6–8 tygodni procesu." },
]

const specRows = [
  { label: "Scenariusze", value: "Główne ścieżki użytkownika." },
  { label: "Wyjątki", value: "Opisane przed programowaniem." },
  { label: "Kryteria odbioru", value: "Ustalone i zapisane w umowie." },
  { label: "Status", value: "Do wspólnej akceptacji." },
]

const startConditions = [
  "Ustalamy zakres i kryteria odbioru.",
  "Podpisujemy umowę.",
  "Wpłacasz pierwszą część (40%).",
  "Kompletujemy materiały i dostępy.",
]

const afterLaunchSteps = [
  {
    title: "Uruchom",
    description: "Pokazujesz produkt pierwszym użytkownikom.",
  },
  {
    title: "Obserwuj",
    description: "Podstawowa analityka pokazuje wybrane działania.",
  },
  {
    title: "Wyciągaj wnioski",
    description: "Sprawdzasz, co działa, a co wymaga zmiany.",
  },
  {
    title: "Rozwijaj",
    description: "Decydujesz, które funkcje mają sens w kolejnym etapie.",
  },
]

const numerabbleSteps = [
  {
    label: "Wizja",
    title: "Gra matematyczna z rozbudowaną wizją.",
    description:
      "Turnieje, rankingi i rozgrywki online — pomysł rozwijany przez prawie 30 lat.",
  },
  {
    label: "Decyzja",
    title: "Najpierw podstawowa rozgrywka.",
    description:
      "Zamiast całej wizji zaczęliśmy od gry z komputerem w przeglądarce.",
  },
  {
    label: "Produkt i testy",
    title: "Działająca wersja i pierwsze poprawki.",
    description:
      "Zasady, wygląd i nietypowe sytuacje dopracowywaliśmy na działającym produkcie.",
  },
]

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageURL}#faq`,
  mainEntity: processFaq.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: answer,
    },
  })),
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Jak pracuję",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[faqSchema, breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="jak-pracuje" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-50"
      ></div>

      <div class="shell pt-8 pb-14 sm:pt-10 lg:pt-16 lg:pb-20">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Jak pracuję</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal" aria-hidden="true" />
              Proces współpracy
            </p>

            <h1 class="mt-6 font-heading text-[clamp(2.5rem,1.2rem+3.2vw,3.75rem)] leading-[1.03] font-semibold tracking-tight text-balance">
              Od Twojego pomysłu do działającego produktu.
            </h1>

            <p class="lede mt-6">
              Prowadzę Cię od pomysłu przez zakres i projekt do działającej
              wersji. Decyzje podejmujemy wspólnie, a efekty oceniasz na
              bieżąco.
            </p>

            <dl class="mt-8 grid max-w-md grid-cols-2 gap-6 border-t border-line pt-5">
              <div>
                <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                  Pierwsza wersja
                </dt>
                <dd class="mt-1 font-heading text-2xl font-semibold tracking-tight">
                  4 tygodnie
                </dd>
              </div>
              <div>
                <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                  Cały proces
                </dt>
                <dd class="mt-1 font-heading text-2xl font-semibold tracking-tight">
                  6–8 tygodni
                </dd>
              </div>
            </dl>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-pretty text-ink-soft">
              Cztery tygodnie dotyczą pierwszej wersji; pełny proces z
              poprawkami trwa zwykle 6–8 tygodni.
            </p>

            <div class="mt-8 flex flex-col items-start gap-4">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Porozmawiajmy o Twoim pomyśle
                <ArrowRight />
              </a>
              <p class="text-sm leading-relaxed text-ink-soft">
                Bezpłatna rozmowa · 20 minut · Bez zobowiązań · Możliwość NDA
              </p>
            </div>

            <a
              href="/oferta/"
              class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Zobacz pełny zakres i warunki oferty
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>

          <aside class="lg:col-span-5">
            <div class="border-t border-line pt-5">
              <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
                Mapa procesu
              </p>

              <ol class="relative mt-5 border-l border-line pl-6">
                {processMap.map(({ label, description }, index) => (
                  <li class="relative pb-7 last:pb-0">
                    <span
                      aria-hidden="true"
                      class="absolute top-1 -left-[31px] size-2.5 rounded-full bg-signal ring-4 ring-paper"
                    />
                    <p class="font-mono text-[10px] tracking-[0.16em] text-ink-soft">
                      0{index + 1}
                    </p>
                    <p class="mt-1 font-heading text-lg leading-snug font-semibold">
                      {label}
                    </p>
                    <p class="mt-1 text-sm leading-relaxed text-pretty text-ink-soft">
                      {description}
                    </p>
                  </li>
                ))}
              </ol>

              <p class="mt-5 border-t border-line pt-4 text-sm leading-relaxed text-pretty text-ink-soft">
                Mapa koncepcyjna.{" "}
                <a
                  href="#harmonogram"
                  class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                >
                  Zobacz etapy.
                </a>
              </p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section id="start" class="section-y border-t border-line bg-surface-muted">
      <div class="shell">
        <SectionHeading
          eyebrow="01 · Przygotowanie"
          title="Trzy kroki, zanim zaczniemy programować."
          lead="Porządkujemy pomysł, zakres i zasady, zanim zaczniemy programować."
          class="max-w-3xl"
        />

        <div class="mt-12 space-y-12 lg:mt-16 lg:space-y-16">
          {preparationSteps.map((step, index) => (
            <article
              id={step.id}
              class="grid scroll-mt-24 grid-cols-1 gap-8 border-t border-line pt-8 lg:grid-cols-12 lg:gap-16"
            >
              <div
                class:list={["lg:col-span-6", index % 2 === 1 && "lg:order-2"]}
              >
                <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
                  0{index + 1} · {step.kicker}
                </p>
                <h3 class="mt-3 font-heading text-2xl leading-snug font-semibold text-balance sm:text-3xl">
                  {step.title}
                </h3>
                <p class="copy mt-4">{step.description}</p>
                <p class="mt-4 text-sm leading-relaxed text-pretty text-ink sm:text-base">
                  <span class="font-mono text-[10px] tracking-[0.14em] text-signal-ink uppercase">
                    Rezultat:
                  </span>{" "}
                  {step.result}
                </p>
              </div>

              <figure
                class:list={[
                  "lg:col-span-5",
                  index % 2 === 1
                    ? "lg:order-1 lg:col-start-1"
                    : "lg:col-start-8",
                ]}
              >
                {index === 0 && (
                  <Image
                    src={planningPhoto}
                    alt="Notatnik ze szkicami produktu, planem i osią procesu"
                    widths={[400, 600, 800, 1100]}
                    sizes="(min-width: 1024px) 420px, calc(100vw - 2rem)"
                    quality={82}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full rounded-xl border border-line object-cover"
                  />
                )}

                {index === 1 && (
                  <div class="rounded-xl border border-line bg-paper p-5 sm:p-6">
                    <p class="font-mono text-[10px] tracking-[0.16em] text-ink-soft uppercase">
                      Dokument roboczy
                    </p>
                    <p class="mt-2 font-heading text-lg font-semibold text-balance">
                      Zakres pierwszej wersji
                    </p>
                    <dl class="mt-4 border-t border-line">
                      {scopeRows.map(({ label, value }) => (
                        <div class="border-b border-line py-2.5 last:border-b-0">
                          <dt class="font-mono text-[10px] tracking-[0.12em] text-signal-ink uppercase">
                            {label}
                          </dt>
                          <dd class="mt-0.5 text-sm leading-relaxed text-pretty text-ink">
                            {value}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                )}

                {index === 2 && (
                  <div class="rounded-xl border border-line bg-paper p-5 sm:p-6">
                    <p class="font-mono text-[10px] tracking-[0.16em] text-ink-soft uppercase">
                      Functional Specification
                    </p>
                    <p class="mt-2 font-heading text-lg font-semibold text-balance">
                      Specyfikacja funkcjonalna
                    </p>
                    <dl class="mt-4 border-t border-line">
                      {specRows.map(({ label, value }) => (
                        <div class="border-b border-line py-2.5 last:border-b-0">
                          <dt class="font-mono text-[10px] tracking-[0.12em] text-signal-ink uppercase">
                            {label}
                          </dt>
                          <dd class="mt-0.5 text-sm leading-relaxed text-pretty text-ink">
                            {value}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                )}
              </figure>
            </article>
          ))}
        </div>

        <div class="mt-12 grid grid-cols-1 gap-6 border-t border-line pt-6 md:grid-cols-3 md:gap-10">
          <div>
            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
              Rezultat przygotowania
            </p>
            <p class="mt-2 font-heading text-lg leading-snug font-semibold text-balance">
              Zakres, cena i zasady w jednym miejscu.
            </p>
          </div>
          <ul class="md:col-span-2 grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2">
            {[
              "Zakres pierwszej wersji",
              "Cena: 29 500 zł brutto",
              "Termin: 4 tygodnie / zwykle 6–8 tygodni",
              "Kryteria odbioru i warunki w umowie",
            ].map((item) => (
              <li class="flex items-start gap-3 border-t border-line py-2.5">
                <Check
                  className="mt-0.5 size-4 shrink-0 text-signal"
                  aria-hidden="true"
                />
                <span class="text-sm leading-relaxed text-pretty text-ink">
                  {item}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="checklista" class="section-y border-t border-line bg-paper">
      <div class="shell">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <SectionHeading
              eyebrow="02 · Checklista"
              title="Nie musisz zaczynać od gotowej dokumentacji."
              lead="12 pytań pomaga uporządkować pomysł, użytkowników, budżet i ryzyka przed rozmową."
              class="max-w-3xl"
            />
            <p class="copy mt-4">Bezpłatna i dostępna bez rejestracji.</p>
            <a
              href="/checklista/"
              class={cn(
                buttonVariants({ variant: "outline", size: "lg" }),
                "mt-6 h-auto min-h-11 gap-2 rounded-[6px] px-5 py-2.5 text-center text-sm text-balance whitespace-normal sm:w-auto sm:text-base"
              )}
            >
              Pobierz bezpłatną checklistę
              <ArrowRight />
            </a>
            <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft">
              Wypełnienie nie jest warunkiem rozpoczęcia współpracy. PDF · 4
              strony.
            </p>
          </div>

          <figure class="mx-auto w-full max-w-[15rem] lg:col-span-4 lg:col-start-9">
            <Image
              src={checklistPreview}
              alt="Podgląd pierwszej strony checklisty „12 pytań, zanim zaczniesz budować aplikację”"
              widths={[240, 320, 480, 640]}
              sizes="240px"
              quality={80}
              loading="lazy"
              decoding="async"
              class="w-full rounded-lg border border-line"
            />
            <figcaption class="mt-3 text-sm leading-relaxed text-ink-soft">
              Podgląd pierwszej strony.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section
      id="analiza"
      class="section-y border-t border-line bg-surface-muted"
    >
      <div class="shell">
        <SectionHeading
          eyebrow="03 · Analiza i start"
          title="Opcjonalna analiza i jasne warunki startu."
          lead="Analiza nie jest obowiązkowa. Podstawowe ustalenie zakresu jest częścią standardowego pakietu."
          class="max-w-3xl"
        />

        <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-16">
          <div class="border-t border-line pt-5">
            <h3 class="font-heading text-xl leading-snug font-semibold text-balance">
              Analiza pomysłu i plan realizacji
            </h3>
            <p class="copy mt-3 text-sm">
              Dla projektów z kilkoma kierunkami lub potrzebą pisemnego planu
              przed decyzją o realizacji.
            </p>
            <a
              href="/oferta/#plan"
              class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Zobacz szczegóły analizy
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
            <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft">
              Usługa opcjonalna, wyceniana osobno. Nie jest warunkiem
              rozpoczęcia standardowego pakietu.
            </p>
          </div>

          <div class="border-t border-line pt-5">
            <h3 class="font-heading text-xl leading-snug font-semibold text-balance">
              Warunki rozpoczęcia prac
            </h3>
            <ul class="mt-3 border-t border-line">
              {startConditions.map((item) => (
                <li class="flex items-start gap-3 border-b border-line py-2.5">
                  <Check
                    className="mt-0.5 size-4 shrink-0 text-signal"
                    aria-hidden="true"
                  />
                  <span class="text-sm leading-relaxed text-pretty text-ink">
                    {item}
                  </span>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft">
              Od tego momentu liczy się termin czterech tygodni prac nad
              pierwszą wersją.
            </p>
            <a
              href="/oferta/#platnosci"
              class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Zobacz płatności i warunki
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="harmonogram" class="section-y border-t border-line bg-paper">
      <div class="shell">
        <SectionHeading
          eyebrow="04 · Harmonogram"
          title="Pięć etapów, trzy punkty kontrolne."
          lead="Od zakresu do przekazania produktu. Na desktopie przełączaj etapy, na mobile rozwiń szczegóły."
          class="max-w-3xl"
        />

        <ProjectJourney stages={processTimeline} media={journeyMedia} />

        <div class="mt-8 grid grid-cols-1 gap-6 border-t border-line pt-6 md:grid-cols-3 md:gap-10">
          <div>
            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
              Start prac
            </p>
            <p class="copy mt-2 text-sm">
              Po ustaleniu zakresu, podpisaniu umowy, wpłacie pierwszej części i
              skompletowaniu materiałów oraz dostępów.
            </p>
          </div>
          <div id="odbior" class="scroll-mt-24">
            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
              Odbiór
            </p>
            <p class="copy mt-2 text-sm">
              10 dni roboczych na sprawdzenie produktu i zgłoszenie niezgodności
              w uzgodnionym zakresie.
            </p>
          </div>
          <div>
