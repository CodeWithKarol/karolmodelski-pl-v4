---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight } from "lucide-react"

const metaTitle = "Sprawdź potwierdzenie rezerwacji | Karol Modelski"
const metaDescription =
  "Sprawdź potwierdzenie rezerwacji rozmowy. Wiadomość z datą spotkania i linkiem do rozmowy wysyła Calendly na podany adres e-mail."
---

<Layout
  title={metaTitle}
  description={metaDescription}
  noindex
  canonical={false}
>
  <SiteHeader variant="page" />

  <main id="main">
    <section class="bg-paper px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-3xl">
        <div class="rounded-2xl border border-line bg-surface-muted p-6 sm:p-10">
          <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.18em] text-signal-ink uppercase">
            <span class="h-px w-5 bg-signal" aria-hidden="true" />
            Potwierdzenie rezerwacji
          </p>

          <h1 class="mt-4 font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
            Sprawdź potwierdzenie swojej rezerwacji
          </h1>

          <div class="mt-6 space-y-4 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
            <p>
              Jeśli właśnie wybrałeś termin w Calendly, powinieneś otrzymać
              wiadomość e-mail z datą spotkania i linkiem do rozmowy.
            </p>
            <p>Nie widzisz wiadomości? Sprawdź również folder spam.</p>
          </div>

          <div class="mt-8">
            <a
              href="/rozmowa/#rezerwacja"
              class={cn(
                buttonVariants({ size: "lg" }),
                "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
              )}
            >
              Wróć do strony rezerwacji
              <ArrowRight />
            </a>
          </div>

          <p class="mt-6 border-t border-line pt-6 text-sm leading-relaxed text-pretty text-ink-soft">
            Nie dostałeś potwierdzenia albo termin nie odpowiada?{" "}
            <a
              href="mailto:kontakt@karolmodelski.pl?subject=Rezerwacja%20rozmowy"
              class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Napisz do mnie
            </a>
            .
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
