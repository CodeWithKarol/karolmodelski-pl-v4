---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight, Check } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/rozmowa/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const calendlyUrl = "https://calendly.com/kontakt-karolmodelski/konsultacja"

const preparationQuestions = [
  "Co chcesz stworzyć?",
  "Na jakim etapie jest pomysł?",
  "Kiedy chciałbyś rozpocząć realizację?",
]

const metaTitle =
  "Bezpłatna rozmowa o Twoim pomyśle na aplikację | Karol Modelski"
const metaDescription =
  "Masz pomysł na aplikację? Umów bezpłatną 20-minutową rozmowę. Sprawdzimy, od czego zacząć i czy pierwszą działającą wersję można stworzyć w 4 tygodnie."

const agenda = [
  {
    title: "Twój pomysł",
    description:
      "Opowiesz mi, co chcesz stworzyć, komu aplikacja miałaby służyć i co jest dla Ciebie najważniejsze.",
  },
  {
    title: "Możliwy pierwszy krok",
    description:
      "Zastanowimy się, od czego warto zacząć i które funkcje mogą poczekać na później.",
  },
  {
    title: "Dalsze możliwości",
    description:
      "Powiem Ci, czy widzę szansę na realizację pierwszej wersji w ramach mojego pakietu, czy projekt wymaga innego podejścia.",
  },
]

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Rozmowa",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-24">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Rozmowa</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-x-12">
          <div class="rise lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              Bezpłatna rozmowa · 20 minut
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">
              Porozmawiajmy o Twoim pomyśle na aplikację.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              W 20 minut omówimy Twój pomysł, wybierzemy możliwy pierwszy krok i
              sprawdzimy, czy mogę pomóc Ci w realizacji.
            </p>

            <p class="mt-6 max-w-xl border-l-2 border-signal pl-4 text-sm leading-relaxed text-pretty font-medium text-ink sm:text-base">
              Bezpłatnie · Online · Bez zobowiązań
            </p>
          </div>

          <aside
            id="rezerwacja"
            class="rise scroll-mt-24 lg:col-span-5"
            style="animation-delay:.12s"
          >
            <div class="on-ink rounded-2xl bg-ink p-6 text-paper sm:p-8">
              <h2 class="font-heading text-2xl leading-tight font-semibold text-balance text-paper">
                Wybierz dogodny termin
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-pretty text-paper/70">
                Rozmowa trwa około 20 minut i odbywa się online.
              </p>

              <a
                href={calendlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "mt-5 h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-5 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85"
                )}
              >
                Wybierz dogodny termin
                <ArrowRight />
              </a>

              <p class="mt-3 text-xs leading-relaxed text-pretty text-paper/55">
                Kalendarz otworzy się w nowej karcie. Po wybraniu terminu
                otrzymasz potwierdzenie oraz informacje potrzebne do dołączenia.
              </p>

              <p class="mt-3 text-xs leading-relaxed text-pretty text-paper/55">
                Nie musisz przygotowywać dokumentacji ani szczegółowo opisywać
                pomysłu podczas rezerwacji.
              </p>

              <div class="mt-5 border-t border-paper/15 pt-4">
                <p class="font-mono text-[10px] tracking-[0.16em] text-paper/60 uppercase">
                  Warto przygotować
                </p>
                <ul class="mt-3 space-y-2">
                  {preparationQuestions.map((question) => (
                    <li class="flex items-start gap-2.5">
                      <Check
                        className="mt-0.5 size-3.5 shrink-0 text-signal-bright"
                        aria-hidden="true"
                      />
                      <span class="text-sm leading-relaxed text-pretty text-paper/80">
                        {question}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-5 border-t border-paper/15 pt-4">
                <p class="text-xs leading-relaxed text-pretty text-paper/55">
                  Wolisz najpierw napisać?
                </p>
                <a
                  href="mailto:kontakt@karolmodelski.pl"
                  class="mt-1 inline-flex min-h-11 items-center text-sm font-medium text-paper underline decoration-paper/25 underline-offset-4 transition-colors hover:decoration-signal"
                >
                  kontakt@karolmodelski.pl
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section
      id="przebieg"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Co omówimy
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Co omówimy podczas rozmowy?
            </h2>

            <ol class="mt-10 grid grid-cols-1 gap-8 border-t border-line pt-8 md:grid-cols-3 md:gap-10">
              {agenda.map(({ title, description }, index) => (
                <li>
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                      Krok {index + 1}
                    </span>
                    <span class="font-mono text-xs text-ink-soft">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <h3 class="mt-4 font-heading text-lg leading-snug font-semibold text-balance text-ink sm:text-xl md:min-h-[4.5rem]">
                    {title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                    {description}
                  </p>
                </li>
              ))}
            </ol>

            <p class="mt-8 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
              Nie musisz znać się na technologii. Wystarczy, że opowiesz mi o
              pomyśle własnymi słowami.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="warto-wiedziec"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Warto wiedzieć
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Kilka rzeczy, które warto wiedzieć
            </h2>

            <ul class="mt-10 max-w-2xl border-t border-line">
              <li class="border-b border-line py-5">
                <p class="text-base leading-snug font-semibold text-ink sm:text-lg">
                  Rozmowa jest bezpłatna.
                </p>
                <p class="mt-1.5 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                  Trwa około 20 minut i nie zobowiązuje Cię do rozpoczęcia
                  współpracy.
                </p>
              </li>
              <li class="border-b border-line py-5">
                <p class="text-base leading-snug font-semibold text-ink sm:text-lg">
                  Nie potrzebujesz dokumentacji.
                </p>
                <p class="mt-1.5 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                  Możesz po prostu opowiedzieć mi, co chcesz stworzyć.
                </p>
              </li>
              <li class="border-b border-line py-5">
                <p class="text-base leading-snug font-semibold text-ink sm:text-lg">
                  Możemy najpierw podpisać NDA.
                </p>
                <p class="mt-1.5 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                  Jeśli Twój pomysł wymaga poufności, napisz do mnie przed
                  spotkaniem. Nie musisz wpisywać szczegółów rozwiązania w
                  formularzu rezerwacji.
                </p>
                <a
                  href="mailto:kontakt@karolmodelski.pl?subject=Umowa%20NDA%20przed%20rozmow%C4%85"
                  class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                >
                  Napisz w sprawie NDA
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section
      id="cena"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              03 · Po rozmowie
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-2xl leading-[1.15] font-semibold tracking-tight text-balance text-ink sm:text-3xl">
              A jeśli zdecydujemy się na współpracę?
            </h2>

            <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Mój standardowy pakiet przygotowania pierwszej działającej wersji
              aplikacji kosztuje{" "}
              <strong class="font-semibold text-ink">29 500 zł brutto</strong>.
            </p>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
              Nie każdy projekt zmieści się w tym zakresie. Podczas rozmowy
              wstępnie sprawdzimy, czy to odpowiednie rozwiązanie dla Twojego
              pomysłu.
            </p>

            <a
              href="/oferta/"
              class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Poznaj szczegóły oferty
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="termin"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="on-ink relative overflow-hidden rounded-2xl bg-ink px-6 py-10 text-paper sm:px-10 sm:py-12">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-32 -right-24 size-80 rounded-full bg-signal/20 blur-3xl"
          ></span>

          <div class="relative max-w-2xl">
            <h2 class="font-heading text-2xl leading-tight font-semibold tracking-tight text-balance sm:text-3xl">
              Masz pomysł? Porozmawiajmy.
            </h2>
            <p class="mt-3 text-base leading-relaxed text-pretty text-paper/75 sm:text-lg">
              Wybierz dogodny termin i opowiedz mi, co chcesz stworzyć.
            </p>

            <div class="mt-8">
              <a
                href="#rezerwacja"
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85 sm:w-auto sm:py-0 sm:whitespace-nowrap"
                )}
              >
                Umów bezpłatną rozmowę
                <ArrowRight />
              </a>

              <p class="mt-4 text-sm leading-relaxed text-paper/55">
                20 minut · Online · Bez zobowiązań
              </p>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="font-mono text-[11px] tracking-[0.16em] text-ink-soft uppercase">
              Wolisz najpierw napisać?
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
              <a
                href="mailto:kontakt@karolmodelski.pl"
                class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                kontakt@karolmodelski.pl
              </a>
              <a
                href="tel:+48664598563"
                class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                +48 664 598 563
              </a>
              <a
                href="https://wa.me/48664598563"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                WhatsApp
              </a>
            </div>
          </div>

          <div class="flex max-w-sm items-center gap-3">
            <img
              src="/karol-modelski-avatar.webp"
              alt="Karol Modelski"
              width="96"
              height="96"
              class="size-10 shrink-0 rounded-full object-cover"
            />
            <p class="text-sm leading-relaxed text-pretty text-ink-soft">
              <strong class="font-semibold text-ink">Karol Modelski</strong> —
              pomagam osobom z pomysłem na aplikację zamienić go w pierwszy
              działający produkt.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
