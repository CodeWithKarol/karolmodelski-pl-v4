---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight, Check, Lock } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/rozmowa/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const calendlyUrl = "https://calendly.com/kontakt-karolmodelski/konsultacja"

const metaTitle =
  "Bezpłatna rozmowa o Twoim pomyśle na aplikację | Karol Modelski"
const metaDescription =
  "Masz pomysł na aplikację? Umów bezpłatną 20-minutową rozmowę. Sprawdzimy, od czego zacząć i czy pierwszą działającą wersję można stworzyć w 4 tygodnie."

const steps = [
  {
    title: "Opowiesz mi, co chcesz stworzyć",
    paragraphs: [
      "Własnymi słowami.",
      "Możesz opowiedzieć, jak wyobrażasz sobie działanie aplikacji, komu miałaby służyć i dlaczego chcesz ją zbudować.",
      "Nie musisz znać nazw technologii ani przygotowywać szczegółowego opisu.",
    ],
  },
  {
    title: "Porozmawiamy o tym, co jest najważniejsze",
    paragraphs: [
      "Być może masz już pomysły na dziesiątki funkcji. To normalne.",
      "Spróbujemy ustalić, od czego warto zacząć i które rzeczy możemy spokojnie zostawić na później.",
      "Nie chodzi o rezygnowanie z Twojej wizji. Chodzi o znalezienie rozsądnego pierwszego kroku.",
    ],
  },
  {
    title: "Dowiesz się, jakie widzę możliwości",
    paragraphs: [
      "Powiem Ci, czy na podstawie naszej rozmowy widzę szansę na realizację pierwszej wersji w ramach mojego pakietu.",
      "Jeżeli pomysł jest bardziej rozbudowany i wymaga dodatkowej analizy albo większego budżetu, również Ci o tym powiem.",
      "Nie będę obiecywać, że każdą aplikację da się zbudować w cztery tygodnie.",
    ],
  },
]

const preparation = [
  "Co ma robić Twoja aplikacja?",
  "Kto miałby z niej korzystać?",
  "Co jest w Twoim pomyśle najważniejsze?",
]

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Rozmowa",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-24">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Rozmowa</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-6">
          <div class="rise lg:col-span-7 lg:col-start-1 lg:row-start-1">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              Bezpłatna rozmowa · 20 minut
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">
              Masz pomysł na aplikację? Porozmawiajmy o tym, od czego warto
              zacząć.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Nie musisz znać się na programowaniu ani wiedzieć, jak
              zorganizować cały projekt.
            </p>

            <p class="mt-4 max-w-xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Wystarczy, że opowiesz mi własnymi słowami, co chcesz stworzyć.
            </p>

            <p class="mt-6 max-w-xl border-l-2 border-signal pl-4 text-sm leading-relaxed text-pretty font-medium text-ink sm:text-base">
              Bez przygotowywania dokumentacji. Bez technicznego żargonu. Bez
              zobowiązań.
            </p>

            <a
              href="#jak-wyglada"
              class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Jak wygląda pierwsza rozmowa?
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>

          <aside
            class="rise lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1"
            style="animation-delay:.12s"
          >
            <div class="on-ink rounded-2xl bg-ink p-6 text-paper sm:p-8 lg:sticky lg:top-24">
              <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.18em] text-paper/60 uppercase">
                <span class="h-px w-5 bg-signal" aria-hidden="true" />
                Rezerwacja terminu
              </p>

              <p class="mt-4 font-heading text-3xl leading-tight font-semibold text-paper">
                20 minut{" "}
                <span class="text-xl font-medium text-paper/60">· online</span>
              </p>
              <p class="mt-2 text-sm leading-relaxed text-pretty text-paper/70">
                Bezpłatnie, bez przygotowywania dokumentacji i bez zobowiązań.
              </p>

              <a
                href={calendlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "mt-6 h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-5 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85"
                )}
              >
                Wybierz dogodny termin
                <ArrowRight />
              </a>

              <p class="mt-3 text-xs leading-relaxed text-paper/55">
                Kalendarz otworzy się w nowej karcie. Po wybraniu terminu
                otrzymasz potwierdzenie i informacje potrzebne do dołączenia.
              </p>

              <div class="mt-6 border-t border-paper/15 pt-5">
                <p class="text-sm leading-relaxed text-paper/70">
                  Wolisz najpierw napisać?
                </p>
                <a
                  href="mailto:kontakt@karolmodelski.pl"
                  class="mt-1 inline-flex min-h-11 items-center text-sm font-medium text-paper underline decoration-paper/25 underline-offset-4 transition-colors hover:decoration-signal"
                >
                  kontakt@karolmodelski.pl
                </a>
              </div>

              <div class="mt-4 border-t border-paper/15 pt-4">
                <p class="text-xs leading-relaxed text-pretty text-paper/55">
                  Nie chcesz jeszcze zdradzać szczegółów pomysłu? Nie musisz ich
                  wpisywać do formularza — możemy najpierw podpisać NDA.
                </p>
                <a
                  href="mailto:kontakt@karolmodelski.pl?subject=Umowa%20NDA%20przed%20rozmow%C4%85"
                  class="mt-1 inline-flex min-h-11 items-center text-xs font-medium text-paper underline decoration-paper/25 underline-offset-4 transition-colors hover:decoration-signal"
                >
                  Napisz w sprawie NDA
                </a>
              </div>
            </div>
          </aside>

          <div
            class="rise lg:col-span-7 lg:col-start-1 lg:row-start-2"
            style="animation-delay:.06s"
          >
            <p class="max-w-xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Podczas bezpłatnej, 20-minutowej rozmowy przyjrzymy się Twojemu
              pomysłowi, spróbujemy wybrać najważniejszą funkcję i sprawdzimy,
              czy możemy zacząć od pierwszej działającej wersji w 4 tygodnie.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="jak-wyglada"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Przebieg rozmowy
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Jak wygląda pierwsza rozmowa?
            </h2>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink">
              Nie jest to techniczny egzamin ani spotkanie, na które musisz
              przyjść z gotowym planem.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Chcę przede wszystkim zrozumieć Twój pomysł i pomóc Ci ocenić,
              jaki pierwszy krok ma sens.
            </p>

            <ol class="mt-10 grid grid-cols-1 gap-8 border-t border-line pt-8 md:grid-cols-3 md:gap-10">
              {steps.map(({ title, paragraphs }, index) => (
                <li>
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                      Krok {index + 1}
                    </span>
                    <span class="font-mono text-xs text-ink-soft">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <h3 class="mt-4 font-heading text-lg leading-snug font-semibold text-balance text-ink sm:text-xl md:min-h-[4.5rem]">
                    {title}
                  </h3>
                  <div class="mt-2 space-y-2 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                    {paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section
      id="przygotowanie"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Przygotowanie
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Co warto przygotować przed rozmową?
            </h2>
            <p class="mt-4 max-w-2xl font-heading text-xl leading-snug text-balance text-ink sm:text-2xl">
              Nic skomplikowanego.
            </p>

            <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Wystarczy, że zastanowisz się nad trzema pytaniami:
            </p>

            <ul class="mt-6 max-w-2xl border-t border-line">
              {preparation.map((question) => (
                <li class="flex items-start gap-3 border-b border-line py-4">
                  <Check
                    className="mt-0.5 size-4 shrink-0 text-signal"
                    aria-hidden="true"
                  />
                  <span class="text-sm leading-relaxed text-pretty text-ink sm:text-base">
                    {question}
                  </span>
                </li>
              ))}
            </ul>

            <p class="mt-6 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
              Jeśli masz już notatki, szkice albo przykłady podobnych aplikacji,
              możesz z nich skorzystać. Ale nie są wymagane.
            </p>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
              A jeśli nie potrafisz jeszcze odpowiedzieć na wszystkie pytania —
              właśnie po to jest nasza rozmowa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="nda"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              03 · Poufność
            </p>
          </div>

          <div class="lg:col-span-9">
            <div class="max-w-3xl rounded-2xl border border-line bg-paper p-6 sm:p-8">
              <div class="flex items-start gap-4">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full border border-line bg-surface-muted text-signal">
                  <Lock className="size-5" aria-hidden="true" />
                </span>
                <div>
                  <h2 class="font-heading text-2xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-3xl">
                    Wolisz najpierw zabezpieczyć swój pomysł?
                  </h2>
                  <p class="mt-3 text-base leading-relaxed text-pretty text-ink-soft">
                    Rozumiem. Jeśli nie chcesz opowiadać o szczegółach
                    rozwiązania bez wcześniejszego zabezpieczenia, możemy
                    najpierw podpisać umowę o poufności (NDA).
                  </p>
                  <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft">
                    Nie musisz ujawniać mi najważniejszych informacji już
                    podczas rezerwowania terminu.
                  </p>
                </div>
              </div>

              <div class="mt-6 border-t border-line pt-6">
                <a
                  href="mailto:kontakt@karolmodelski.pl?subject=Umowa%20NDA%20przed%20rozmow%C4%85"
                  class={cn(
                    buttonVariants({ variant: "outline", size: "lg" }),
                    "h-auto min-h-11 w-full gap-2 rounded-[6px] px-5 py-2.5 text-center text-sm text-balance whitespace-normal sm:w-auto sm:text-base"
                  )}
                >
                  Napisz w sprawie NDA
                  <ArrowRight />
                </a>
                <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft">
                  Po uzgodnieniu poufności będziemy mogli przejść do szczegółów.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="cena"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              04 · Koszt rozmowy
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Ile kosztuje taka rozmowa?
            </h2>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Nic. Pierwsza rozmowa jest bezpłatna i trwa około 20 minut.
            </p>

            <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">
              <div class="space-y-3 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                <p>
                  Nie podpisujesz żadnej umowy i nie zobowiązujesz się do
                  rozpoczęcia współpracy.
                </p>
                <p>
                  Jeśli okaże się, że Twój pomysł pasuje do mojego modelu
                  realizacji, wyjaśnię Ci, jak wyglądają następne kroki.
                </p>
                <p>
                  Nie każdy pomysł będzie można zrealizować w tej cenie i
                  terminie — dlatego właśnie zaczynamy od rozmowy.
                </p>
              </div>

              <div class="rounded-xl border border-line bg-paper p-5 sm:p-6">
                <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                  Standardowy pakiet
                </p>
                <p class="mt-2 font-heading text-3xl font-semibold text-signal-ink">
                  29 500 zł{" "}
                  <span class="text-base font-medium tracking-normal text-ink-soft">
                    brutto
                  </span>
                </p>
                <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft">
                  Przygotowanie pierwszej działającej wersji aplikacji. Zakres
                  ustalamy przed rozpoczęciem projektu.
                </p>
                <a
                  href="/oferta/"
                  class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                >
                  Poznaj szczegóły oferty
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="termin"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="on-ink relative overflow-hidden rounded-2xl bg-ink px-6 py-10 text-paper sm:px-10 sm:py-12">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-32 -right-24 size-80 rounded-full bg-signal/20 blur-3xl"
          ></span>

          <div class="relative max-w-2xl">
            <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] text-paper/60 uppercase">
              <span class="h-px w-5 bg-signal" aria-hidden="true" />
              05 · Rezerwacja
            </p>
            <h2 class="mt-4 font-heading text-2xl leading-tight font-semibold tracking-tight text-balance sm:text-3xl">
              Wybierz termin, który Ci odpowiada
            </h2>

            <div class="mt-4 space-y-3 text-base leading-relaxed text-pretty text-paper/75 sm:text-lg">
              <p>
                Jeśli masz pomysł i chcesz sprawdzić, jak można przejść do jego
                realizacji, zapraszam na rozmowę.
              </p>
              <p>
                Nie musisz wiedzieć, od czego zacząć. Od tego zaczniemy razem.
              </p>
            </div>

            <div class="mt-8">
              <a
                href={calendlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85 sm:w-auto sm:py-0 sm:whitespace-nowrap"
                )}
              >
                Wybierz dogodny termin
                <ArrowRight />
              </a>

              <p class="mt-4 text-sm leading-relaxed text-paper/55">
                20 minut · Online · Bezpłatnie · Bez zobowiązań
              </p>
            </div>

            <p class="mt-6 border-t border-paper/15 pt-5 text-sm leading-relaxed text-pretty text-paper/60">
              Po wybraniu terminu otrzymasz potwierdzenie spotkania i informacje
              potrzebne do dołączenia.
            </p>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="font-mono text-[11px] tracking-[0.16em] text-ink-soft uppercase">
              Wolisz najpierw napisać?
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
              <a
                href="mailto:kontakt@karolmodelski.pl"
                class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                kontakt@karolmodelski.pl
              </a>
              <a
                href="tel:+48664598563"
                class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                +48 664 598 563
              </a>
              <a
                href="https://wa.me/48664598563"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                WhatsApp
              </a>
            </div>
          </div>

          <div class="flex max-w-sm items-center gap-3">
            <img
              src="/karol-modelski-avatar.webp"
              alt="Karol Modelski"
              width="96"
              height="96"
              class="size-10 shrink-0 rounded-full object-cover"
            />
            <p class="text-sm leading-relaxed text-pretty text-ink-soft">
              <strong class="font-semibold text-ink">Karol Modelski</strong> —
              pomagam osobom z pomysłem na aplikację zamienić go w pierwszy
              działający produkt.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
