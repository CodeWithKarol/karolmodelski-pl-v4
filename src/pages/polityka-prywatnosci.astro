---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { ArrowLeft } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/polityka-prywatnosci/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle = "Polityka prywatności i plików cookies | Karol Modelski"
const metaDescription =
  "Jak przetwarzam dane osobowe i używam plików cookies w serwisie karolmodelski.pl – administrator, cele, odbiorcy, retencja i Twoje prawa."

const updatedAt = "19 listopada 2026 r."

const sections = [
  { id: "informacje-ogolne", n: "01", label: "Informacje ogólne" },
  { id: "administrator", n: "02", label: "Administrator danych" },
  { id: "zakres-danych", n: "03", label: "Zakres danych" },
  { id: "cele", n: "04", label: "Cele i podstawy prawne" },
  { id: "odbiorcy", n: "05", label: "Odbiorcy danych" },
  { id: "cookies", n: "06", label: "Pliki cookies" },
  { id: "retencja", n: "07", label: "Okres przechowywania" },
  { id: "transfery", n: "08", label: "Dane poza EOG" },
  { id: "prawa", n: "09", label: "Prawa osób" },
  { id: "dobrowolnosc", n: "10", label: "Dobrowolność danych" },
  { id: "automatyzacja", n: "11", label: "Automatyzacja" },
  { id: "bezpieczenstwo", n: "12", label: "Bezpieczeństwo" },
  { id: "zmiany", n: "13", label: "Zmiany polityki" },
]

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Polityka prywatności",
      item: pageURL,
    },
  ],
}

const h2 =
  "font-heading text-2xl leading-[1.2] font-semibold tracking-tight text-balance text-ink sm:text-3xl"
const h3 =
  "mt-8 font-heading text-lg leading-snug font-semibold text-balance text-ink"
const p = "mt-3 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base"
const pStrong = "mt-3 text-sm leading-relaxed text-pretty text-ink sm:text-base"
const list =
  "mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base"
const link =
  "underline decoration-line underline-offset-4 transition-colors hover:decoration-signal hover:text-ink"
const sectionClass =
  "scroll-mt-24 border-t border-line pt-10 first:border-t-0 first:pt-0"
const noteClass =
  "mt-5 rounded-xl border border-line bg-surface-muted p-5 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base"
const thClass =
  "border-b border-line py-3 pr-4 text-left font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase"
const tdClass = "border-b border-line py-3 pr-4 text-sm text-ink-soft"
const tdName = "border-b border-line py-3 pr-4 font-mono text-xs text-ink"
const doc = "mt-3 font-mono text-xs leading-relaxed break-words text-ink-soft"
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-14 sm:px-6 sm:pt-10 sm:pb-16">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Polityka prywatności</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="rise lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              Dokumenty prawne · Prywatność
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">
              Polityka prywatności i plików cookies
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Poniżej wyjaśniam, jakie dane zbieram w serwisie karolmodelski.pl,
              w jakim celu i na jakiej podstawie prawnej je przetwarzam, komu je
              powierzam oraz jak możesz kontrolować ich wykorzystanie.
            </p>

            <p class="mt-6 font-mono text-xs tracking-[0.14em] text-ink-soft uppercase">
              Serwis: karolmodelski.pl · Data aktualizacji:
              <time datetime="2026-11-19">{updatedAt}</time>
            </p>
          </div>

          <div class="rise lg:col-span-5" style="animation-delay:.12s">
            <div class="rounded-2xl border border-line bg-surface-muted p-6 sm:p-8">
              <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                Administrator danych
              </p>
              <p class="mt-3 font-heading text-xl leading-snug font-semibold text-balance text-ink">
                Karol Modelski
              </p>
              <p class="mt-1 text-sm leading-relaxed text-ink-soft">
                jednoosobowa działalność gospodarcza
              </p>

              <dl class="mt-5 space-y-3 border-t border-line pt-5 text-sm leading-relaxed">
                <div>
                  <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                    Adres
                  </dt>
                  <dd class="mt-0.5 text-ink">
                    ul. Mieczysława Karłowicza 1/40
                    <br />
                    58-506 Jelenia Góra
                  </dd>
                </div>
                <div>
                  <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                    NIP / REGON
                  </dt>
                  <dd class="mt-0.5 text-ink">6112800950 / 383132957</dd>
                </div>
                <div>
                  <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                    E-mail
                  </dt>
                  <dd class="mt-0.5">
                    <a class={link} href="mailto:kontakt@karolmodelski.pl">
                      kontakt@karolmodelski.pl
                    </a>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="tresc"
      class="border-t border-line bg-surface-muted px-4 py-14 sm:px-6 sm:py-20"
    >
      <div class="mx-auto max-w-[75rem] lg:grid lg:grid-cols-12 lg:gap-x-16">
        <nav
          aria-labelledby="spis-tresci"
          class="mb-10 lg:col-span-3 lg:mb-0 lg:self-start lg:sticky lg:top-24"
        >
          <p
            id="spis-tresci"
            class="font-mono text-[11px] tracking-[0.16em] text-ink-soft uppercase"
          >
            Spis treści
          </p>
          <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-1 border-t border-line pt-4 lg:grid-cols-1">
            {sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="flex min-h-11 items-baseline gap-2 rounded-lg px-2 py-2 text-sm leading-snug text-ink-soft transition-colors hover:bg-secondary hover:text-ink lg:min-h-0 lg:gap-3"
                >
                  <span class="font-mono text-[10px] text-ink-soft/70">
                    {section.n}
                  </span>
                  <span>{section.label}</span>
                </a>
              </li>
            ))}
          </ul>

          <a
            href="/"
            class="mt-6 inline-flex min-h-11 items-center gap-2 border-t border-line pt-4 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
          >
            <ArrowLeft className="size-4" aria-hidden="true" />
            Wróć na stronę główną
          </a>
        </nav>

        <article class="lg:col-span-9">
          <div class="max-w-2xl space-y-12">
            <section id="informacje-ogolne" class={sectionClass}>
              <h2 class={h2}>
                <span class="mr-3 align-middle font-mono text-xs font-normal tracking-[0.16em] text-ink-soft">
                  01
                </span>
                Informacje ogólne
              </h2>

              <p class={p}>
                Niniejsza Polityka prywatności określa zasady przetwarzania
                danych osobowych oraz stosowania plików cookies i podobnych
                technologii w serwisie karolmodelski.pl.
              </p>

              <p class={p}>
                Dane osobowe przetwarzane są zgodnie z obowiązującymi
                przepisami, w szczególności z rozporządzeniem Parlamentu
                Europejskiego i Rady (UE) 2016/679 (RODO) oraz ustawą z dnia 12
                lipca 2024 r. – Prawo komunikacji elektronicznej.
              </p>
            </section>

            <section id="administrator" class={sectionClass}>
              <h2 class={h2}>
                <span class="mr-3 align-middle font-mono text-xs font-normal tracking-[0.16em] text-ink-soft">
                  02
                </span>
                Administrator danych osobowych
              </h2>

              <p class={p}>Administratorem danych osobowych jest:</p>

              <p class={pStrong}>
                <strong class="font-semibold">
                  Karol Modelski, prowadzący jednoosobową działalność
                  gospodarczą pod firmą Karol Modelski.
                </strong>
              </p>

              <ul class={list}>
                <li>
                  Adres: ul. Mieczysława Karłowicza 1/40, 58-506 Jelenia Góra
                </li>
                <li>NIP: 6112800950</li>
                <li>REGON: 383132957</li>
                <li>
                  E-mail:{" "}
                  <a class={link} href="mailto:kontakt@karolmodelski.pl">
                    kontakt@karolmodelski.pl
                  </a>
                </li>
              </ul>

              <p class={p}>
                W sprawach związanych z ochroną danych osobowych możesz
                kontaktować się ze mną za pośrednictwem poczty elektronicznej
                lub korespondencyjnie.
              </p>
            </section>

            <section id="zakres-danych" class={sectionClass}>
              <h2 class={h2}>
                <span class="mr-3 align-middle font-mono text-xs font-normal tracking-[0.16em] text-ink-soft">
                  03
                </span>
                Zakres przetwarzanych danych
              </h2>

              <p class={p}>
                W zależności od sposobu korzystania z serwisu mogę przetwarzać:
              </p>

              <ul class={list}>
                <li>
                  adres e-mail podany podczas zapisu do newslettera lub
                  zamówienia checklisty;
                </li>
                <li>
                  imię, nazwisko, adres e-mail i inne dane dobrowolnie podane
                  podczas rezerwacji konsultacji;
                </li>
                <li>informacje przekazane w korespondencji;</li>
                <li>
                  datę, godzinę, źródło i potwierdzenie zgody na komunikację
                  marketingową;
                </li>
                <li>
                  informacje o interakcjach z wiadomościami e-mail, jeżeli
                  odpowiednie funkcje MailerLite są wykorzystywane;
                </li>
                <li>
                  adres IP, dane przeglądarki, urządzenia i informacje o
                  żądaniach HTTP;
                </li>
                <li>
                  identyfikatory internetowe oraz dane dotyczące korzystania ze
                  strony, jeśli użytkownik wyrazi odpowiednią zgodę;
                </li>
                <li>preferencje dotyczące plików cookies.</li>
              </ul>

              <p class={p}>
                Zakres przetwarzania zależy od wybranej funkcjonalności serwisu
                i udzielonych zgód.
              </p>
            </section>

            <section id="cele" class={sectionClass}>
              <h2 class={h2}>
                <span class="mr-3 align-middle font-mono text-xs font-normal tracking-[0.16em] text-ink-soft">
                  04
                </span>
                Cele i podstawy prawne przetwarzania danych
              </h2>

              <h3 class={h3}>4.1. Newsletter</h3>

              <p class={p}>
                Za pośrednictwem strony możesz zapisać się do newslettera
                prowadzonego przez Karola Modelskiego.
              </p>

              <p class={p}>Newsletter może zawierać:</p>

              <ul class={list}>
                <li>porady dotyczące tworzenia aplikacji internetowych;</li>
                <li>
                  materiały edukacyjne dotyczące planowania i realizacji
                  produktów cyfrowych;
                </li>
                <li>
                  informacje dotyczące wyboru funkcji pierwszej wersji
                  aplikacji;
                </li>
                <li>przykłady realizacji i doświadczenia projektowe;</li>
                <li>
                  informacje handlowe i marketingowe dotyczące usług
                  administratora.
                </li>
              </ul>

              <p class={p}>
                W celu obsługi newslettera przetwarzany jest przede wszystkim
                Twój adres e-mail.
              </p>

              <p class={p}>
                Podstawą prawną przetwarzania danych osobowych w celu wysyłki
                newslettera jest zgoda — art. 6 ust. 1 lit. a RODO.
              </p>

              <p class={p}>
                Wysyłanie informacji handlowych i marketingowych drogą
                elektroniczną odbywa się również na podstawie uprzedniej zgody
                wymaganej przez art. 398 Prawa komunikacji elektronicznej.
              </p>

              <p class={p}>
                Zgoda jest dobrowolna i może zostać wycofana w dowolnym
                momencie.
              </p>

              <p class={p}>
                Wycofanie zgody nie wpływa na zgodność z prawem przetwarzania
                danych dokonanego przed jej wycofaniem.
              </p>

              <p class={p}>
                Do obsługi formularzy, przechowywania kontaktów, zarządzania
                zgodami i wysyłki wiadomości wykorzystuję MailerLite.
              </p>

              <h3 class={h3}>4.2. Checklista dla subskrybentów</h3>

              <p class={p}>
                Osoby zapisujące się do newslettera mogą otrzymać bezpłatną
                checklistę „12 pytań, zanim zaczniesz budować aplikację”.
              </p>

              <p class={p}>
                Po potwierdzeniu zapisu checklista jest dostarczana drogą
                elektroniczną na podany adres e-mail za pośrednictwem
                MailerLite.
              </p>

              <p class={p}>
                Wysyłka checklisty jest elementem procesu powitalnego
                newslettera i wykorzystuje dane podane podczas zapisu.
              </p>

              <p class={p}>
                Jeżeli użytkownik chce otrzymać wyłącznie checklistę, bez
                zapisywania się do newslettera, może skorzystać z odrębnej
                możliwości pobrania materiału bez zgody na komunikację
                marketingową.
              </p>

              <p class={p}>
                Pobranie samej checklisty nie powoduje automatycznego zapisania
                na listę subskrybentów.
              </p>

              <h3 class={h3}>4.3. Potwierdzanie zapisu</h3>

              <p class={p}>
                W procesie zapisu do newslettera wykorzystywany jest mechanizm
                double opt-in.
              </p>

              <p class={p}>
                Po wypełnieniu formularza na podany adres e-mail wysyłana jest
                wiadomość zawierająca link potwierdzający zapis.
              </p>

              <p class={p}>
                Po potwierdzeniu adresu użytkownik zostaje aktywowany jako
                subskrybent newslettera.
              </p>

              <p class={p}>
                W celu udokumentowania zgody mogą być przechowywane informacje o
                dacie, godzinie, adresie IP, źródle i sposobie dokonania oraz
                potwierdzenia zapisu.
              </p>

              <p class={p}>
                Dane potwierdzające udzielenie lub wycofanie zgody mogą być
                przechowywane w zakresie niezbędnym do wykazania zgodności
                przetwarzania z prawem lub obrony przed roszczeniami, na
                podstawie art. 6 ust. 1 lit. f RODO.
              </p>

              <h3 class={h3}>4.4. Kontakt</h3>

              <p class={p}>
                W przypadku kontaktu e-mailowego przetwarzam dane przekazane w
                wiadomości w celu udzielenia odpowiedzi i obsługi
                korespondencji.
              </p>

              <p class={p}>
                Podstawą przetwarzania danych jest, zależnie od charakteru
                kontaktu:
              </p>

              <ul class={list}>
                <li>
                  art. 6 ust. 1 lit. b RODO — działania na żądanie osoby przed
                  zawarciem umowy lub realizacja umowy;
                </li>
                <li>
                  art. 6 ust. 1 lit. f RODO — prawnie uzasadniony interes
                  administratora związany z obsługą korespondencji.
                </li>
              </ul>

              <h3 class={h3}>4.5. Rezerwacja konsultacji</h3>

              <p class={p}>
                Serwis umożliwia rezerwację bezpłatnej konsultacji za
                pośrednictwem Calendly.
              </p>

              <p class={p}>
                W tym celu mogą być przetwarzane dane podane podczas rezerwacji,
                w szczególności imię, adres e-mail, termin spotkania oraz
                dodatkowe informacje dobrowolnie przekazane przez użytkownika.
              </p>

              <p class={p}>
                Podstawą przetwarzania jest art. 6 ust. 1 lit. b RODO, gdy
                konsultacja dotyczy działań przed zawarciem umowy, lub art. 6
                ust. 1 lit. f RODO, gdy przetwarzanie jest niezbędne do obsługi
                pozostałych zapytań.
              </p>

              <h3 class={h3}>4.6. Analityka</h3>

              <p class={p}>
                Serwis korzysta z Google Analytics 4 do analizowania liczby
                odwiedzin, źródeł ruchu, popularności poszczególnych podstron i
                interakcji użytkowników.
              </p>

              <p class={p}>
                Przetwarzanie danych osobowych w ramach opcjonalnych technologii
                analitycznych odbywa się na podstawie zgody użytkownika — art. 6
                ust. 1 lit. a RODO.
              </p>

              <p class={p}>
                Google Analytics 4 nie jest wykorzystywany do analityki przed
                uzyskaniem odpowiedniej zgody na analitykę.
              </p>

              <h3 class={h3}>4.7. Reklama i pomiar konwersji</h3>

              <p class={p}>
                Serwis wykorzystuje Meta Pixel do mierzenia skuteczności
                kampanii reklamowych prowadzonych m.in. na Facebooku i
                Instagramie.
              </p>

              <p class={p}>
                Dane mogą być wykorzystywane do pomiaru konwersji oraz, jeżeli
                zostaną uruchomione odpowiednie funkcje, do remarketingu i
                tworzenia grup odbiorców.
              </p>

              <p class={p}>
                Podstawą przetwarzania danych osobowych w ramach opcjonalnych
                technologii reklamowych jest zgoda — art. 6 ust. 1 lit. a RODO.
              </p>

              <p class={p}>
                Meta Pixel nie jest wykorzystywany do pomiaru ani remarketingu
                przed uzyskaniem odpowiedniej zgody na marketingowe cookies.
              </p>

              <h3 class={h3}>4.8. Bezpieczeństwo serwisu</h3>

              <p class={p}>
                Dane techniczne mogą być przetwarzane w celu zapewnienia
                działania serwisu, ochrony infrastruktury, diagnozowania błędów
                i zapobiegania nadużyciom.
              </p>

              <p class={p}>
                Podstawą prawną jest art. 6 ust. 1 lit. f RODO — prawnie
                uzasadniony interes administratora.
              </p>

              <h3 class={h3}>4.9. Roszczenia</h3>

              <p class={p}>
                Dane mogą być również przetwarzane w zakresie niezbędnym do
                ustalenia, dochodzenia lub obrony roszczeń na podstawie art. 6
                ust. 1 lit. f RODO.
              </p>
            </section>

            <section id="odbiorcy" class={sectionClass}>
              <h2 class={h2}>
                <span class="mr-3 align-middle font-mono text-xs font-normal tracking-[0.16em] text-ink-soft">
                  05
                </span>
                Odbiorcy danych i dostawcy usług
              </h2>

              <p class={p}>
                W związku z prowadzeniem strony korzystam z następujących
                dostawców:
              </p>

              <ul class={list}>
                <li>
                  <strong class="font-semibold text-ink">Vercel Inc.</strong> —
                  hosting strony, obsługa żądań internetowych oraz
                  infrastruktura techniczna. Nie korzystam z Vercel Analytics
                  ani Speed Insights.
                </li>
                <li>
                  <strong class="font-semibold text-ink">Google</strong> —
                  Google Analytics 4 do analizy ruchu oraz Google Tag Manager do
                  zarządzania tagami.
                </li>
                <li>
                  <strong class="font-semibold text-ink">Meta Platforms</strong>{" "}
                  — Meta Pixel wykorzystywany do pomiaru skuteczności kampanii
                  reklamowych i ewentualnego remarketingu.
                </li>
                <li>
                  <strong class="font-semibold text-ink">CookieYes</strong> —
                  zarządzanie zgodami na cookies oraz zapamiętywanie preferencji
                  użytkowników.
                </li>
                <li>
                  <strong class="font-semibold text-ink">MailerLite</strong> —
                  obsługa newslettera, zapisów, potwierdzeń subskrypcji,
                  automatycznych wiadomości i wysyłki checklisty.
                </li>
                <li>
                  <strong class="font-semibold text-ink">Calendly</strong> —
                  obsługa rezerwacji konsultacji.
                </li>
              </ul>

              <p class={p}>
