---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight, Check, Minus, Pause, Play } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/o-mnie/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle =
  "Karol Modelski – o mnie i moim doświadczeniu | Tworzenie aplikacji"
const metaDescription =
  "Poznaj Karola Modelskiego. Doświadczenie przy systemach dla banków i dużych firm, podejście do tworzenia aplikacji i przykład realizacji Numerabble."

const consultationUrl = "/rozmowa/"

const experienceQuestions = [
  "Kto będzie z tego korzystał?",
  "Co rzeczywiście musi działać?",
  "Jak sprawdzimy, że efekt jest zgodny z ustaleniami?",
  "Co się stanie, kiedy produkt trzeba będzie później rozwinąć?",
]

const experience = [
  {
    period: "2025 – obecnie",
    company: "GFT Technologies",
    role: "Senior Angular Developer",
    description:
      "Rozwój kluczowych rozwiązań dla sektora bankowego — skalowalne aplikacje webowe, architektura Nx Monorepo i narzędzia AI wspierające pracę zespołu.",
    stack: "Angular · TypeScript · Nx · RxJS · React Native",
  },
  {
    period: "2023 – 2025",
    company: "Silent Eight",
    role: "JavaScript Developer",
    description:
      "Architektura frontendowa platformy IRIS — systemu AI dla sektora finansowego do monitorowania transakcji i name screeningu.",
    stack: "Angular · React · NgRx · RxJS · Jest · Cypress",
  },
  {
    period: "2021 – 2023",
    company: "BNP Paribas Bank Polska",
    role: "Software Developer",
    description:
      "Współtworzenie platformy bankowości elektronicznej GOonline i modernizacja krytycznych systemów finansowych.",
    stack: "Angular · AngularJS · TypeScript · NgRx · Nx",
  },
  {
    period: "2019 – 2021",
    company: "Amway",
    role: "JavaScript Developer",
    description:
      "Rozwój platformy BOSS — systemu klasy enterprise dla Niezależnych Przedsiębiorców Amway.",
    stack: "Angular · TypeScript · RxJS · Jasmine · Karma",
  },
]

const collaborationSteps = [
  {
    label: "Ty",
    title: "Opowiadasz, co chcesz stworzyć",
    description:
      "Nie potrzebuję na początku skomplikowanej dokumentacji. Ważniejsze jest zrozumienie Twojego pomysłu i tego, komu ma służyć aplikacja.",
  },
  {
    label: "Razem",
    title: "Ustalamy, od czego zacząć",
    description:
      "Rozmawiamy o możliwych rozwiązaniach i wybieramy te, które mają największy sens w pierwszym etapie.",
  },
  {
    label: "Ja",
    title: "Organizuję realizację i pokazuję postępy",
    description:
      "Nie chcę, żebyś przez kilka tygodni zastanawiał się, co dzieje się z projektem. Regularnie omawiamy efekty, pytania i decyzje.",
  },
  {
    label: "Ty",
    title: "Sprawdzasz, czy idziemy w dobrym kierunku",
    description:
      "Pokazujesz, co odpowiada, a co wymaga poprawy. Testujemy produkt i porównujemy rezultat z tym, na co się umówiliśmy.",
  },
]

const clientQuestions = [
  "A co właściwie znaczy prototyp?",
  "Czy to już będzie działać, czy tylko będzie można poklikać po ekranach?",
  "Skąd mam wiedzieć, że to jest dobrze zrobione?",
  "Co będzie, jeżeli za miesiąc wpadnę na kolejny pomysł?",
]

const principles = [
  {
    title: "Jasne ustalenia",
    description:
      "Zanim rozpoczniemy prace, wiemy, co dokładnie ma powstać, w jakim terminie i za jaką kwotę. Nie chcę, żebyś po kilku tygodniach dowiadywał się, że inaczej rozumieliśmy zakres.",
  },
  {
    title: "Normalna komunikacja",
    description:
      "Jeżeli coś jest niejasne, rozmawiamy o tym. Jeżeli pojawia się problem, nie udaję, że go nie ma. A kiedy trzeba podjąć decyzję, wyjaśniam możliwe rozwiązania, rekomenduję to, które uważam za najrozsądniejsze, i tłumaczę dlaczego. Nie chcę zasypywać Cię technicznymi określeniami. Chcę, żebyś rozumiał, co robimy i z czego wynikają kolejne decyzje.",
  },
  {
    title: "Regularne pokazywanie efektów",
    description:
      "Chcę, żebyś widział, nad czym pracujemy. Dzięki temu oceniasz kierunek projektu na bieżąco, zamiast czekać do samego końca.",
  },
  {
    title: "Rozsądne podejście do budżetu",
    description:
      "Nie uważam, że każdą funkcję trzeba budować od razu. Wolę wspólnie ustalić, co jest najważniejsze, a kolejne rzeczy rozwijać wtedy, kiedy będzie ku temu powód.",
  },
  {
    title: "Odpowiedzialność za ustalony zakres",
    description:
      "Uzgadniamy warunki, harmonogram, sposób odbioru, zasady przekazania kodu oraz gwarancję techniczną. Znasz te zasady przed rozpoczęciem projektu, a nie dopiero wtedy, gdy pojawi się problem.",
  },
]

const goodFit = [
  "Masz pomysł na aplikację internetową, ale nie wiesz, jak przejść do jej realizacji.",
  "Chcesz zbudować pierwszą działającą wersję, zamiast od razu inwestować w rozbudowany produkt.",
  "Zależy Ci na współpracy z kimś, kto pomoże uporządkować zakres, wyjaśni techniczne kwestie i zajmie się koordynacją prac.",
  "Jesteś gotowy poświęcić trochę czasu na wspólne ustalenia, podejmowanie decyzji i testowanie efektów.",
]

const badFit = [
  "Potrzebujesz od razu bardzo rozbudowanego systemu z dziesiątkami funkcji, którego nie da się sensownie podzielić na mniejsze etapy.",
  "Szukasz wyłącznie pojedynczego programisty do wykonania z góry określonych zadań, bez pomocy w organizacji projektu.",
  "Oczekujesz gwarancji, że sama aplikacja odniesie sukces rynkowy.",
]

const profileLinks = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/karol-modelski/",
    description: "Zobacz moje doświadczenie zawodowe.",
  },
  {
    label: "GitHub",
    href: "https://github.com/CodeWithKarol",
    description: "Zobacz mój profil techniczny.",
  },
  {
    label: "Wizytówka Google",
    href: "https://g.page/r/CZSVfAGtTiIzEBM",
    description: "Sprawdź dane firmy.",
  },
]

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "O mnie",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="o-mnie" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-24">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">O mnie</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-12">
          <div class="rise lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>O mnie · Karol Modelski
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl xl:text-6xl">
              Cześć, jestem Karol. Pomagam tworzyć aplikacje.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink-soft sm:text-xl">
              Od ponad 7 lat pracuję przy oprogramowaniu dla banków i dużych
              firm. Dziś pomagam osobom z własnym pomysłem zamienić go w
              pierwszy działający produkt.
            </p>

            <div class="mt-8 flex flex-col items-start gap-4">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Porozmawiajmy o Twoim pomyśle
                <ArrowRight />
              </a>
              <p class="text-sm leading-relaxed text-pretty text-ink-soft">
                Bezpłatna rozmowa · 20 minut · Bez zobowiązań
              </p>
            </div>
          </div>

          <figure
            class="rise mx-auto w-full max-w-[21rem] lg:col-span-5"
            style="animation-delay:.12s"
          >
            <div class="overflow-hidden rounded-2xl border border-line bg-paper shadow-[0_35px_80px_-55px_rgba(20,20,20,0.5)]">
              <img
                src="/karol-modelski.webp"
                alt="Karol Modelski — twórca aplikacji i produktów cyfrowych"
                width="1024"
                height="1024"
                loading="eager"
                decoding="async"
                class="aspect-[4/5] w-full object-cover object-center"
              />
            </div>
            <figcaption class="mt-4">
              <span class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
                Karol Modelski
              </span>
              <span class="mt-1 block text-sm leading-relaxed text-ink-soft">
                Twórca aplikacji i produktów cyfrowych.
              </span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section
      id="droga"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Moja droga
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Pracowałem przy dużych systemach. I wiem, ile tam zależy od
              decyzji podjętych na starcie.
            </h2>

            <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              W takich projektach szybko uczysz się, że samo napisanie kodu to
              nie wszystko.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Trzeba jeszcze dobrze zrozumieć wymagania, przewidzieć możliwe
              problemy, zadbać o jakość i dopilnować, żeby wszystkie elementy
              współpracowały ze sobą tak, jak powinny. Czasem jedna pozornie
              drobna zmiana potrafi mieć wpływ na wiele innych rzeczy.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Dlatego nauczyłem się patrzeć na oprogramowanie nie tylko od
              strony technicznej, ale również od strony całego procesu.
            </p>

            <ul class="mt-8 grid max-w-2xl grid-cols-1 gap-x-10 gap-y-4 border-t border-line pt-6 sm:grid-cols-2">
              {experienceQuestions.map((question) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-2 h-px w-5 shrink-0 bg-signal"
                    aria-hidden="true"
                  />
                  <span class="text-sm leading-relaxed text-pretty text-ink sm:text-base">
                    {question}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-10 max-w-2xl border-t border-line pt-8">
              <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Wybrane doświadczenie zawodowe
              </h3>

              <ol class="mt-6">
                {experience.map(
                  ({ period, company, role, description, stack }) => (
                    <li class="grid grid-cols-1 gap-2 border-t border-line py-5 last:border-b sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-6">
                      <p class="font-mono text-xs tracking-[0.12em] text-ink-soft uppercase">
                        {period}
                      </p>
                      <div>
                        <p class="font-heading text-base font-semibold text-ink sm:text-lg">
                          {company}
                        </p>
                        <p class="text-sm text-ink-soft">{role}</p>
                        <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft">
                          {description}
                        </p>
                        <p class="mt-2 font-mono text-[10px] leading-relaxed tracking-[0.08em] text-ink-soft uppercase">
                          {stack}
                        </p>
                      </div>
                    </li>
                  )
                )}
              </ol>
            </div>

            <p class="mt-8 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Dziś wykorzystuję to doświadczenie również przy znacznie
              mniejszych projektach.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              I co ciekawe, wiele problemów jest podobnych.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Trzeba dobrze zrozumieć wymagania. Sprawdzić, czy wszystkie
              elementy do siebie pasują. Przewidzieć, co może pójść nie tak.
              Zadbać o to, żeby projekt nie rozrastał się bez kontroli.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Tylko że w przypadku osoby budującej pierwszą własną aplikację
              stawka bywa szczególnie ważna.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Często są to jej prywatne pieniądze i pomysł, który rozwijała
              przez wiele miesięcy albo nawet lat.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Dlatego nie chcę proponować klientowi rozwiązań tylko dlatego, że
              są technicznie ciekawe.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              Wolę najpierw ustalić, co naprawdę jest potrzebne, ile będzie
              kosztować i jakie korzyści ma przynieść.
            </p>

            <div class="mt-12 max-w-2xl border-t border-line pt-8">
              <h3 class="font-heading text-2xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-3xl">
                Dlaczego czasami odradzam klientom ich własne pomysły?
              </h3>
              <p class="mt-3 font-heading text-xl leading-snug text-balance text-ink sm:text-2xl">
                Bo nie każda dobra funkcja jest dobrym pomysłem na samym
                początku.
              </p>

              <p class="mt-5 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Podczas rozmów często okazuje się, że klient ma znacznie więcej
                pomysłów, niż początkowo zakładał.
              </p>
              <p class="mt-4 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                I ja to rozumiem. Kiedy przez długi czas rozwijasz własną
                koncepcję, trudno z czegoś zrezygnować.
              </p>
              <p class="mt-4 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Tylko że moją rolą nie jest przytakiwanie każdej propozycji.
              </p>
              <p class="mt-4 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Jeżeli widzę, że jakaś funkcja niepotrzebnie zwiększy koszt,
                skomplikuje aplikację albo opóźni jej uruchomienie, powiem Ci o
                tym wprost.
              </p>
              <p class="mt-4 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Wyjaśnię dlaczego i zaproponuję inne rozwiązanie.
              </p>
              <p class="mt-4 text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Oczywiście ostateczna decyzja należy do Ciebie. Ale chcę, żebyś
                podejmował ją, wiedząc, jakie będą konsekwencje.
              </p>

              <p class="mt-8 border-t border-line pt-6 font-heading text-xl leading-snug text-balance text-ink sm:text-2xl">
                Właśnie tak rozumiem dobrą współpracę.
              </p>

              <p class="mt-4 border-l-2 border-signal pl-5 text-base leading-relaxed text-pretty text-ink sm:text-lg">
                Nie chodzi o budowanie jak najmniejszej aplikacji. Chodzi o
                zbudowanie tego, co w danym momencie ma największy sens.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="wspolpraca"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Współpraca
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Ty znasz swój pomysł. Ja pomagam przełożyć go na konkretny plan i
              dopilnować realizacji.
            </h2>

            <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Nie musisz rozumieć wszystkich technicznych szczegółów. Nie musisz
              też samodzielnie szukać programistów, projektantów i zastanawiać
              się, czy każdy z nich dobrze wykonuje swoją część pracy.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Biorę na siebie organizację prac i koordynację techniczną
              projektu. Ale to nie oznacza, że podejmuję wszystkie decyzje za
              Ciebie.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              To nadal Twój produkt.
            </p>

            <ol class="mt-10 grid grid-cols-1 gap-x-10 md:grid-cols-2">
              {collaborationSteps.map(
                ({ label, title, description }, index) => (
                  <li class="border-t border-line py-6">
                    <div class="flex items-center justify-between gap-4">
                      <span class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                        {label}
                      </span>
                      <span class="font-mono text-xs text-ink-soft">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                    </div>
                    <h3 class="mt-3 font-heading text-lg leading-snug font-semibold text-balance text-ink sm:text-xl">
                      {title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                      {description}
                    </p>
                  </li>
                )
              )}
            </ol>

            <p class="mt-6 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
              Jeśli pojawiają się nowe pomysły, wspólnie oceniamy, czy warto
              realizować je teraz, czy zostawić na później.
            </p>

            <a
              href="/jak-pracuje/"
              class={cn(
                buttonVariants({ variant: "outline", size: "lg" }),
                "mt-6 h-auto min-h-11 w-full gap-2 rounded-[6px] px-5 py-2.5 text-center text-sm text-balance whitespace-normal sm:w-auto sm:text-base"
              )}
            >
              Zobacz, jak pracuję z klientami
              <ArrowRight />
            </a>

            <a
              href="/oferta/"
              class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Sprawdź zakres mojej oferty
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>

            <div class="mt-12 border-t border-line pt-8">
              <h3 class="font-heading text-2xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-3xl">
                Nie chcę, żebyś musiał uczyć się programowania tylko po to, żeby
                zrealizować swój pomysł.
              </h3>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                W rozmowach z osobami, które po raz pierwszy tworzą aplikację,
