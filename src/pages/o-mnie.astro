---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import CareerTimeline from "@/components/about/career-timeline.astro"
import ResponsibilitySplit from "@/components/about/responsibility-split.astro"
import PrincipleList from "@/components/about/principle-list.astro"
import FitColumns from "@/components/about/fit-columns.astro"
import { Image } from "astro:assets"
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import portrait from "@/assets/images/karol-modelski-portrait.webp"
import thinking from "@/assets/images/about/b01-thinking-partner.webp"
import supplementaryPortrait from "@/assets/images/about/b02-approachable-expert.webp"
import workspace from "@/assets/images/about/b03-consultants-workspace.webp"
import talk from "@/assets/images/about/b04-playwright-talk.webp"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/o-mnie/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle =
  "Karol Modelski – o mnie i moim doświadczeniu | Tworzenie aplikacji"
const metaDescription =
  "Poznaj Karola Modelskiego. Doświadczenie przy systemach dla banków i dużych firm, podejście do tworzenia aplikacji i przykład realizacji Numerabble."

const consultationUrl = "/rozmowa/"

const experience = [
  {
    period: "2025 – obecnie",
    company: "GFT Technologies",
    role: "Senior Angular Developer",
    summary:
      "Rozwój aplikacji dla sektora bankowego, architektura Nx Monorepo i narzędzia AI wspierające pracę zespołu.",
    stack: "Angular · TypeScript · Nx · RxJS · React Native",
  },
  {
    period: "2023 – 2025",
    company: "Silent Eight",
    role: "JavaScript Developer",
    summary:
      "Architektura frontendowa platformy IRIS — systemu AI do monitorowania transakcji i name screeningu.",
    stack: "Angular · React · NgRx · RxJS · Jest · Cypress",
  },
  {
    period: "2021 – 2023",
    company: "BNP Paribas Bank Polska",
    role: "Software Developer",
    summary:
      "Współtworzenie platformy bankowości elektronicznej GOonline i modernizacja krytycznych systemów finansowych.",
    stack: "Angular · AngularJS · TypeScript · NgRx · Nx",
  },
  {
    period: "2019 – 2021",
    company: "Amway",
    role: "JavaScript Developer",
    summary:
      "Rozwój platformy BOSS — systemu klasy enterprise dla Niezależnych Przedsiębiorców Amway.",
    stack: "Angular · TypeScript · RxJS · Jasmine · Karma",
  },
]

const responsibilityGroups = [
  {
    label: "Ty",
    lead: "Wizja i kontekst",
    items: [
      "dla kogo jest produkt i jaki problem rozwiązuje,",
      "cele biznesowe i priorytety,",
      "decyzje o kierunku produktu.",
    ],
  },
  {
    label: "Razem",
    lead: "Zakres i kompromisy",
    items: [
      "zakres pierwszej wersji,",
      "kolejność funkcji i decyzje,",
      "koszt, termin i konsekwencje.",
    ],
  },
  {
    label: "Ja",
    lead: "Technologia i realizacja",
    items: [
      "wybór technologii i architektura,",
      "organizacja prac i koordynacja specjalistów,",
      "testy, odbiór i przekazanie produktu.",
    ],
  },
]

const principles = [
  {
    title: "Jasne ustalenia",
    description:
      "Przed startem wiemy, co powstaje, w jakim terminie i za jaką kwotę.",
  },
  {
    title: "Normalna komunikacja",
    description:
      "Problemy i wątpliwości nazywamy wprost. Bez technicznego żargonu i bez udawania, że wszystko jest oczywiste.",
  },
  {
    title: "Regularne pokazywanie efektów",
    description: "Widzisz postępy na bieżąco, a nie dopiero na końcu projektu.",
  },
  {
    title: "Rozsądne podejście do budżetu",
    description:
      "Najpierw to, co daje realną wartość. Kolejne funkcje rozwijamy wtedy, kiedy mają sens.",
  },
  {
    title: "Odpowiedzialność za ustalony zakres",
    description:
      "Zasady odbioru, przekazania kodu i gwarancji znasz przed rozpoczęciem prac.",
  },
]

const goodFit = [
  "Masz pomysł na aplikację internetową i chcesz przejść od koncepcji do pierwszej działającej wersji.",
  "Wolisz etapować projekt i najpierw sprawdzić najważniejszą funkcję, zamiast od razu budować cały system.",
  "Chcesz partnera, który pomoże uporządkować zakres, wyjaśni decyzje techniczne i zajmie się koordynacją.",
]

const badFit = [
  "Potrzebujesz od razu bardzo rozbudowanego systemu, którego nie da się sensownie podzielić na etapy.",
  "Szukasz wyłącznie programisty do wykonania z góry określonych zadań, bez wsparcia w organizacji projektu.",
  "Oczekujesz gwarancji, że sam produkt odniesie sukces rynkowy.",
]

const profileLinks = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/karol-modelski/",
    description: "Doświadczenie zawodowe i kontakt.",
  },
  {
    label: "GitHub",
    href: "https://github.com/CodeWithKarol",
    description: "Profil techniczny i projekty.",
  },
  {
    label: "Wizytówka Google",
    href: "https://g.page/r/CZSVfAGtTiIzEBM",
    description: "Dane firmy i opinie.",
  },
  {
    label: "Realizacje",
    href: "/realizacje/",
    description: "Przykłady rzeczywistych projektów.",
  },
  {
    label: "Wiedza",
    href: "/wiedza/",
    description: "Poradniki o tworzeniu aplikacji.",
  },
  {
    label: "FAQ",
    href: "/faq/",
    description: "Najczęstsze pytania o współpracę.",
  },
]

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "O mnie",
      item: pageURL,
    },
  ],
}

const aboutSchema = {
  "@type": "AboutPage",
  "@id": `${pageURL}#about`,
  url: pageURL,
  name: metaTitle,
  description: metaDescription,
  inLanguage: "pl-PL",
  isPartOf: { "@id": `${siteRoot}#website` },
  mainEntity: { "@id": `${siteRoot}#person` },
  about: { "@id": `${siteRoot}#person` },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: new URL(portrait.src, siteURL).toString(),
    width: portrait.width,
    height: portrait.height,
  },
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[breadcrumbSchema, aboutSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="o-mnie" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-50"
      ></div>

      <div class="shell pt-10 pb-16 sm:pt-16 sm:pb-24 lg:pt-24 lg:pb-28">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">O mnie</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal" aria-hidden="true" />O mnie
            </p>

            <h1 class="mt-6 font-heading text-[clamp(2.5rem,1.5rem+3vw,5rem)] leading-[1.02] font-semibold tracking-tight text-balance">
              Cześć, jestem Karol.
            </h1>

            <p class="mt-5 max-w-2xl font-heading text-[clamp(1.5rem,1.2rem+1vw,2rem)] leading-[1.25] font-medium tracking-tight text-balance text-ink">
              Pomagam zamieniać pomysły w działające produkty.
            </p>

            <p class="mt-5 max-w-[38rem] text-[17px] leading-[1.7] text-pretty text-ink-soft sm:text-lg">
              Od ponad 7 lat pracuję przy oprogramowaniu dla banków i dużych
              organizacji. Dziś pomagam osobom z pomysłem przejść od koncepcji
              do pierwszej działającej wersji. Nie chodzi o wielki system od
              pierwszego dnia — o wersję, którą można pokazać użytkownikom i
              sprawdzić w praktyce.
            </p>

            <div class="mt-8">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Porozmawiajmy o Twoim pomyśle
                <ArrowRight aria-hidden="true" />
              </a>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft">
                Bezpłatna rozmowa · 20 minut · Bez zobowiązań
              </p>
            </div>
          </div>

          <figure class="mx-auto w-full max-w-[28rem] lg:col-span-5">
            <Image
              src={portrait}
              alt="Karol Modelski — portret"
              widths={[480, 720, 960, 1086]}
              sizes="(min-width: 1024px) 460px, (min-width: 640px) 448px, calc(100vw - 2rem)"
              quality={84}
              loading="eager"
              decoding="async"
              class="aspect-[3/4] w-full rounded-lg border border-line object-cover object-top"
            />
            <figcaption class="mt-3 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
              Karol Modelski · techniczny partner pomysłodawców
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section
      id="doswiadczenie"
      class="section-y border-t border-line bg-surface-muted"
    >
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Doświadczenie
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="max-w-3xl font-heading text-[clamp(2rem,1.4rem+1.8vw,2.75rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Duże systemy nauczyły mnie, że decyzje na starcie mają znaczenie.
            </h2>
            <div class="mt-6 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
              <div class="md:col-span-7">
                <p class="max-w-[38rem] text-[17px] leading-[1.7] text-pretty text-ink-soft sm:text-lg">
                  Lata pracy przy systemach bankowych i enterprise nauczyły mnie
                  patrzeć na produkt szerzej niż na kod: wymagania, ryzyka,
                  jakość i konsekwencje zmian. To doświadczenie przenoszę dziś
                  na mniejsze projekty, w których liczy się każda decyzja i
                  budżet. Dzięki temu wiem, gdzie kończy się dobra funkcja, a
                  zaczyna niepotrzebna złożoność.
                </p>
              </div>

              <figure class="md:col-span-5">
                <Image
                  src={workspace}
                  alt="Biurko z otwartym notatnikiem, szkicami interfejsu i laptopem"
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1024px) 320px, (min-width: 768px) 40vw, calc(100vw - 2rem)"
                  quality={84}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full rounded-lg border border-line object-cover md:aspect-[4/3]"
                />
                <figcaption class="mt-3 text-xs leading-relaxed text-ink-soft">
                  Ilustracja koncepcyjna: notatki, szkice i praca nad zakresem.
                </figcaption>
              </figure>
            </div>

            <div class="mt-12 border-t border-line pt-8">
              <p class="mb-8 text-sm leading-relaxed text-ink-soft">
                Poniżej historia zatrudnienia — nie lista klientów obecnych
                projektów.
              </p>
              <CareerTimeline entries={experience} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="dzielenie-sie-wiedza"
      class="section-y border-t border-line bg-paper"
    >
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Wiedza
            </p>
          </div>

          <div class="lg:col-span-9">
            <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-12">
              <figure class="md:col-span-5">
                <Image
                  src={talk}
                  alt="Karol Modelski podczas szkolenia z automatyzacji testów (Playwright)"
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1024px) 420px, (min-width: 768px) 40vw, calc(100vw - 2rem)"
                  quality={84}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full rounded-lg border border-line object-cover object-top"
                />
                <figcaption class="mt-3 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                  Szkolenie z automatyzacji testów · Playwright
                </figcaption>
              </figure>

              <div class="md:col-span-7">
                <h2 class="font-heading text-[clamp(2rem,1.4rem+1.8vw,2.75rem)] leading-[1.12] font-semibold tracking-tight text-balance">
                  Lubię upraszczać to, co wydaje się skomplikowane.
                </h2>
                <p class="mt-5 max-w-[38rem] text-[17px] leading-[1.7] text-pretty text-ink-soft sm:text-lg">
                  Prowadziłem szkolenie z automatyzacji testów w Playwright i
                  piszę poradniki o tworzeniu aplikacji. Pokazuję, jak
                  techniczne decyzje przekładają się na praktykę — bez zbędnego
                  żargonu. Dobre wyjaśnienie jest częścią dobrego produktu.
                </p>
                <a
                  href="/wiedza/"
                  class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                >
                  Czytaj poradniki w centrum wiedzy
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="filozofia"
      class="force-dark on-ink section-y border-t border-line bg-ink text-paper"
    >
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-paper/65 uppercase lg:sticky lg:top-24">
              03 · Filozofia pracy
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="max-w-4xl font-heading text-[clamp(2rem,1.3rem+2vw,3rem)] leading-[1.1] font-semibold tracking-tight text-balance">
              Nie każda wartościowa funkcja musi znaleźć się w pierwszej wersji
              produktu.
            </h2>
            <p class="mt-6 max-w-[38rem] text-[17px] leading-[1.7] text-pretty text-paper/80 sm:text-lg">
              Kiedy lista pomysłów rośnie, pomagam oddzielić to, co daje wartość
              teraz, od tego, co może poczekać. Wyjaśniam koszt, ryzyko i
              konsekwencje. Proponuję alternatywy. Decyzja zostaje po Twojej
              stronie.
            </p>

            <ul class="mt-10 grid max-w-3xl grid-cols-1 gap-x-10 sm:grid-cols-2">
              {[
                "Świadome decyzje zamiast domysłów.",
                "Konsekwencje zamiast obietnic.",
                "Szacunek do budżetu i czasu.",
                "Twoja decyzyjność na końcu.",
              ].map((item) => (
                <li class="border-t border-paper/15 py-3.5 text-[15px] leading-relaxed text-paper">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section
      id="odpowiedzialnosc"
      class="section-y border-t border-line bg-paper"
    >
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              04 · Odpowiedzialność
            </p>
          </div>

          <div class="lg:col-span-9">
            <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10">
              <div class="md:col-span-7">
                <h2 class="font-heading text-[clamp(2rem,1.4rem+1.8vw,2.75rem)] leading-[1.12] font-semibold tracking-tight text-balance">
                  Ty, ja i decyzje pomiędzy nami.
                </h2>
                <p class="mt-5 max-w-[38rem] text-[17px] leading-[1.7] text-pretty text-ink-soft sm:text-lg">
                  Nie przejmuję Twojego projektu. Biorę odpowiedzialność za
                  techniczną stronę i organizację pracy, ale najważniejsze
                  decyzje o produkcie nadal należą do Ciebie.
                </p>
              </div>

              <figure class="md:col-span-5">
                <Image
                  src={thinking}
                  alt="Karol Modelski szkicujący interfejs przy biurku"
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 1024px) 320px, (min-width: 768px) 40vw, calc(100vw - 2rem)"
                  quality={84}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full rounded-lg border border-line object-cover"
                />
                <figcaption class="mt-3 text-xs leading-relaxed text-ink-soft">
                  Praca nad zakresem i pierwszymi szkicami — materiał
                  ilustracyjny.
                </figcaption>
              </figure>
            </div>

            <div class="mt-10">
              <ResponsibilitySplit groups={responsibilityGroups} />
            </div>

            <a
              href="/jak-pracuje/"
              class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
            >
              Zobacz, jak pracuję krok po kroku
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="numerabble"
      class="section-y border-t border-line bg-surface-muted"
    >
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              05 · Przykład
            </p>
          </div>

          <div class="lg:col-span-9">
            <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
              <div class="lg:col-span-5">
                <h2 class="font-heading text-[clamp(1.75rem,1.4rem+1vw,2.25rem)] leading-[1.15] font-semibold tracking-tight text-balance">
                  Numerabble: najpierw sprawdzić, czy gra działa.
                </h2>
                <p class="mt-5 text-[16px] leading-[1.7] text-pretty text-ink-soft sm:text-[17px]">
                  Klient przez prawie 30 lat rozwijał koncepcję gry
                  matematycznej. Miał listę przyszłych funkcji: rankingi,
                  turnieje, rozgrywki online. Zamiast budować wszystko,
                  wybraliśmy grywalną wersję w przeglądarce, która pozwalała
                  sprawdzić najważniejszą mechanikę.
                </p>
                <p class="mt-3 text-[16px] leading-[1.7] text-pretty text-ink-soft sm:text-[17px]">
                  To nie był kompromis jakościowy, tylko decyzja o kolejności.
                  Podczas testów doprecyzowaliśmy zasady i zachowanie gry.
                </p>
                <a
                  href="/realizacje/numerabble/"
                  class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                >
                  Zobacz pełną historię Numerabble
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              </div>

              <figure class="lg:col-span-7">
                <div class="overflow-hidden rounded-lg border border-line bg-paper">
                  <video
                    controls
                    muted
                    playsinline
                    preload="none"
                    poster="/showcase/numerabble-gameplay.webp"
                    width="960"
                    height="720"
                    aria-label="Fragment rzeczywistej rozgrywki Numerabble — plansza, żetony gracza i panel punktacji"
                    class="block aspect-[4/3] w-full object-cover"
                  >
                    <source
                      src="/showcase/numerabble-gameplay.webm"
                      type="video/webm"
                    />
                    Twoja przeglądarka nie obsługuje nagrań wideo.
                    <a href="/showcase/numerabble-gameplay.webm">
                      Otwórz nagranie
                    </a>
                    .
                  </video>
                </div>
                <figcaption class="mt-3 text-sm leading-relaxed text-ink-soft">
                  Fragment rzeczywistej rozgrywki. Nagranie bez dźwięku.
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="zasady" class="section-y border-t border-line bg-paper">
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              06 · Zasady
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-[clamp(2rem,1.4rem+1.8vw,2.75rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Pięć zasad, które porządkują współpracę.
            </h2>
            <p class="mt-5 max-w-[38rem] text-[17px] leading-[1.7] text-pretty text-ink-soft sm:text-lg">
              Nie są to hasła na ścianie. To sposób, w jaki prowadzę projekty i
              podejmuję decyzje. Zasady są proste, ale konsekwentnie stosowane.
            </p>

            <div class="mt-8">
              <PrincipleList items={principles} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="dopasowanie"
      class="section-y border-t border-line bg-surface-muted"
    >
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              07 · Dopasowanie
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-[clamp(2rem,1.4rem+1.8vw,2.75rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Dla kogo to dobre dopasowanie?
            </h2>

            <div class="mt-8">
              <FitColumns
                good={goodFit}
                bad={badFit}
                note="Nie obiecuję sukcesu rynkowego. Mogę pomóc zbudować produkt i przygotować go do sprawdzenia w praktyce."
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="profile" class="section-y border-t border-line bg-paper">
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              08 · Profile
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-[clamp(2rem,1.4rem+1.8vw,2.75rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Możesz sprawdzić, kim jestem.
            </h2>
            <p class="mt-5 max-w-[38rem] text-[17px] leading-[1.7] text-pretty text-ink-soft sm:text-lg">
              Nie musisz opierać się wyłącznie na tym, co napisałem na tej
              stronie. Zajrzyj do publicznych profili i przykładów realizacji.
            </p>

            <ul class="mt-8 grid grid-cols-1 gap-x-10 gap-y-5 border-t border-line pt-6 sm:grid-cols-2 lg:grid-cols-3">
              {profileLinks.map(({ label, href, description }) => (
                <li>
                  <a
                    href={href}
                    target={href.startsWith("http") ? "_blank" : undefined}
                    rel={href.startsWith("http") ? "me noopener" : undefined}
                    class="group inline-flex min-h-11 flex-col justify-center gap-1 text-sm"
                  >
                    <span class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors group-hover:decoration-signal">
                      {label}
                    </span>
                    <span class="text-xs leading-relaxed text-ink-soft">
                      {description}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section
      id="kontakt"
      class="force-dark on-ink section-y border-t border-line bg-ink text-paper"
    >
      <div class="shell">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-paper/65 uppercase lg:sticky lg:top-24">
              09 · Rozmowa
            </p>
            <figure class="mt-6 hidden max-w-[14rem] lg:block">
              <Image
                src={supplementaryPortrait}
                alt="Karol Modelski w jasnym wnętrzu, siedzący w fotelu"
                widths={[240, 360, 480]}
                sizes="224px"
                quality={84}
                loading="lazy"
                decoding="async"
                class="aspect-[3/4] w-full rounded-lg border border-paper/15 object-cover"
              />
            </figure>
          </div>

          <div class="lg:col-span-9">
            <h2 class="max-w-3xl font-heading text-[clamp(2rem,1.3rem+2vw,3.25rem)] leading-[1.08] font-semibold tracking-tight text-balance">
              Chętnie poznam Twój pomysł.
            </h2>
            <p class="mt-5 max-w-[38rem] text-[17px] leading-[1.7] text-pretty text-paper/80 sm:text-lg">
              Opowiesz mi, co chcesz stworzyć. W 20 minut sprawdzimy pierwszy
              krok — bez zobowiązań i bez konieczności przygotowywania
              dokumentacji technicznej.
            </p>

            <div class="mt-8">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85 sm:w-auto"
                )}
              >
                Umów bezpłatną rozmowę
                <ArrowRight aria-hidden="true" />
              </a>
              <p class="mt-4 text-sm leading-relaxed text-paper/60">
                20 minut · Online · Bezpłatnie · Bez zobowiązań
              </p>
              <p class="mt-2 text-sm leading-relaxed text-paper/60">
                Możliwość podpisania NDA przed rozmową.
              </p>
              <a
                href="/checklista/"
                class="mt-3 inline-flex min-h-11 items-center text-sm text-paper/60 underline decoration-paper/25 underline-offset-4 transition-colors hover:text-paper hover:decoration-signal"
              >
                Wolisz najpierw uporządkować pomysł? Pobierz checklistę.
              </a>
            </div>

            <p class="mt-10 border-t border-paper/15 pt-5 font-heading text-lg font-semibold text-paper">
              Do usłyszenia! Karol
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <CompactFooter />
</Layout>
