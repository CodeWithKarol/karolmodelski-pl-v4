---
import Layout from "@/layouts/main.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowLeft } from "lucide-react"
---

<Layout
  title="Nie znaleziono strony (404) | Karol Modelski"
  description="Ta strona nie istnieje lub została przeniesiona. Wróć na stronę główną."
  noindex
>
  <main
    class="flex min-h-svh flex-col items-center justify-center px-4 py-20 text-center sm:px-6"
  >
    <p
      class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
    >
      Błąd 404
    </p>
    <h1
      class="mt-3 text-3xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-4xl md:text-5xl"
    >
      Nie znaleźliśmy tej strony
    </h1>
    <p
      class="mt-4 max-w-md text-base leading-relaxed text-pretty text-muted-foreground"
    >
      Wygląda na to, że ten adres nie istnieje lub został przeniesiony. Wróć na
      stronę główną, aby dowiedzieć się, jak w 30 dni zamienić pomysł w
      działającą aplikację.
    </p>
    <a
      href="/"
      class={cn(
        buttonVariants({ size: "lg" }),
        "mt-8 h-auto min-h-12 gap-2 rounded-full px-6 py-3 text-base"
      )}
    >
      <ArrowLeft />
      Wróć na stronę główną
    </a>
  </main>
</Layout>
