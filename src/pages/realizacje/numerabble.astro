---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { realizacjaPath } from "@/data/realizacje"
import { ArrowRight, Check, Minus, Pause, Play } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL(realizacjaPath("numerabble"), siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle = "Numerabble – od pomysłu do działającej gry | Karol Modelski"
const metaDescription =
  "Jak pomysł na grę matematyczną sprzed prawie 30 lat zamienił się w działającą aplikację? Poznaj historię Numerabble, proces realizacji i pierwsze testy."

const consultationUrl = "/rozmowa/"

const heroFacts = [
  {
    label: "Zaplanowane prace",
    value: "4 tygodnie",
    note: "nad pierwszą wersją",
  },
  {
    label: "Dostęp",
    value: "Przeglądarka",
    note: "bez instalacji",
  },
  {
    label: "Tryb",
    value: "Gra z komputerem",
    note: "bez drugiego gracza",
  },
  {
    label: "Po pierwszej wersji",
    value: "Testy",
    note: "z użytkownikami",
  },
]

const ideaChips = [
  "Rozgrywki z ludźmi z całego świata",
  "Rankingi",
  "Turnieje",
  "Różne poziomy trudności",
  "Rywalizacja ze sztuczną inteligencją",
  "Wykorzystanie gry w szkołach",
]

const inScope = [
  "Plansza z polami premiowymi i naliczaniem punktów",
  "Układanie działań matematycznych i zatwierdzanie ruchu",
  "Przeciwnik komputerowy, który odpowiada własnym ruchem",
  "Obsługa gry na komputerze i na telefonie",
  "Strona produktu z przejściem do rozgrywki",
  "Wersja polska i angielska",
]

const outOfScope = [
  "Konta graczy i logowanie",
  "Rozgrywki między ludźmi przez internet",
  "Rankingi i turnieje",
  "Dodatkowe poziomy trudności",
  "Osobne aplikacje mobilne",
  "Wykorzystanie gry w szkołach",
]

const designQuestions = [
  "Jak duża powinna być plansza?",
  "Jak gracz ma układać cyfry i znaki na telefonie, żeby wszystko było czytelne?",
  "W jaki sposób komputer ma wybierać swoje ruchy?",
  "Jak naliczać punkty i bonusy?",
  "Co zrobić, żeby gra nie była ani zbyt łatwa, ani zbyt trudna?",
  "Jak wyjaśnić zasady komuś, kto widzi Numerabble pierwszy raz?",
]

const weeks = [
  {
    label: "Tydzień 1",
    title: "Gra zaczyna nabierać kształtu",
    description:
      "Zaczęliśmy od wyglądu planszy, rozmieszczenia elementów i sposobu obsługi. Zależało nam szczególnie na tym, żeby dało się wygodnie grać również na telefonie. Przygotowaliśmy pierwsze projekty i sprawdzaliśmy, czy wszystko jest wystarczająco czytelne.",
  },
  {
    label: "Tydzień 2",
    title: "Gra musi pilnować własnych zasad",
    description:
      "Następnie zajęliśmy się tym, co dzieje się pod spodem. Komputer musi wiedzieć, które działania są poprawne, kiedy gracz zdobywa punkty i jak naliczać premie. To ważne, bo w takiej grze jeden źle policzony ruch może popsuć całą rozgrywkę.",
  },
  {
    label: "Tydzień 3",
    title: "Pojawia się przeciwnik komputerowy",
    description:
      "Kolejnym krokiem było przygotowanie przeciwnika, z którym można rozegrać partię. Nie chcieliśmy jedynie przesuwać cyferek po planszy. Gra miała dawać możliwość prawdziwej rywalizacji, w której komputer analizuje sytuację i odpowiada własnym ruchem.",
  },
  {
    label: "Tydzień 4",
    title: "Pierwsza wersja trafia do przeglądarki",
    description:
      "Przygotowaliśmy stronę produktu oraz wersję gry dostępną przez internet. Dzięki temu nie trzeba było od razu publikować aplikacji w sklepach na Androida i iPhone'a. Wystarczyło otworzyć stronę, żeby rozpocząć rozgrywkę. Dodaliśmy również narzędzia pozwalające sprawdzać, jak ludzie korzystają z gry.",
  },
]

const fixes = [
  {
    title: "Za małe elementy na telefonie",
    description:
      "Poprawiliśmy rozmiary i odstępy w widoku na mniejszych ekranach.",
  },
  {
    title: "Czytelność punktacji",
    description: "Zmieniliśmy sposób wyświetlania wyniku w trakcie partii.",
  },
  {
    title: "Ruch komputera niezgodny z zasadami",
    description: "Poprawiliśmy logikę wyboru i sprawdzania ruchów przeciwnika.",
  },
  {
    title: "Korekta bonusów",
    description: "Doprecyzowaliśmy naliczanie premii za zajęte pola.",
  },
]

const analyticsQuestions = [
  "Czy ktoś rzeczywiście rozpoczyna partię?",
  "Ile czasu spędza w grze?",
  "Czy kończy rozgrywkę?",
  "Czy wraca później?",
  "Czy udostępnia ją innym?",
]

const deliverables = [
  {
    title: "Działająca gra w przeglądarce",
    description: "Można ją uruchomić na komputerze lub telefonie.",
  },
  {
    title: "Podstawowa rozgrywka z komputerem",
    description: "Bez konieczności szukania drugiego gracza.",
  },
  {
    title: "Mechanizm sprawdzania zasad i naliczania punktów",
    description: "Uwzględnia działania matematyczne i premie.",
  },
  {
    title: "Projekt wyglądu i obsługi gry",
    description: "Przygotowany również z myślą o mniejszych ekranach.",
  },
  {
    title: "Strona internetowa Numerabble",
    description: "Można na niej poznać grę i przejść do rozgrywki.",
  },
  {
    title: "Narzędzia do obserwowania zachowań graczy",
    description: "Pomagają oceniać, co działa, a co wymaga poprawy.",
  },
  {
    title: "Podstawa do dalszego rozwoju",
    description: "Bez konieczności zaczynania całego projektu od nowa.",
  },
]

const nextDirections = [
  "Rozgrywki między ludźmi przez internet",
  "Rankingi",
  "Turnieje",
  "Nowe sposoby rywalizacji",
  "Wykorzystanie gry w edukacji",
]

const pageSchema = {
  "@type": "CreativeWork",
  "@id": `${pageURL}#realizacja`,
  name: "Numerabble — pierwsza działająca wersja gry w przeglądarce",
  headline:
    "Numerabble. Pomysł sprzed prawie 30 lat, w który dziś można już zagrać.",
  description: metaDescription,
  inLanguage: "pl-PL",
  genre: "Studium realizacji",
  about: "Numerabble — gra matematyczna",
  creator: {
    "@type": "Person",
    "@id": `${siteRoot}#person`,
    name: "Karol Modelski",
    url: siteRoot,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${pageURL}#webpage` },
  image: {
    "@type": "ImageObject",
    url: new URL("/showcase/numerabble-gameplay.webp", siteURL).toString(),
    width: 960,
    height: 720,
  },
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Realizacje",
      item: new URL("/realizacje/", siteURL).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Numerabble",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[pageSchema, breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="realizacje" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-24">
      <div class="board-grid" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <a class="transition-colors hover:text-ink" href="/realizacje/">
                Realizacje
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Numerabble</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-12">
          <div class="rise lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              Realizacje · Numerabble
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl xl:text-6xl">
              Numerabble. Pomysł sprzed prawie 30 lat, w który dziś można już
              zagrać.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Zamiast od razu budować rozbudowaną aplikację, zaczęliśmy od tego,
              co najważniejsze — działającej gry z komputerem, dostępnej w
              przeglądarce.
            </p>
          </div>

          <figure
            class="rise mx-auto w-full lg:col-span-5"
            style="animation-delay:.12s"
          >
            <div class="overflow-hidden rounded-2xl border border-line bg-paper shadow-[0_35px_80px_-55px_rgba(20,20,20,0.5)]">
              <div class="flex items-center gap-2 border-b border-line px-4 py-3">
                <span
                  class="size-2.5 rounded-full bg-signal/70"
                  aria-hidden="true"
                ></span>
                <span
                  class="size-2.5 rounded-full bg-line"
                  aria-hidden="true"
                ></span>
                <span
                  class="size-2.5 rounded-full bg-line"
                  aria-hidden="true"
                ></span>
                <p class="ml-2 truncate font-mono text-[10px] tracking-[0.12em] text-ink-soft uppercase">
                  Numerabble · przeglądarka
                </p>
              </div>
              <video
                data-clip
                class="block aspect-[4/3] w-full object-cover"
                src="/showcase/numerabble-gameplay.webm"
                poster="/showcase/numerabble-gameplay.webp"
                width="960"
                height="720"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Rozgrywka w Numerabble — plansza, ułożone działanie i panel z żetonami"
              ></video>
            </div>
            <figcaption class="mt-4">
              <p class="text-sm leading-relaxed text-pretty text-ink-soft">
                Tak wygląda pierwsza działająca wersja Numerabble. Nie jest to
                makieta ani film pokazujący, jak gra mogłaby kiedyś wyglądać. To
                prawdziwa rozgrywka.
              </p>
              <button
                type="button"
                data-clip-toggle
                data-state="playing"
                class="mt-4 inline-flex items-center gap-2 rounded-md border border-line px-3 py-1.5 font-mono text-[11px] tracking-[0.14em] text-ink-soft uppercase transition-colors hover:border-ink/25 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
              >
                <Pause
                  data-clip-icon-pause
                  className="size-3.5"
                  aria-hidden="true"
                />
                <Play
                  data-clip-icon-play
                  className="size-3.5"
                  aria-hidden="true"
                />
                <span data-clip-label>Wstrzymaj nagrania</span>
              </button>
            </figcaption>
          </figure>
        </div>

        <dl class="mt-14 grid grid-cols-1 gap-y-6 border-t border-line pt-8 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-8 lg:grid-cols-4">
          {heroFacts.map(({ label, value, note }) => (
            <div>
              <dt class="font-mono text-[11px] leading-4 tracking-[0.16em] text-ink-soft uppercase sm:min-h-8">
                {label}
              </dt>
              <dd class="mt-2">
                <span class="block font-heading text-xl font-semibold sm:text-2xl">
                  {value}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-ink-soft">
                  {note}
                </span>
              </dd>
            </div>
          ))}
        </dl>

        <dl class="mt-10 grid grid-cols-1 gap-6 border-t border-line pt-8 sm:grid-cols-3">
          <div>
            <dt class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
              Wyzwanie
            </dt>
            <dd class="mt-2 text-sm leading-relaxed text-pretty text-ink">
              Przenieść wieloletni pomysł na grę do przeglądarki bez budowania
              wszystkich planowanych funkcji.
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
              Decyzja
            </dt>
            <dd class="mt-2 text-sm leading-relaxed text-pretty text-ink">
              Zacząć od rozgrywki z komputerem i dopracować szczegółowe zasady
              działania.
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
              Rezultat
            </dt>
            <dd class="mt-2 text-sm leading-relaxed text-pretty text-ink">
              Działająca gra w przeglądarce, gotowa do udostępnienia i
              rozpoczęcia testów.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section
      id="pomysl"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Pomysł
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Wszystko zaczęło się od pomysłu, który miał już prawie 30 lat
            </h2>

            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink">
              Wyobraź sobie grę, w której zamiast układać słowa, układasz
              działania matematyczne.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Masz cyfry, znaki działań, planszę, pola premiowe i przeciwnika,
              którego trzeba przechytrzyć. Trochę liczenia, trochę strategii i
              kombinowania, żeby zdobyć jak najwięcej punktów.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Właśnie taki pomysł miał mój klient.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Przez lata dopracowywał zasady i zastanawiał się, jak rozwinąć
              grę. W końcu pojawiła się możliwość przeniesienia jej do świata
              aplikacji.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              A skoro aplikacja, to przecież można zrobić znacznie więcej niż w
              tradycyjnej grze planszowej.
            </p>

            <ul class="mt-8 flex max-w-2xl flex-wrap gap-2">
              {ideaChips.map((idea) => (
                <li class="rounded-full border border-line px-3 py-1.5 text-sm leading-snug text-ink-soft">
                  {idea}
                </li>
              ))}
            </ul>

            <p class="mt-6 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              Pomysłów naprawdę nie brakowało.
            </p>

            <div class="relative mt-10 border-t border-line pt-8">
              <span
                class="absolute -top-px left-0 h-px w-20 bg-signal"
                aria-hidden="true"
              />
              <p class="max-w-3xl font-heading text-xl leading-snug text-balance text-ink sm:text-2xl">
                Problem polegał na tym, że ktoś musiał zdecydować, od czego
                właściwie zacząć.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="zakres"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Zakres
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Chcieliśmy zbudować aplikację. Tylko czy od razu całą?
            </h2>

            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink">
              Podczas pierwszych rozmów szybko zobaczyłem, jak duże możliwości
              ma ten projekt. Ale zobaczyłem też coś innego.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Każda kolejna funkcja oznacza dodatkową pracę, kolejne decyzje i
              większy budżet. Można przecież od razu zrobić aplikację na
              telefony, konta graczy, rozgrywki przez internet, turnieje,
              rankingi i całą resztę.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Tylko po co budować to wszystko na początku, skoro nie
              sprawdziliśmy jeszcze najważniejszej rzeczy?
            </p>

            <div class="mt-8 max-w-3xl rounded-2xl border border-line bg-paper p-6 sm:p-8">
              <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                Pytanie, od którego zaczęliśmy
              </p>
              <p class="mt-3 font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Czy sama gra jest na tyle ciekawa, że ludzie będą chcieli w nią
                grać?
              </p>
            </div>

            <p class="mt-8 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Zaproponowałem więc inne podejście. Zamiast zaczynać od wielkiej
              aplikacji, skupmy się na samej rozgrywce.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Zróbmy wersję, w której będzie można usiąść, rozegrać partię z
              komputerem i sprawdzić, czy pomysł działa w praktyce. Bez kont
              użytkowników, rozbudowanych rankingów i wszystkich dodatków, które
              mogą poczekać.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              Najpierw zbudujmy solidną podstawę. Resztą zajmiemy się później,
              kiedy będziemy wiedzieć więcej.
            </p>

            <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
              <div class="bg-paper p-6 sm:p-8">
                <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                  W pierwszej wersji
                </p>
                <ul class="mt-5 space-y-3">
                  {inScope.map((item) => (
                    <li class="flex items-start gap-3">
                      <Check
                        className="mt-0.5 size-4 shrink-0 text-signal"
                        aria-hidden="true"
                      />
                      <span class="text-sm leading-relaxed text-pretty text-ink sm:text-base">
                        {item}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="bg-paper p-6 sm:p-8">
                <p class="font-mono text-[11px] tracking-[0.16em] text-ink-soft uppercase">
                  Poza pierwszą wersją
                </p>
                <ul class="mt-5 space-y-3">
                  {outOfScope.map((item) => (
                    <li class="flex items-start gap-3">
                      <Minus
                        className="mt-0.5 size-4 shrink-0 text-ink-soft"
                        aria-hidden="true"
                      />
                      <span class="text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                        {item}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <p class="mt-8 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              I właśnie na taki plan się umówiliśmy.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="zasady"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
