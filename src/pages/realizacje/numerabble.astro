---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import CaseStudyHero from "@/components/case-study/case-study-hero.astro"
import ScopeComparison from "@/components/portfolio/project-scope-comparison.astro"
import DesignChallenges from "@/components/case-study/design-challenges.astro"
import ProjectTimeline from "@/components/case-study/project-timeline.astro"
import ProblemSolution from "@/components/case-study/problem-solution.astro"
import ResearchQuestions from "@/components/case-study/research-questions.astro"
import ProductShowcase from "@/components/case-study/product-showcase.astro"
import ProjectOutcomes from "@/components/case-study/project-outcomes.astro"
import FutureRoadmap from "@/components/case-study/future-roadmap.astro"
import ProjectTestimonial from "@/components/portfolio/project-testimonial.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { Image } from "astro:assets"
import { ArrowRight } from "lucide-react"
import { realizacjaPath } from "@/data/realizacje"
import { numerabbleTestimonial } from "@/data/testimonials"
import currentUi from "@/assets/images/numerabble-current-ui.webp"
import deskCurrent from "@/assets/images/numerabble-desk-current.webp"
import laptopImage from "@/assets/images/numerabble-laptop-desk.webp"
import phoneImage from "@/assets/images/numerabble-laptop-phone.webp"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL(realizacjaPath("numerabble"), siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle = "Numerabble – od pomysłu do działającej gry | Karol Modelski"
const metaDescription =
  "Prawie 30 lat pomysłu i cztery tygodnie prac nad pierwszą grywalną wersją. Poznaj decyzje, testy, poprawki i rezultat projektu Numerabble."

const heroMetrics = [
  { label: "Zaplanowane prace", value: "4 tygodnie" },
  { label: "Dostęp", value: "Przeglądarka" },
  { label: "Tryb", value: "Gra z komputerem" },
  { label: "Kolejny etap", value: "Testy i poprawki" },
]

const inScope = [
  "Plansza z polami premiowymi i naliczaniem punktów",
  "Układanie działań i zatwierdzanie ruchu",
  "Przeciwnik komputerowy",
  "Komputer i telefon w przeglądarce",
  "Strona produktu",
  "Wersja polska i angielska",
]

const outOfScope = [
  "Konta użytkowników",
  "Rozgrywki online między graczami",
  "Rankingi",
  "Turnieje",
  "Dodatkowe poziomy trudności",
  "Osobne aplikacje mobilne",
  "Zastosowania edukacyjne",
]

const designAreas = [
  {
    title: "Plansza i interfejs",
    questions: [
      "Jak duża powinna być plansza?",
      "Jak układać cyfry i znaki na telefonie?",
    ],
    detail: "Plansza musiała być czytelna także na małym ekranie.",
  },
  {
    title: "Logika punktowania i reguły",
    questions: [
      "Jak naliczać punkty i premie?",
      "Co zrobić w sytuacjach, których zasady nie przewidziały?",
    ],
    detail: "Reguły musiały być jednoznaczne dla gry i dla gracza.",
  },
  {
    title: "Przeciwnik komputerowy",
    questions: [
      "Jak komputer wybiera ruchy?",
      "Jak utrzymać poziom, który nie jest zbyt łatwy ani zbyt trudny?",
    ],
    detail: "Przeciwnik miał grać sensownie, nie losowo.",
  },
]

const timeline = [
  {
    week: "Tydzień 1",
    title: "Interfejs, plansza i obsługa",
    text: "Ustaliliśmy rozmiary, układ planszy i sposób układania żetonów. Wygodne granie na komputerze i telefonie.",
  },
  {
    week: "Tydzień 2",
    title: "Logika, zasady i punktacja",
    text: "Każde działanie musiało zostać sprawdzone, a punkty naliczone zgodnie z zasadami — razem z premiami.",
  },
  {
    week: "Tydzień 3",
    title: "Przeciwnik komputerowy",
    text: "Komputer wykonywał własne ruchy i reagował na sytuację na planszy. Chodziło o realną partię, nie przesuwanie żetonów.",
  },
  {
    week: "Tydzień 4",
    title: "Przeglądarka, strona i analityka",
    text: "Gra bez instalacji, wersja polska i angielska oraz pierwsze narzędzia do obserwacji zachowań. Dzięki temu grę można było pokazać bez instalacji.",
  },
]

const problems = [
  {
    problem: "Za małe elementy na telefonie",
    action: "Powiększyliśmy i rozsunęliśmy elementy interfejsu.",
  },
  {
    problem: "Mało czytelna punktacja",
    action: "Zmieniliśmy sposób prezentowania wyniku w trakcie partii.",
  },
  {
    problem: "Ruch komputera niezgodny z zasadami",
    action: "Poprawiliśmy logikę wyboru i sprawdzania ruchów.",
  },
  {
    problem: "Błędne naliczanie bonusów",
    action: "Doprecyzowaliśmy zasady premii za zajęte pola.",
  },
]

const researchQuestions = [
  "Czy użytkownik zaczyna rozgrywkę?",
  "Czy kończy partię?",
  "Ile czasu spędza w grze?",
  "Czy wraca później?",
  "Czy udostępnia produkt innym?",
]

const outcomes = [
  {
    title: "Świadomy zakres",
    text: "Najpierw to, co pozwala sprawdzić pomysł w praktyce.",
  },
  {
    title: "Testowanie produktu",
    text: "Decyzje na podstawie użycia, nie założeń.",
  },
  {
    title: "Kolejne decyzje",
    text: "Dalszy rozwój zależy od obserwacji graczy.",
  },
]

const roadmap = [
  {
    status: "Zrealizowane",
    tone: "done" as const,
    items: [
      "Gra w przeglądarce",
      "Rozgrywka z komputerem",
      "Strona produktu",
      "Narzędzia analityczne",
    ],
  },
  {
    status: "Testowane",
    tone: "tested" as const,
    items: ["Opinie pierwszych graczy", "Zachowania w grze", "Strona produktu"],
  },
  {
    status: "Rozważane",
    tone: "considered" as const,
    items: [
      "Rozgrywki online",
      "Rankingi i turnieje",
      "Nowe tryby",
      "Usprawnienia strony produktu",
      "Zastosowania edukacyjne",
    ],
  },
]

const pageSchema = {
  "@type": "CreativeWork",
  "@id": `${pageURL}#realizacja`,
  name: "Numerabble — pierwsza działająca wersja gry w przeglądarce",
  headline:
    "Prawie 30 lat pomysłu. Cztery tygodnie prac nad pierwszą grywalną wersją.",
  description: metaDescription,
  inLanguage: "pl-PL",
  genre: "Studium realizacji",
  about: "Numerabble — gra matematyczna",
  creator: {
    "@type": "Person",
    "@id": `${siteRoot}#person`,
    name: "Karol Modelski",
    url: siteRoot,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${pageURL}#webpage` },
  image: {
    "@type": "ImageObject",
    url: new URL(currentUi.src, siteURL).toString(),
    width: currentUi.width,
    height: currentUi.height,
  },
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Realizacje",
      item: new URL("/realizacje/", siteURL).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Numerabble",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[pageSchema, breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="realizacje" />

  <main id="main">
    <CaseStudyHero
      breadcrumb={["Strona główna", "Realizacje", "Numerabble"]}
      eyebrow="Studium przypadku"
      title="Prawie 30 lat pomysłu. Cztery tygodnie prac nad pierwszą grywalną wersją."
      lead="Zamiast od razu budować rozbudowaną aplikację, zaczęliśmy od tego, co najważniejsze — działającej gry z komputerem w przeglądarce."
      note="Cztery tygodnie dotyczą prac nad pierwszą wersją, a nie całego okresu współpracy."
      metrics={heroMetrics}
      image={currentUi}
      imageAlt="Numerabble — aktualny interfejs rozgrywki: plansza, żetony i panel punktacji na laptopie"
      caption="Aktualny interfejs gry — rozgrywka z komputerem."
    />

    <section
      id="pomysl"
      class="border-t border-line bg-surface-muted px-4 py-12 sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Pomysł i zakres
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="max-w-[26ch] font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Pomysł, który miał prawie 30 lat.
            </h2>
            <div class="mt-4 max-w-[42rem] space-y-3 text-[16px] leading-[1.7] text-pretty text-ink-soft">
              <p>
                Wyobraź sobie grę, w której zamiast słów układasz działania
                matematyczne. Masz cyfry, znaki, planszę, pola premiowe i
                przeciwnika, którego trzeba przechytrzyć.
              </p>
              <p>
                Klient przez lata dopracowywał tę grę: planszę, cyfry, znaki
                działań, pola premiowe i zasady.
              </p>
              <p>
                Kiedy pojawiła się możliwość przeniesienia jej do aplikacji,
                pomysłów nagle zrobiło się więcej: rozgrywki online, rankingi,
                turnieje, poziomy trudności, rywalizacja z AI, zastosowania w
                szkołach. Pomysłów naprawdę nie brakowało.
              </p>
              <p>
                Każdy z nich brzmi sensownie. Problem w tym, że ktoś musiał
                zdecydować, od czego zacząć. Każda kolejna funkcja oznacza
                dodatkową pracę, kolejne decyzje i większy budżet.
              </p>
              <p>
                Pierwsze rozmowy potwierdziły, że pomysł jest dojrzały. Klient
                znał grę na wylot; brakowało sposobu, żeby inni mogli w nią
                zagrać. Wyzwaniem nie było wymyślenie gry, tylko przełożenie jej
                zasad na działającą aplikację.
              </p>
            </div>

            <h3 class="mt-8 max-w-[42rem] font-heading text-xl leading-snug font-semibold text-ink">
              Najpierw grywalna wersja, nie cała aplikacja.
            </h3>
            <p class="mt-3 max-w-[42rem] text-[16px] leading-[1.7] text-pretty text-ink-soft">
              Zaproponowałem sprawdzenie jednego pytania: czy sama gra jest na
              tyle ciekawa, żeby ludzie chcieli w nią grać. Zamiast budować
              wszystkie dodatki, zacznijmy od partii z komputerem w
              przeglądarce. Po co budować wszystko na początku, skoro nie
              sprawdziliśmy jeszcze najważniejszej rzeczy?
            </p>

            <div class="mt-8">
              <h3 class="font-heading text-lg leading-snug font-semibold text-ink">
                Co weszło do pierwszej wersji?
              </h3>
              <div class="mt-4">
                <ScopeComparison
                  embedded
                  included={inScope}
                  deferred={outOfScope}
                />
              </div>
            </div>

            <p class="mt-6 max-w-[42rem] text-sm leading-relaxed text-ink-soft">
              Elementy poza pierwszym etapem to możliwe kierunki rozwoju, nie
              zrealizowane funkcje.
            </p>
          </div>
        </div>
      </div>
    </section>

    <DesignChallenges
      label="02 · Zasady i projekt"
      title="Zasady trzeba było ustalić przed pierwszym ruchem."
      intro="Kiedy zaczęliśmy dokładniej omawiać grę, okazało się, że szczegółów jest więcej, niż wynikało to z opisu. Mój zespół przeanalizował materiały klienta i przygotował pytania o reguły, nietypowe sytuacje i obsługę. Potem wspólnie przechodziliśmy przez każdą kwestię. To nie są rzeczy, które warto zostawiać przypadkowi."
      items={designAreas}
      note="Analiza materiałów zajęła trochę czasu, ale pozwoliła uniknąć zgadywania w kodzie. Czasem trzeba było coś uprościć, czasem odłożyć dobry pomysł na później. Zespół pracował na ustaleniach, a nie domysłach."
    >
      <figure class="mt-8">
        <Image
          src={deskCurrent}
          alt="Numerabble na biurku — plansza naszkicowana na papierze i aktualny interfejs gry na laptopie"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 820px, calc(100vw - 2rem)"
          quality={84}
          loading="lazy"
          decoding="async"
          class="aspect-[16/9] w-full rounded-lg border border-line object-cover"
        />
        <figcaption class="mt-3 text-xs leading-relaxed text-ink-soft">
          Plansza na papierze i cyfrowy interfejs gry — tak dziś wygląda
          rozgrywka.
        </figcaption>
      </figure>
    </DesignChallenges>

    <ProjectTimeline
      label="03 · Harmonogram"
      title="Cztery tygodnie, cztery działające etapy."
      intro="Po ustaleniu zakresu rozpisaliśmy prace na cztery tygodnie. Harmonogram był ambitny, ale oparty na wyraźnie ograniczonym zakresie. Każdy tydzień kończył się czymś, co można było uruchomić."
      stages={timeline}
      note="Odbiory, testy i poprawki to kolejny etap. Cztery tygodnie dotyczą pierwszej wersji, nie całego okresu współpracy. Sam harmonogram nie gwarantuje, że każdy projekt zmieści się w takim czasie."
    />

    <ProblemSolution
      label="04 · Testy i poprawki"
      title="Pierwsza wersja to początek testów, nie koniec."
      intro="Dopiero działająca gra pozwoliła zamienić domysły na konkretne uwagi. Problemy, których nie widać w makiecie, pojawiły się w użyciu. Część uwag dotyczyła wygody, część logiki gry — oba typy wymagały innych poprawek. Zgłaszaliśmy uwagi, poprawialiśmy je i ponownie sprawdzaliśmy działanie gry."
      items={problems}
      note="Każda poprawka wracała do gry i była sprawdzana od nowa. Dopiero działający produkt pokazał, co naprawdę wymaga poprawy — dlatego zależało mi na uruchomieniu go wcześnie."
    />

    <ResearchQuestions
      label="05 · Reakcje i analityka"
      title="Pierwsze reakcje i pytania do danych."
      intro="Grywalną wersję pokazaliśmy znajomym i osobom zainteresowanym grami planszowymi. Pojawiły się komentarze, uwagi do obsługi i pierwsze pozytywne reakcje. Reakcje były różne — od pochwał po konkretne uwagi."
      questions={researchQuestions}
      note="To pytania, na które chcemy odpowiedzieć — nie potwierdzone wyniki. Części odpowiedzi jeszcze nie mamy. Same opinie to jednak nie wszystko: bez analityki zostają tylko wrażenia. Zamiast zgadywać, czy warto dodać rankingi, można najpierw zobaczyć, jak ludzie korzystają z obecnej wersji."
    >
      <div class="mt-8 max-w-[42rem] border-t border-line pt-6">
        <h3 class="font-heading text-lg leading-snug font-semibold text-ink">
          Propozycje dla strony produktu
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft">
          Przygotowałem analizę strony i kilka zmian do przetestowania: prostszy
          główny komunikat, spójne przyciski i sprawdzenie, czy odwiedzający
          zaczynają grę. Samo kliknięcie przycisku nie musi oznaczać, że ktoś
          zaczął korzystać z produktu. To rekomendacje, nie wdrożone zmiany.
        </p>
      </div>
    </ResearchQuestions>

    <ProductShowcase
      label="06 · Rezultat"
      title="Co powstało i co z tego wynika?"
      intro="Pierwsza wersja obejmuje działającą grę, rozgrywkę z komputerem, mechanizm zasad i punktacji, interfejs, stronę produktu oraz narzędzia analityczne. W praktyce to plansza z premiami, układanie działań, przeciwnik komputerowy, obsługa telefonu i komputera, strona produktu oraz wersja polska i angielska. To pierwsza wersja, nie pełna realizacja wizji."
      video="/showcase/numerabble-gameplay.webm"
      poster="/showcase/numerabble-gameplay.webp"
      ariaLabel="Fragment rozgrywki Numerabble — plansza, ułożone działanie i panel z żetonami"
      videoCaption="Fragment rzeczywistej rozgrywki — plansza, ułożone działanie i panel z żetonami."
      videoNote="Nagranie z pierwszego etapu · bez dźwięku."
    >
      <figure class="sm:col-span-6">
        <Image
          src={laptopImage}
          alt="Strona produktu Numerabble otwarta na laptopie"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 40vw, calc(100vw - 2rem)"
          quality={84}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-lg border border-line object-cover"
        />
        <figcaption class="mt-3 text-xs leading-relaxed text-ink-soft">
          Strona produktu z przejściem do rozgrywki.
        </figcaption>
      </figure>

      <figure class="sm:col-span-6">
        <Image
          src={phoneImage}
          alt="Numerabble na komputerze i telefonie — strona produktu oraz rozgrywka mobilna"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 40vw, calc(100vw - 2rem)"
          quality={84}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-lg border border-line object-cover"
        />
        <figcaption class="mt-3 text-xs leading-relaxed text-ink-soft">
          Ten sam produkt na komputerze i telefonie.
        </figcaption>
      </figure>
    </ProductShowcase>

    <ProjectOutcomes
      label="Wnioski"
      title="Trzy rzeczy, które ten projekt potwierdził."
      items={outcomes}
      note="Wszystkie nagrania i zrzuty na tej stronie pochodzą z rzeczywistego projektu, nie z makiety. Pomysł, o którym przez lata można było tylko opowiadać, stał się produktem, który można uruchomić i testować. To nie cała wizja i nie powód do ogłaszania sukcesu komercyjnego. Między pomysłem a aplikacją jest mnóstwo decyzji, których nie widać na pierwszy rzut oka. Nie budować wszystkiego naraz — stworzyć sensowną podstawę, sprawdzić ją i dopiero wtedy podejmować kolejne decyzje."
    />

    <FutureRoadmap
      label="07 · Rozwój"
      title="Co dalej z Numerabble?"
      columns={roadmap}
      note="Mamy istniejącą grę, doświadczenia z jej tworzenia i pierwsze informacje z testów. Dalsze decyzje zależą od obserwacji użytkowników — to kierunki, nie harmonogram wdrożenia. Kolejne funkcje nie są obietnicą, tylko listą tematów do rozważenia. Teraz można spokojnie zdecydować, co poprawić, co dodać i co zostawić na później."
    />

    <ProjectTestimonial
      quote={numerabbleTestimonial.quote}
      author={numerabbleTestimonial.author}
      context={numerabbleTestimonial.context}
      source={numerabbleTestimonial.source}
      url={numerabbleTestimonial.url}
    />

    <section
      id="kontakt"
      class="on-ink border-t border-line bg-ink px-4 py-12 text-paper sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-8">
            <p class="font-mono text-[10px] tracking-[0.2em] text-paper/65 uppercase">
              Twój projekt
            </p>
            <h2 class="mt-5 max-w-2xl font-heading text-[clamp(1.875rem,1.3rem+2vw,3rem)] leading-[1.08] font-semibold tracking-tight text-balance">
              A co Ty chciałbyś stworzyć?
            </h2>
            <p class="mt-4 max-w-[38rem] text-[17px] leading-[1.65] text-pretty text-paper/75 sm:text-lg">
              Opowiedz mi o swoim pomyśle. Wspólnie sprawdzimy, od czego warto
              zacząć i czy mogę pomóc Ci w realizacji.
            </p>

            <a
              href="/rozmowa/"
              data-consultation-link
              class={cn(
                buttonVariants({ size: "lg" }),
                "mt-6 h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-ink hover:bg-paper/85 sm:w-auto"
              )}
            >
              Umów bezpłatną rozmowę
              <ArrowRight aria-hidden="true" />
            </a>

            <p class="mt-4 text-sm leading-relaxed text-paper/60">
              20 minut · Online · Bezpłatnie · Bez zobowiązań
            </p>
            <p class="mt-2 text-sm leading-relaxed text-paper/60">
              Możemy podpisać NDA przed rozmową.
            </p>

            <div class="mt-6 flex flex-col gap-2 border-t border-paper/15 pt-5 text-sm">
              <a
                href="/oferta/"
                class="inline-flex min-h-11 items-center gap-2 text-paper/70 underline decoration-paper/25 underline-offset-4 transition-colors hover:text-paper hover:decoration-signal"
              >
                Poznaj zakres i cenę pakietu
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
              <a
                href="/checklista/"
                class="inline-flex min-h-11 items-center gap-2 text-paper/70 underline decoration-paper/25 underline-offset-4 transition-colors hover:text-paper hover:decoration-signal"
              >
                Pobierz checklistę z 12 pytaniami
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
              <a
                href="/realizacje/"
                class="inline-flex min-h-11 items-center gap-2 text-paper/70 underline decoration-paper/25 underline-offset-4 transition-colors hover:text-paper hover:decoration-signal"
              >
                Wróć do realizacji
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <CompactFooter />

  <script is:inline>
    ;(() => {
      window.dataLayer = window.dataLayer || []
      window.dataLayer.push({
        event: "case_study_view",
        project: "numerabble",
      })

      document.addEventListener("click", (event) => {
        const target = event.target
        if (!target || !target.closest) return

        if (target.closest("[data-testimonial-source]")) {
          window.dataLayer.push({
            event: "testimonial_source_click",
            project: "numerabble",
          })
        }

        if (target.closest("[data-consultation-link]")) {
          window.dataLayer.push({
            event: "case_study_consultation_click",
            project: "numerabble",
          })
        }
      })

      const video = document.querySelector("[data-case-video]")
      if (video) {
        video.addEventListener("play", () => {
          window.dataLayer.push({
            event: "project_video_play",
            project: "numerabble",
          })
        })
        video.addEventListener("pause", () => {
          window.dataLayer.push({
            event: "project_video_pause",
            project: "numerabble",
          })
        })
      }
    })()
  </script>
</Layout>
