---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import PortfolioHero from "@/components/portfolio/portfolio-hero.astro"
import FeaturedProject from "@/components/portfolio/featured-project.astro"
import ProjectNarrative from "@/components/portfolio/project-narrative.astro"
import ProductShowcase from "@/components/portfolio/product-showcase.astro"
import ProjectDeliverables from "@/components/portfolio/project-deliverables.astro"
import CaseStudyCTA from "@/components/portfolio/case-study-cta.astro"
import ProjectTestimonial from "@/components/portfolio/project-testimonial.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight } from "lucide-react"
import { Image } from "astro:assets"
import { numerabble } from "@/data/portfolio"
import beyondImage from "@/assets/images/portfolio-beyond.webp"
import { REALIZACJE_BASE_PATH, realizacjaPath } from "@/data/realizacje"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL(`${REALIZACJE_BASE_PATH}/`, siteURL).toString()
const caseStudyURL = new URL(
  realizacjaPath(numerabble.slug),
  siteURL
).toString()

const metaTitle = "Realizacje aplikacji internetowych | Karol Modelski"
const metaDescription =
  "Numerabble — od wieloletniego pomysłu na grę matematyczną do pierwszej działającej wersji w przeglądarce. Zobacz zakres, decyzje i rezultat."

const approach = [
  {
    title: "Zrozumienie pomysłu",
    description: "Najpierw ustalamy, co produkt ma robić i dla kogo.",
  },
  {
    title: "Świadomy zakres",
    description: "Budujemy to, co daje wartość teraz; resztę odkładamy.",
  },
  {
    title: "Pomoc w decyzjach",
    description: "Wyjaśniam opcje i konsekwencje, a decyzja należy do Ciebie.",
  },
]

const areas = [
  "Narzędzia dla firm",
  "Aplikacje użytkowe",
  "Platformy internetowe",
  "Nowe autorskie rozwiązania",
]

const jsonLd = [
  {
    "@type": "ItemList",
    "@id": `${pageURL}#realizacje`,
    name: "Realizacje",
    numberOfItems: 1,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: numerabble.name,
        url: caseStudyURL,
      },
    ],
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageURL}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: new URL("/", siteURL).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Realizacje",
        item: pageURL,
      },
    ],
  },
]
---

<Layout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="realizacje" />

  <main id="main">
    <PortfolioHero
      breadcrumb="Realizacje"
      eyebrow="Portfolio"
      title="Od pomysłu do działającej aplikacji."
      lead="Zobacz, jak podejmujemy decyzje, rozwiązujemy problemy i tworzymy produkty cyfrowe, z których można naprawdę korzystać."
      meta={["Jedna publiczna realizacja", numerabble.name]}
      image={numerabble.hero.src}
      imageAlt={numerabble.hero.alt}
      caption={numerabble.hero.caption}
    />

    <FeaturedProject
      label="01 · Wyróżniony projekt"
      name={numerabble.name}
      type={numerabble.type}
      summary={numerabble.summary}
      facts={numerabble.facts}
      href={numerabble.caseStudyHref}
      hrefLabel="Poznaj całe studium przypadku"
    />

    <ProjectNarrative
      label="02 · Historia projektu"
      title="Wyzwanie, decyzja, rezultat."
      items={numerabble.narrative}
    />

    {numerabble.media && (
      <ProductShowcase
        label="03 · Produkt"
        title="Zobacz produkt w działaniu."
        video={numerabble.media.video}
        poster={numerabble.media.poster}
        ariaLabel={numerabble.media.ariaLabel}
        caption={numerabble.media.caption}
        note={numerabble.media.note}
      />
    )}

    <ProjectDeliverables
      label="04 · Zakres"
      title="Co powstało w pierwszym etapie?"
      items={numerabble.deliverables}
    />

    <CaseStudyCTA
      title="Chcesz zobaczyć, jak wyglądała cała współpraca?"
      description="Decyzje, harmonogram, problemy techniczne, testy i wnioski — krok po kroku."
      href={numerabble.caseStudyHref}
      hrefLabel="Poznaj całe studium przypadku"
    />

    {numerabble.testimonial && (
      <ProjectTestimonial
        quote={numerabble.testimonial.excerpt}
        author={numerabble.testimonial.author}
        context={numerabble.testimonial.context}
        source={numerabble.testimonial.source}
        url={numerabble.testimonial.url}
      />
    )}

    <section
      id="podejscie"
      class="border-t border-line bg-paper px-4 py-12 sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              05 · Podejście
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Trzy zasady, które porządkują projekt.
            </h2>

            <ol class="mt-8 grid grid-cols-1 gap-8 border-t border-line pt-8 sm:grid-cols-3 sm:gap-10">
              {approach.map(({ title, description }, index) => (
                <li>
                  <span class="font-mono text-sm tracking-[0.16em] text-signal-ink tabular-nums">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3 class="mt-2 font-heading text-lg leading-snug font-semibold text-ink">
                    {title}
                  </h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-pretty text-ink-soft">
                    {description}
                  </p>
                </li>
              ))}
            </ol>

            <a
              href="/jak-pracuje/"
              class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
            >
              Zobacz, jak pracuję krok po kroku
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="obszary"
      class="border-t border-line bg-surface-muted px-4 py-12 sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              06 · Obszary
            </p>
          </div>

          <div class="lg:col-span-9">
            <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-start md:gap-10">
              <div class="md:col-span-7">
                <h2 class="font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
                  Nie tylko gry.
                </h2>
                <p class="mt-4 max-w-[36rem] text-[16px] leading-[1.7] text-ink-soft">
                  Współpraca nie ogranicza się do gier. Możliwe kierunki:
                </p>

                <ul class="mt-6 flex flex-wrap gap-2">
                  {areas.map((area) => (
                    <li class="rounded-full border border-line px-3 py-1.5 text-sm leading-snug text-ink-soft">
                      {area}
                    </li>
                  ))}
                </ul>

                <p class="mt-6 max-w-[40rem] text-sm leading-relaxed text-ink-soft">
                  To przykłady możliwych obszarów, nie zrealizowane projekty.
                  Nie każdy pomysł mieści się w standardowym pakiecie.
                </p>
              </div>

              <figure class="md:col-span-5">
                <Image
                  src={beyondImage}
                  alt="Geometryczne formy w kolorach marki na piaskowym tle — ilustracja koncepcyjna"
                  widths={[400, 600, 900]}
                  sizes="(min-width: 1024px) 320px, (min-width: 768px) 36vw, calc(100vw - 2rem)"
                  quality={84}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full rounded-lg border border-line object-cover"
                />
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="kontakt"
      class="on-ink border-t border-line bg-ink px-4 py-12 text-paper sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-8">
            <p class="font-mono text-[10px] tracking-[0.2em] text-paper/65 uppercase">
              07 · Rozmowa
            </p>
            <h2 class="mt-5 max-w-2xl font-heading text-[clamp(1.875rem,1.3rem+2vw,3rem)] leading-[1.08] font-semibold tracking-tight text-balance">
              A co Ty chciałbyś stworzyć?
            </h2>
            <p class="mt-4 max-w-[38rem] text-[17px] leading-[1.65] text-pretty text-paper/75 sm:text-lg">
              Opowiedz mi o swoim pomyśle. Wspólnie sprawdzimy, od czego warto
              zacząć i czy mogę pomóc Ci w realizacji.
            </p>

            <a
              href="/rozmowa/"
              data-consultation-link
              class={cn(
                buttonVariants({ size: "lg" }),
                "mt-6 h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-ink hover:bg-paper/85 sm:w-auto"
              )}
            >
              Porozmawiajmy o Twoim pomyśle
              <ArrowRight aria-hidden="true" />
            </a>

            <p class="mt-4 text-sm leading-relaxed text-paper/60">
              20 minut · Online · Bezpłatnie · Bez zobowiązań
            </p>
            <p class="mt-2 text-sm leading-relaxed text-paper/60">
              Możemy podpisać NDA przed rozmową.
            </p>

            <div class="mt-6 flex flex-col gap-2 border-t border-paper/15 pt-5 text-sm">
              <a
                href="/oferta/"
                class="inline-flex min-h-11 items-center gap-2 text-paper/70 underline decoration-paper/25 underline-offset-4 transition-colors hover:text-paper hover:decoration-signal"
              >
                Poznaj zakres i cenę pakietu
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
              <a
                href="/checklista/"
                class="inline-flex min-h-11 items-center gap-2 text-paper/70 underline decoration-paper/25 underline-offset-4 transition-colors hover:text-paper hover:decoration-signal"
              >
                Pobierz checklistę z 12 pytaniami
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <CompactFooter />

  <script is:inline>
    ;(() => {
      window.dataLayer = window.dataLayer || []
      window.dataLayer.push({
        event: "portfolio_view",
        projects: "1",
        featured: "numerabble",
      })

      document.addEventListener("click", (event) => {
        const target = event.target
        if (!target || !target.closest) return

        if (target.closest("[data-case-study-link]")) {
          window.dataLayer.push({
            event: "case_study_click",
            source: "realizacje",
            project: "numerabble",
          })
        }

        if (target.closest("[data-testimonial-source]")) {
          window.dataLayer.push({
            event: "testimonial_source_click",
            project: "numerabble",
          })
        }

        if (target.closest("[data-consultation-link]")) {
          window.dataLayer.push({
            event: "portfolio_consultation_click",
            source: "realizacje",
          })
        }
      })

      const video = document.querySelector("[data-showcase-video]")
      if (video) {
        video.addEventListener("play", () => {
          window.dataLayer.push({
            event: "project_video_play",
            project: "numerabble",
          })
        })
        video.addEventListener("pause", () => {
          window.dataLayer.push({
            event: "project_video_pause",
            project: "numerabble",
          })
        })
      }
    })()
  </script>
</Layout>
