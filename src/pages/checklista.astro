---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import DocumentPreview from "@/components/checklista/document-preview.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { Image } from "astro:assets"
import { ArrowRight, Download } from "lucide-react"
import { mailerLiteAccountId, mailerLiteFormId } from "@/data/mailing"
import page1 from "@/assets/images/checklista/page-1.webp"
import workbookMockup from "@/assets/images/checklista/d01-workbook.webp"
import page2 from "@/assets/images/checklista/page-2.webp"
import page3 from "@/assets/images/checklista/page-3.webp"
import page4 from "@/assets/images/checklista/page-4.webp"
import portrait from "@/assets/images/about/b02-approachable-expert.webp"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/checklista/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const pdfPath = "/checklista/12-pytan-przed-budowa-aplikacji.pdf"

const metaTitle =
  "Checklista przed budową aplikacji — 12 pytań | Karol Modelski"
const metaDescription =
  "12 pytań, które porządkują pomysł na aplikację: problem, zakres, budżet i dalszy rozwój. Pobierz PDF bez rejestracji i bez podawania e-maila."

const stages = [
  {
    title: "Zrozum swój pomysł",
    description: "Problem, odbiorcy i to, jak radzą sobie dziś.",
    range: "Pytania 01–03",
  },
  {
    title: "Wybierz pierwszy krok",
    description: "Najważniejsza funkcja i pierwszy scenariusz użycia.",
    range: "Pytania 04–06",
  },
  {
    title: "Zaplanuj rozsądnie",
    description: "Zakres, budżet i realny termin.",
    range: "Pytania 07–09",
  },
  {
    title: "Pomyśl o dalszym rozwoju",
    description: "Ryzyka, utrzymanie i decyzja o kolejnym etapie.",
    range: "Pytania 10–12",
  },
]

const pages = [
  {
    src: page1,
    title: "Zrozum swój pomysł",
    alt: "Strona 1 checklisty — etap „Zrozum swój pomysł” z pytaniami 1–3",
  },
  {
    src: page2,
    title: "Wybierz pierwszy krok",
    alt: "Strona 2 checklisty — etap „Wybierz pierwszy krok” z pytaniami 4–6 i przykładem Numerabble",
  },
  {
    src: page3,
    title: "Zaplanuj rozsądnie",
    alt: "Strona 3 checklisty — etap „Zaplanuj rozsądnie” z pytaniami 7–9",
  },
  {
    src: page4,
    title: "Pomyśl o dalszym rozwoju",
    alt: "Strona 4 checklisty — etap „Pomyśl o dalszym rozwoju” z pytaniami 10–12",
  },
]

const audiences = [
  {
    title: "Mam pomysł na aplikację.",
    description: "Chcesz uporządkować założenia przed pierwszą decyzją.",
  },
  {
    title: "Szukam wykonawcy.",
    description: "Chcesz porównywać oferty i zadawać konkretne pytania.",
  },
  {
    title: "Przygotowuję się do rozmowy.",
    description: "Chcesz przyjść z gotowymi odpowiedziami.",
  },
]

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Checklista",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" />

  <main id="main">
    <section
      id="pobierz"
      class="relative overflow-hidden bg-paper px-4 pt-6 pb-12 sm:px-6 sm:pt-8 sm:pb-16"
    >
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Checklista</li>
          </ol>
        </nav>

        <div class="mt-8 grid grid-cols-1 items-center gap-10 lg:mt-12 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-5">
            <p class="flex items-center gap-3 font-mono text-[11px] tracking-[0.18em] text-ink-soft uppercase">
              <span class="h-px w-6 bg-signal"></span>
              Bezpłatna checklista
            </p>

            <h1 class="mt-5 font-heading text-[clamp(2.125rem,1.5rem+2.2vw,4rem)] leading-[1.04] font-semibold tracking-tight text-balance">
              12 pytań, zanim zaczniesz budować aplikację.
            </h1>

            <p class="mt-5 max-w-[34rem] text-[17px] leading-[1.65] text-pretty text-ink sm:text-lg">
              Uporządkuj swój pomysł, wybierz najważniejsze funkcje i przygotuj
              się do pierwszych decyzji — bez znajomości technologii.
            </p>

            <p class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-ink-soft">
              <span>12 pytań</span>
              <span aria-hidden="true" class="text-line">
                ·
              </span>
              <span>4 strony</span>
              <span aria-hidden="true" class="text-line">
                ·
              </span>
              <span>Miejsce na odpowiedzi</span>
              <span aria-hidden="true" class="text-line">
                ·
              </span>
              <span>Bezpłatny PDF</span>
            </p>

            <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a
                href={pdfPath}
                download
                data-checklist-download
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base sm:w-auto"
                )}
              >
                <Download aria-hidden="true" />
                Pobierz bezpłatną checklistę
              </a>
              <a
                href={pdfPath}
                target="_blank"
                rel="noopener noreferrer"
                data-checklist-pdf-open
                class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                Otwórz PDF
              </a>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-ink-soft">
              PDF · Bez rejestracji · Bez podawania adresu e-mail
            </p>
          </div>

          <figure class="lg:col-span-7">
            <Image
              src={workbookMockup}
              alt="Wizualizacja pierwszej strony checklisty na biurku — tytuł, etap pierwszy i pytania 1–3"
              widths={[480, 720, 1080]}
              sizes="(min-width: 1024px) 576px, (min-width: 640px) 560px, calc(100vw - 2rem)"
              quality={84}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="mx-auto w-full max-w-[36rem] rounded-lg"
            />
            <figcaption class="mt-3 text-xs leading-relaxed text-ink-soft">
              Wizualizacja pierwszej strony dokumentu z miejscem na odpowiedzi.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section
      id="etapy"
      class="border-t border-line bg-surface-muted px-4 py-12 sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Etapy
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Cztery etapy, dwanaście pytań.
            </h2>
            <ol class="mt-8 border-t border-line">
              {stages.map(({ title, description, range }, index) => (
                <li class="grid grid-cols-[2.5rem_1fr] gap-x-5 gap-y-2 border-b border-line py-6 sm:grid-cols-[4rem_1fr_9rem] sm:items-baseline sm:gap-8">
                  <span
                    class="font-heading text-2xl leading-none font-semibold text-signal-ink tabular-nums sm:text-3xl"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3 class="font-heading text-lg leading-snug font-semibold text-ink sm:text-xl">
                      {title}
                    </h3>
                    <p class="mt-1 text-sm leading-relaxed text-pretty text-ink-soft">
                      {description}
                    </p>
                  </div>
                  <p class="col-start-2 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase sm:col-start-3 sm:text-right">
                    {range}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section
      id="podglad"
      class="border-t border-line bg-paper px-4 py-12 sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Podgląd
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Zobacz, co jest w środku.
            </h2>
            <p class="mt-4 max-w-[40rem] text-[16px] leading-[1.7] text-ink-soft">
              Cztery strony dokumentu.
            </p>

            <div class="mt-8">
              <DocumentPreview pages={pages} pdfHref={pdfPath} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="dla-kogo"
      class="border-t border-line bg-surface-muted px-4 py-12 sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              03 · Dla kogo
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
              Dla kogo jest ten materiał?
            </h2>

            <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-10">
              {audiences.map(({ title, description }) => (
                <div class="border-t border-line pt-5">
                  <h3 class="font-heading text-base leading-snug font-semibold text-ink sm:text-lg">
                    {title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft">
                    {description}
                  </p>
                </div>
              ))}
            </div>

            <p class="mt-8 text-sm leading-relaxed text-ink-soft">
              Nie musisz odpowiadać na wszystkie pytania — to też cenna
              informacja.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="ponownie"
      class="border-t border-line bg-paper px-4 py-8 sm:px-6 sm:py-10"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="flex flex-col gap-4 border-y border-line py-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
          <div>
            <p class="text-sm font-semibold text-ink">Pobierz ponownie</p>
            <p class="mt-1 text-sm text-ink-soft">
              PDF · 4 strony · bez rejestracji
            </p>
          </div>
          <a
            href={pdfPath}
            download
            data-checklist-download
            class="inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
          >
            <Download className="size-4" aria-hidden="true" />
            Pobierz PDF
          </a>
        </div>
      </div>
    </section>

    <section
      id="newsletter"
      class="border-t border-line bg-surface-muted px-4 py-12 sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              04 · Newsletter
            </p>
          </div>

          <div class="lg:col-span-9">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
              <div class="lg:col-span-6">
                <h2 class="font-heading text-[clamp(1.5rem,1.2rem+1.2vw,2rem)] leading-[1.15] font-semibold tracking-tight text-balance">
                  Więcej wiedzy. Mniej technicznego żargonu.
                </h2>
                <p class="mt-4 max-w-[34rem] text-[15px] leading-[1.7] text-ink-soft">
                  Poradniki o tworzeniu aplikacji i decyzjach technicznych.
                  Zapis dotyczy tylko newslettera — checklistę pobierasz od
                  razu, bez e-maila.
                </p>
                <p class="mt-3 text-xs leading-relaxed text-ink-soft">
                  Możesz zrezygnować w każdej chwili.{" "}
                  <a
                    href="/polityka-prywatnosci/"
                    class="underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                  >
                    Polityka prywatności
                  </a>
                </p>
              </div>

              <div class="lg:col-span-6">
                <div
                  class="ml-embedded min-h-[28rem] w-full max-w-[26rem] sm:min-h-[29rem]"
                  data-form={mailerLiteFormId}
                  data-account={mailerLiteAccountId}
                ></div>

                <p class="mt-4 text-xs leading-relaxed text-ink-soft">
                  Wolisz napisać?{" "}
                  <a
                    href="mailto:kontakt@karolmodelski.pl"
                    class="underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                  >
                    kontakt@karolmodelski.pl
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="rozmowa"
      class="on-ink border-t border-line bg-ink px-4 py-12 text-paper sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-8">
            <p class="font-mono text-[10px] tracking-[0.2em] text-paper/65 uppercase">
              05 · Rozmowa
            </p>
            <h2 class="mt-5 max-w-2xl font-heading text-[clamp(1.875rem,1.3rem+2vw,3rem)] leading-[1.08] font-semibold tracking-tight text-balance">
              Nie masz jeszcze wszystkich odpowiedzi?
            </h2>
            <p class="mt-4 max-w-[38rem] text-[17px] leading-[1.65] text-pretty text-paper/75 sm:text-lg">
              I nie musisz. Jeśli chcesz, możemy wspólnie przyjrzeć się Twojemu
              pomysłowi i zastanowić się, od czego warto zacząć.
            </p>

            <a
              href="/rozmowa/"
              data-checklist-consultation
              class={cn(
                buttonVariants({ size: "lg" }),
                "mt-6 h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-ink hover:bg-paper/85 sm:w-auto"
              )}
            >
              Umów bezpłatną rozmowę
              <ArrowRight aria-hidden="true" />
            </a>

            <p class="mt-4 text-sm leading-relaxed text-paper/60">
              20 minut · Online · Bezpłatnie · Bez zobowiązań
            </p>
            <p class="mt-2 text-sm leading-relaxed text-paper/60">
              Checklisty nie musisz wypełniać przed rozmową.
            </p>
          </div>

          <figure class="lg:col-span-4">
            <Image
              src={portrait}
              alt="Karol Modelski — partner technologiczny"
              widths={[240, 360, 480]}
              sizes="(min-width: 1024px) 300px, 70vw"
              quality={84}
              loading="lazy"
              decoding="async"
              class="mx-auto w-full max-w-[18rem] rounded-lg border border-paper/15 object-cover lg:ml-auto"
            />
          </figure>
        </div>
      </div>
    </section>
  </main>

  <CompactFooter />

  <style is:global>
    /* Nagłówek i opis formularza są konfigurowane w panelu MailerLite.
       Ukrywamy je, bo dublują nagłówek sekcji i zapowiadają checklistę
       e-mailem, podczas gdy PDF jest dostępny bezpośrednio. */
    .ml-embedded .ml-form-embedContent {
      display: none;
    }

    /* Po ukryciu nagłówka embedu jego górny padding (20 px) zostawiał
       formularz 20 px niżej niż nagłówek sekcji. Zerujemy tylko górę,
       żeby pola i zgody zachowały swoje marginesy. */
    .ml-embedded .ml-form-embedBody {
      padding-top: 0 !important;
    }
  </style>

  <script is:inline>
    ;(() => {
      window.dataLayer = window.dataLayer || []
      window.dataLayer.push({
        event: "checklist_page_view",
        checklist: "12-pytan-przed-budowa-aplikacji",
      })

      document.addEventListener("click", (event) => {
        const target = event.target
        const link = target && target.closest ? target.closest("a") : null
        if (!link) return

        if (link.hasAttribute("data-checklist-download")) {
          window.dataLayer.push({
            event: "checklist_download",
            checklist: "12-pytan-przed-budowa-aplikacji",
          })
        }

        if (link.hasAttribute("data-checklist-pdf-open")) {
          window.dataLayer.push({
            event: "checklist_pdf_open",
            checklist: "12-pytan-przed-budowa-aplikacji",
          })
        }

        if (link.hasAttribute("data-checklist-consultation")) {
          window.dataLayer.push({
            event: "checklist_consultation_click",
            checklist: "12-pytan-przed-budowa-aplikacji",
          })
        }
      })

      // Formularz MailerLite jest wstrzykiwany po wczytaniu universal.js,
      // dlatego nasłuchujemy na poziomie dokumentu.
      // MailerLite wczytujemy dopiero przy sekcji newslettera — formularz
      // dociąga własne zasoby (m.in. reCAPTCHA), więc nie obciążamy nimi
      // pierwszego renderu strony.
      const mailerMount = document.querySelector(".ml-embedded")
      const newsletterSection = document.getElementById("newsletter")
      let mailerStarted = false

      function initMailerLite() {
        if (mailerStarted || !mailerMount) return
        mailerStarted = true
        ;(function (w, d, e, u, f, l, n) {
          w[f] =
            w[f] ||
            function () {
              ;(w[f].q = w[f].q || []).push(arguments)
            }
          ;((l = d.createElement(e)), (l.async = 1), (l.src = u))
          ;((n = d.getElementsByTagName(e)[0]), n.parentNode.insertBefore(l, n))
        })(
          window,
          document,
          "script",
          "https://assets.mailerlite.com/js/universal.js",
          "ml"
        )
        window.ml("account", mailerMount.getAttribute("data-account"))
      }

      if (newsletterSection && mailerMount) {
        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                observer.disconnect()
                initMailerLite()
              }
            },
            { rootMargin: "600px 0px" }
          )
          observer.observe(newsletterSection)
        } else {
          initMailerLite()
        }
      }

      document.addEventListener("submit", (event) => {
        const form = event.target
        if (!form || !form.closest || !form.closest(".ml-embedded")) return

        window.dataLayer.push({
          event: "checklist_signup_submit",
          checklist: "12-pytan-przed-budowa-aplikacji",
        })
      })
    })()
  </script>
</Layout>
