---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight, Download } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/checklista/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const pdfPath = "/checklista/12-pytan-przed-budowa-aplikacji.pdf"
const previewPath = "/checklista/podglad-1-strona.png"

const metaTitle = "12 pytań przed budową aplikacji — bezpłatna checklista"
const metaDescription =
  "Bezpłatna checklista PDF z 12 pytaniami, które warto sobie zadać przed budową aplikacji. Uporządkuj pomysł, wybierz pierwszą wersję i przygotuj się do rozmowy."

const benefits = [
  {
    title: "Zrozumiesz swój pomysł",
    description:
      "Zastanowisz się, jaki problem ma rozwiązywać aplikacja, dla kogo ją tworzysz i jak przyszli użytkownicy radzą sobie dzisiaj.",
  },
  {
    title: "Wybierzesz najważniejszy pierwszy krok",
    description:
      "Spróbujesz określić, co musi działać w pierwszej wersji, a które funkcje mogą poczekać na później.",
  },
  {
    title: "Przygotujesz się do rozmowy o realizacji",
    description:
      "Przemyślisz budżet, termin, najważniejsze ryzyka i to, co warto sprawdzić przed dalszym inwestowaniem w produkt.",
  },
]

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Checklista",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-24">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Checklista</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-12">
          <div class="rise lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              Bezpłatna checklista
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl xl:text-6xl">
              12 pytań, zanim zaczniesz budować aplikację.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Masz pomysł, ale nie wiesz, od czego zacząć? Ta checklista pomoże
              Ci uporządkować najważniejsze kwestie, zanim zaczniesz szukać
              wykonawcy i inwestować pieniądze.
            </p>

            <p class="mt-6 max-w-xl border-l-2 border-signal pl-4 text-sm leading-relaxed text-pretty font-medium text-ink sm:text-base">
              4 strony · 12 pytań · Bez wiedzy technicznej
            </p>

            <div class="mt-8 flex flex-col items-start gap-4">
              <a
                href={pdfPath}
                download
                data-checklist-download
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                <Download className="size-5" aria-hidden="true" />
                Pobierz bezpłatną checklistę
              </a>
              <p class="text-sm leading-relaxed text-pretty text-ink-soft">
                PDF · 4 strony · Bez rejestracji i bez podawania e-maila
              </p>
            </div>
          </div>

          <figure
            class="rise mx-auto w-full max-w-[19rem] lg:col-span-5 lg:max-w-none"
            style="animation-delay:.12s"
          >
            <a
              href={pdfPath}
              download
              data-checklist-download
              class="block overflow-hidden rounded-2xl border border-line bg-paper shadow-[0_35px_80px_-55px_rgba(20,20,20,0.5)] transition-shadow hover:shadow-[0_35px_80px_-45px_rgba(20,20,20,0.35)]"
            >
              <img
                src={previewPath}
                alt="Pierwsza strona checklisty „12 pytań, zanim zaczniesz budować aplikację”"
                width="989"
                height="1400"
                loading="eager"
                decoding="async"
                class="block w-full"
              />
            </a>
            <figcaption class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft">
              Podgląd pierwszej strony. Dokument zawiera miejsce na własne
              odpowiedzi.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section
      id="co-porzadkuje"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              W środku
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Co pomoże Ci uporządkować ta checklista?
            </h2>

            <ol class="mt-10 grid grid-cols-1 gap-8 border-t border-line pt-8 md:grid-cols-3 md:gap-10">
              {benefits.map(({ title, description }, index) => (
                <li>
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                      Część {index + 1}
                    </span>
                    <span class="font-mono text-xs text-ink-soft">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <h3 class="mt-4 font-heading text-lg leading-snug font-semibold text-balance text-ink sm:text-xl md:min-h-[4.5rem]">
                    {title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                    {description}
                  </p>
                </li>
              ))}
            </ol>

            <p class="mt-8 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
              Pytania 1–6 dotyczą pomysłu i użytkowników, 7–9 pierwszej wersji,
              a 10–12 budżetu, ryzyka i dalszego rozwoju. Na drugiej stronie
              znajdziesz przykład z realizacji Numerabble.
            </p>

            <a
              href={pdfPath}
              download
              data-checklist-download
              class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Pobierz checklistę (PDF, 4 strony)
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="rozmowa"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              Następny krok
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Nie masz odpowiedzi na wszystkie pytania?
            </h2>

            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink">
              Nie musisz.
            </p>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Właśnie po to przygotowałem tę checklistę — żebyś mógł zobaczyć,
              co już wiesz o swoim pomyśle, a co warto jeszcze wyjaśnić.
            </p>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Jeśli chcesz, możemy omówić najważniejsze odpowiedzi podczas
              bezpłatnej, 20-minutowej rozmowy.
            </p>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Pomogę Ci zastanowić się, od czego warto zacząć i czy Twój projekt
              pasuje do mojego sposobu realizacji.
            </p>

            <div class="mt-8">
              <a
                href="/rozmowa/"
                data-checklist-consultation
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Umów bezpłatną rozmowę
                <ArrowRight />
              </a>
              <p class="mt-4 max-w-xl text-sm leading-relaxed text-pretty text-ink-soft italic">
                Możesz zabrać checklistę na spotkanie, ale nie musisz jej
                wypełniać ani wysyłać mi wcześniej.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script is:inline>
    ;(() => {
      window.dataLayer = window.dataLayer || []
      window.dataLayer.push({
        event: "checklist_page_view",
        checklist: "12-pytan-przed-budowa-aplikacji",
      })

      document.addEventListener("click", (event) => {
        const target = event.target
        const link = target && target.closest ? target.closest("a") : null
        if (!link) return

        if (link.hasAttribute("data-checklist-download")) {
          window.dataLayer.push({
            event: "checklist_download",
            checklist: "12-pytan-przed-budowa-aplikacji",
          })
        }

        if (link.hasAttribute("data-checklist-consultation")) {
          window.dataLayer.push({
            event: "checklist_consultation_click",
            checklist: "12-pytan-przed-budowa-aplikacji",
          })
        }
      })
    })()
  </script>
</Layout>
