      </div>
    </section>

    <section
      id="rozmowa"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="on-ink relative overflow-hidden rounded-2xl bg-ink px-6 py-10 text-paper sm:px-10 sm:py-12">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-32 -right-24 size-80 rounded-full bg-signal/20 blur-3xl"
          ></span>

          <div class="relative max-w-2xl">
            <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] text-paper/60 uppercase">
              <span class="h-px w-5 bg-signal" aria-hidden="true" />
              12 · Rozmowa
            </p>
            <h2 class="mt-4 font-heading text-2xl leading-tight font-semibold tracking-tight text-balance sm:text-3xl">
              Sprawdźmy, czy Twój pomysł możemy zrealizować
            </h2>

            <div class="mt-4 space-y-3 text-base leading-relaxed text-pretty text-paper/75 sm:text-lg">
              <p>
                Nie potrzebujesz gotowej dokumentacji ani szczegółowego planu
                technicznego.
              </p>
              <p>
                Wystarczy, że opowiesz mi własnymi słowami, co chcesz stworzyć.
              </p>
            </div>

            <p class="mt-6 font-mono text-[11px] tracking-[0.16em] text-paper/60 uppercase">
              Podczas 20-minutowej rozmowy
            </p>
            <ol class="mt-4 space-y-3">
              {conversationSteps.map((step, index) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-0.5 font-mono text-xs text-signal-bright"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="text-sm leading-relaxed text-pretty text-paper/80 sm:text-base">
                    {step}
                  </span>
                </li>
              ))}
            </ol>

            <p class="mt-6 text-sm leading-relaxed text-pretty text-paper/70 sm:text-base">
              Jeżeli uznam, że potrzebna będzie większa analiza albo inny
              zakres, powiem Ci o tym wprost.
            </p>

            <div class="mt-8">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85 sm:w-auto sm:py-0 sm:whitespace-nowrap"
                )}
              >
                Umów bezpłatną rozmowę o swoim pomyśle
                <ArrowRight />
              </a>

              <p class="mt-4 text-sm leading-relaxed text-paper/55">
                20 minut · Bez zobowiązań · Bez technicznego żargonu
              </p>
            </div>

            <p class="mt-6 border-t border-paper/15 pt-5 text-sm leading-relaxed text-pretty text-paper/60">
              Wolisz najpierw zabezpieczyć szczegóły pomysłu? Napisz do mnie —
              możemy podpisać NDA jeszcze przed rozmową.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script is:inline>
    ;(() => {
      const clips = Array.prototype.slice.call(
        document.querySelectorAll("main video[data-clip]")
      )
      if (!clips.length) return

      const btn = document.querySelector("[data-clip-toggle]")
      const label = btn ? btn.querySelector("[data-clip-label]") : null
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
      let enabled = !reduce.matches

      const render = () => {
        if (!btn) return
        btn.dataset.state = enabled ? "playing" : "paused"
        if (label) {
          label.textContent = enabled
            ? "Wstrzymaj nagranie"
            : "Odtwórz nagranie"
        }
      }

      const sync = () => {
        clips.forEach((clip) => {
          const shouldPlay =
            enabled && clip.dataset.inView === "true" && !document.hidden
          if (shouldPlay) {
            if (clip.paused) {
              const p = clip.play()
              if (p && p.catch) p.catch(() => {})
            }
          } else if (!clip.paused) {
            clip.pause()
          }
        })
      }

      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.dataset.inView = entry.isIntersecting
                ? "true"
                : "false"
            })
            sync()
          },
          { threshold: 0.35 }
        )
        clips.forEach((clip) => io.observe(clip))
      } else {
        clips.forEach((clip) => {
          clip.dataset.inView = "true"
        })
      }

      document.addEventListener("visibilitychange", sync)

      if (btn) {
        btn.addEventListener("click", () => {
          enabled = !enabled
          render()
          sync()
        })
      }

      if (reduce.addEventListener) {
        reduce.addEventListener("change", (event) => {
          enabled = !event.matches
          render()
          sync()
        })
      }

      render()
      sync()
    })()
  </script>
</Layout>
