---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import SectionHeading from "@/components/section-heading.astro"
import ProjectTimeline from "@/components/project-timeline.astro"
import ClientQuote from "@/components/client-quote.astro"
import { numerabbleTestimonial } from "@/data/testimonials"
import { Image } from "astro:assets"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import {
  ofertaAfterLaunch,
  ofertaAnalysis,
  ofertaExclusions,
  ofertaFaq,
  ofertaFaqGroups,
  ofertaFitComplex,
  ofertaFitGood,
  ofertaFitNote,
  ofertaPackage,
  ofertaPackageGroups,
  ofertaPayments,
  ofertaSecurity,
} from "@/data/oferta"
import {
  ArrowRight,
  Check,
  ChevronDown,
  Minus,
  Pause,
  Play,
} from "lucide-react"
import resultPhoto from "@/assets/images/oferta-o01.webp"
import planningPhoto from "@/assets/images/oferta-planning.webp"
import portrait from "@/assets/images/karol-modelski-portrait.webp"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/oferta/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle =
  "Stworzenie pierwszej wersji aplikacji za 29 500 zł | Karol Modelski"
const metaDescription =
  "Masz pomysł na aplikację? Pierwsza działająca wersja w 4 tygodnie. Poznaj zakres pakietu za 29 500 zł brutto, harmonogram, płatności i zasady współpracy."

const consultationUrl = "/rozmowa/"

const navItems = [
  { href: "#pakiet", label: "Zakres" },
  { href: "#w-praktyce", label: "Realizacja" },
  { href: "#jak-pracujemy", label: "Proces" },
  { href: "#platnosci", label: "Płatności" },
  { href: "#ograniczenia", label: "Ograniczenia" },
  { href: "#faq", label: "FAQ" },
]

const packageGroups = ofertaPackageGroups.map((group) => ({
  ...group,
  items: ofertaPackage
    .map((item, index) => ({ ...item, index }))
    .filter((item) => item.group === group.id),
}))

const faqGroups = ofertaFaqGroups.map((group) => ({
  ...group,
  items: ofertaFaq.filter((item) => item.group === group.id),
}))

const priceFacts = [
  { label: "Pierwsza działająca wersja", value: "4 tygodnie" },
  { label: "Zwykle cały proces z odbiorem", value: "6–8 tygodni" },
  { label: "Płatności", value: "40% / 40% / 20%" },
  {
    label: "Gwarancja techniczna",
    value: "3 miesiące na warunkach umowy",
  },
]

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageURL}#faq`,
  mainEntity: ofertaFaq.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: answer,
    },
  })),
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Oferta",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[faqSchema, breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="oferta" />

  <main id="main" class="oferta-main">
    <section class="relative overflow-hidden bg-paper">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-50"
      ></div>

      <div class="shell pt-8 pb-14 sm:pt-10 lg:pt-16 lg:pb-16">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Oferta</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-8">
          <div class="lg:col-span-7 lg:col-start-1 lg:row-start-1">
            <p class="flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal" aria-hidden="true" />
              Oferta · Pierwsza wersja aplikacji
            </p>

            <h1 class="mt-6 font-heading text-[clamp(2.5rem,1.2rem+3.2vw,3.75rem)] leading-[1.03] font-semibold tracking-tight text-balance">
              Twój pomysł. Działająca aplikacja.
            </h1>

            <p class="lede mt-6">
              Wybierzemy najważniejszą funkcję, dopracuję zasady działania i
              poprowadzę realizację. Bez samodzielnego organizowania zespołu. Ty
              decydujesz o produkcie.
            </p>
          </div>

          <aside class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-start">
            <div class="rounded-xl border border-line bg-surface-muted p-6 sm:p-8">
              <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                Pakiet pierwszej wersji
              </p>
              <p class="mt-3 font-heading text-[clamp(2.5rem,1.8rem+2.4vw,3.5rem)] leading-none font-semibold tracking-tight text-signal-ink">
                29 500 zł
                <span class="ml-3 text-base font-medium tracking-normal text-ink-soft">
                  brutto
                </span>
              </p>
              <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft">
                Stała cena za uzgodniony zakres.
              </p>

              <dl class="mt-6 border-t border-line">
                {priceFacts.map(({ label, value }) => (
                  <div class="flex flex-col gap-1 border-b border-line py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                    <dt class="text-sm leading-snug text-ink-soft">{label}</dt>
                    <dd class="font-heading text-sm font-semibold text-ink sm:text-right">
                      {value}
                    </dd>
                  </div>
                ))}
              </dl>

              <p class="mt-4 text-xs leading-relaxed text-pretty text-ink-soft">
                Zakres, cenę i terminy zapisujemy w umowie przed startem prac.
              </p>
            </div>
          </aside>

          <div class="lg:col-span-7 lg:col-start-1 lg:row-start-2">
            <a
              href={consultationUrl}
              class={cn(
                buttonVariants({ size: "lg" }),
                "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
              )}
            >
              Umów bezpłatną rozmowę
              <ArrowRight />
            </a>
            <p class="mt-4 text-sm leading-relaxed text-pretty text-ink-soft">
              20 minut · Bez zobowiązań · Możliwość podpisania NDA przed
              rozmową.
            </p>
          </div>
        </div>
      </div>
    </section>

    <nav
      aria-label="Spis treści oferty"
      class="border-y border-line bg-paper/95 lg:sticky lg:top-16 lg:z-30 lg:backdrop-blur"
    >
      <div class="shell">
        <ul class="flex gap-x-6 overflow-x-auto py-3 text-sm text-ink-soft [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {navItems.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="inline-flex min-h-8 items-center whitespace-nowrap transition-colors hover:text-ink"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <section id="pakiet" class="section-y border-t border-line bg-paper">
      <div class="shell">
        <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <SectionHeading
              eyebrow="01 · Zakres"
              title="Co dokładnie otrzymujesz za 29 500 zł?"
              lead="Cztery obszary, dziesięć elementów i jeden rezultat: pierwsza wersja, którą uruchomisz i pokażesz użytkownikom."
              class="max-w-3xl"
            />
          </div>

          <figure class="mx-auto w-full max-w-sm lg:col-span-4 lg:col-start-9 lg:max-w-none">
            <Image
              src={resultPhoto}
              alt="Numerabble — rezultat pierwszej wersji uruchomiony na laptopie"
              widths={[480, 640, 800, 1086]}
              sizes="360px"
              quality={82}
              loading="lazy"
              decoding="async"
              class="aspect-[3/2] w-full rounded-xl border border-line object-cover"
            />
          </figure>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-2 lg:mt-16">
          {packageGroups.map((group) => (
            <div class="border-t border-line pt-5">
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-xs tracking-[0.16em] text-signal-ink">
                  {group.letter}
                </span>
                <h3 class="font-heading text-xl leading-snug font-semibold text-balance">
                  {group.title}
                </h3>
              </div>
              <p class="copy mt-2 text-sm">{group.description}</p>

              <div class="mt-4">
                {group.items.map((item) => (
                  <details class="group border-t border-line py-4">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-4 [&::-webkit-details-marker]:hidden">
                      <span class="flex items-baseline gap-3">
                        <span class="font-mono text-[11px] text-ink-soft">
                          {String(item.index + 1).padStart(2, "0")}
                        </span>
                        <span>
                          <span class="block font-heading text-base leading-snug font-semibold text-balance text-ink">
                            {item.title}
                          </span>
                          <span class="mt-1 block text-sm leading-relaxed text-pretty text-ink-soft">
                            {item.summary}
                          </span>
                        </span>
                      </span>
                      <ChevronDown
                        className="details-chevron mt-0.5 size-4 shrink-0 text-ink-soft"
                        aria-hidden="true"
                      />
                    </summary>
                    <div class="mt-3 space-y-3 pl-7 text-sm leading-relaxed text-pretty text-ink-soft">
                      {item.description.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                      <p class="text-ink">
                        <span class="font-mono text-[11px] tracking-[0.14em] text-signal-ink uppercase">
                          Efekt:
                        </span>{" "}
                        {item.effect}
                      </p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 border-t border-line pt-6 md:grid-cols-2 md:gap-12">
          <p id="mniejsza-wersja" class="copy scroll-mt-28 text-sm">
            Nowe pomysły w trakcie prac zapisujemy na kolejny etap. Nie
            rozszerzają automatycznie ustalonego zakresu ani ceny.
          </p>
          <p class="text-sm">
            <a
              href={consultationUrl}
              class="inline-flex min-h-11 items-center gap-2 font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Sprawdźmy, czy Twój pomysł pasuje do pakietu
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </p>
        </div>
      </div>
    </section>

    <section
      id="w-praktyce"
      class="section-y border-t border-line bg-surface-muted"
    >
      <div class="shell">
        <SectionHeading
          eyebrow="02 · Realizacja"
          title="Numerabble: od pomysłu do działającej gry."
          lead="Pomysł rozwijany przez prawie 30 lat. Po czterech tygodniach — działająca gra w przeglądarce."
          class="max-w-4xl"
        />

        <p class="copy mt-6 max-w-2xl">
          Samo ograniczenie funkcji nie wystarczyło — dopracowaliśmy zasady,
          nietypowe sytuacje i sposób działania aplikacji.
        </p>

        <div class="mt-10 grid grid-cols-1 gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-16">
          <div class="order-2 lg:order-1 lg:col-span-5">
            <dl class="border-t border-line">
              <div class="border-b border-line py-4">
                <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                  Pierwotna wizja
                </dt>
                <dd class="mt-1 text-sm leading-relaxed text-pretty text-ink">
                  Gra matematyczna z rozbudowanymi zasadami, turniejami,
                  rankingami i rozgrywkami online.
                </dd>
              </div>
              <div class="border-b border-line py-4">
                <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                  Wybrana funkcja
                </dt>
                <dd class="mt-1 text-sm leading-relaxed text-pretty text-ink">
                  Rozgrywka z komputerem w przeglądarce, bez budowania
                  wszystkiego naraz.
                </dd>
              </div>
              <div class="border-b border-line py-4">
                <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                  Rezultat po 4 tygodniach
                </dt>
                <dd class="mt-1 text-sm leading-relaxed text-pretty text-ink">
                  Grywalna pierwsza wersja, strona produktu i podstawowa
                  analityka.
                </dd>
              </div>
            </dl>

            <ClientQuote
              testimonial={numerabbleTestimonial}
              excerpt
              class="mt-8 bg-paper"
            />

            <a
              href="/realizacje/numerabble/"
              class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Pełne studium realizacji Numerabble
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>

          <figure class="order-1 lg:order-2 lg:col-span-7">
            <div class="overflow-hidden rounded-xl border border-line bg-[#0f0d0b]">
              <div
                class="flex items-center gap-2 border-b border-white/10 bg-[#0f0d0b] px-4 py-2.5"
                aria-hidden="true"
              >
                <span class="size-2 rounded-full bg-signal/80"></span>
                <span class="size-2 rounded-full bg-white/15"></span>
                <span class="size-2 rounded-full bg-white/15"></span>
                <p class="ml-2 truncate font-mono text-[10px] tracking-[0.14em] text-white/50 uppercase">
                  Numerabble · rozgrywka
                </p>
              </div>
              <video
                data-clip
                class="block aspect-[4/3] w-full object-cover"
                src="/showcase/numerabble-gameplay.webm"
                poster="/showcase/numerabble-gameplay.webp"
                width="960"
                height="720"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Prawdziwa rozgrywka w Numerabble — plansza, ułożone działanie i panel z żetonami"
              ></video>
            </div>
            <figcaption class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm leading-relaxed text-pretty text-ink-soft">
                Prawdziwa rozgrywka. Nagranie z rzeczywistego projektu, nie
                makieta.
              </p>
              <button
                type="button"
                data-clip-toggle
                data-state="playing"
                class="inline-flex shrink-0 items-center gap-2 self-start rounded-md border border-line px-3 py-1.5 font-mono text-[11px] tracking-[0.14em] text-ink-soft uppercase transition-colors hover:border-ink/25 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
              >
                <Pause
                  data-clip-icon-pause
                  className="size-3.5"
                  aria-hidden="true"
                />
                <Play
                  data-clip-icon-play
                  className="size-3.5"
                  aria-hidden="true"
                />
                <span data-clip-label>Wstrzymaj nagranie</span>
              </button>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <div id="punkty-kontrolne" class="scroll-mt-28">
      <ProjectTimeline
        id="jak-pracujemy"
        eyebrow="03 · Proces i punkty kontrolne"
        title="Cztery tygodnie, trzy punkty kontrolne."
        lead="Zaczynamy od zakresu, nie od kodowania. Widzisz postępy na bieżąco."
      >
        <div class="mt-10 grid grid-cols-1 gap-6 border-t border-line pt-8 md:grid-cols-3 md:gap-10">
          <div>
            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
              Start prac
            </p>
            <p class="copy mt-2 text-sm">
              Czas liczy się od ustalenia zakresu, podpisania umowy, wpłaty
              pierwszej części i skompletowania materiałów oraz dostępów.
            </p>
          </div>
          <div>
            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
              Odbiór
            </p>
            <p class="copy mt-2 text-sm">
              Masz 10 dni roboczych na sprawdzenie produktu i zgłoszenie
              niezgodności w uzgodnionym zakresie.
            </p>
          </div>
          <div>
            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
              Twoje zaangażowanie
            </p>
            <p class="copy mt-2 text-sm">
              Zwykle 4–6 godzin na początku i około godziny tygodniowo. Przy
              bardziej złożonych projektach może być większe.
            </p>
          </div>
        </div>
        <p class="mt-6 text-sm leading-relaxed text-pretty text-ink-soft">
          Między punktami kontrolnymi pracuję dalej — uwagi możesz zgłaszać na
          bieżąco.
        </p>
      </ProjectTimeline>
    </div>

    <section
      id="platnosci"
      class="section-y border-t border-line bg-surface-muted"
    >
      <div class="shell">
        <SectionHeading
          eyebrow="04 · Płatności"
          title="Trzy transze. Każda po widocznym efekcie."
          lead="29 500 zł brutto dzielimy na 40% / 40% / 20%."
          class="max-w-3xl"
        />

        <div
          class="mt-8 flex h-2 w-full overflow-hidden rounded-full"
          aria-hidden="true"
        >
          <span class="h-full w-[40%] bg-signal"></span>
          <span class="h-full w-[40%] bg-signal/60"></span>
          <span class="h-full w-[20%] bg-signal/30"></span>
        </div>

        <ol class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-10">
          {ofertaPayments.map(({ share, amount, title, description }) => (
            <li class="border-t border-line pt-5">
              <p class="flex items-baseline justify-between gap-4">
                <span class="font-mono text-xs tracking-[0.16em] text-signal-ink">
                  {share}
                </span>
                <span class="font-heading text-lg font-semibold text-ink">
                  {amount}
                </span>
              </p>
              <h3 class="mt-3 font-heading text-base leading-snug font-semibold text-balance">
                {title}
              </h3>
              <p class="copy mt-2 text-sm">{description}</p>
            </li>
          ))}
        </ol>

        <div class="mt-8 max-w-2xl space-y-2 border-t border-line pt-6 text-sm leading-relaxed text-pretty text-ink-soft">
          <p>Faktura VAT na każdym etapie.</p>
          <p>
            Dodatkowe funkcje nie są automatycznie objęte ceną. Nowy zakres,
            budżet i termin ustalamy osobno.
          </p>
          <p>
            Kod źródłowy, dostępy i prawa przekazuję po zakończeniu i
            rozliczeniu, w zakresie określonym w umowie.
          </p>
        </div>
      </div>
    </section>

    <section
      id="bezpieczenstwo"
      class="section-y border-t border-line bg-paper"
    >
      <div class="shell">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <SectionHeading
              eyebrow="05 · Bezpieczeństwo"
              title="Jasne zasady od pierwszego dnia."
              lead="Powierzenie komuś pomysłu i pieniędzy to ważna decyzja. Najważniejsze warunki ustalamy przed startem."
            />
          </div>

          <div class="lg:col-span-7 lg:col-start-6">
            <ol class="grid grid-cols-1 gap-x-10 md:grid-cols-2">
              {ofertaSecurity.map(({ title, description }, index) => (
                <li class="border-t border-line py-5">
                  <span class="font-mono text-xs tracking-[0.16em] text-signal-ink">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3 class="mt-2 font-heading text-lg leading-snug font-semibold text-balance">
                    {title}
                  </h3>
                  <p class="copy mt-2 text-sm">{description}</p>
                </li>
              ))}
            </ol>
            <p class="mt-6 max-w-2xl text-sm leading-relaxed text-pretty text-ink-soft">
              Chcę, żebyś wiedział, co dzieje się z projektem i jakie masz
              możliwości na każdym etapie.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="ograniczenia"
      class="section-y border-t border-line bg-surface-muted"
    >
      <div class="shell">
        <SectionHeading
          eyebrow="06 · Dopasowanie"
          title="Czy Twój projekt pasuje do pakietu?"
          lead="Sprawdzamy to na rozmowie — bez obietnic z góry."
          class="max-w-3xl"
        />

        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12">
          <div class="border-t border-line pt-5">
            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
              Może pasować
            </p>
            <h3 class="mt-2 font-heading text-xl leading-snug font-semibold text-balance">
              Gdy projekt spełnia te warunki
            </h3>
            <ul class="mt-4 space-y-3">
              {ofertaFitGood.map((item) => (
