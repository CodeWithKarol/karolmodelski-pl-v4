---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import {
  ofertaAfterLaunch,
  ofertaComparison,
  ofertaFaq,
  ofertaOutcomes,
  ofertaPackage,
  ofertaPayments,
  ofertaProcess,
  ofertaSecurity,
} from "@/data/oferta"
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"
import { ArrowRight, Check, ChevronDown, Pause, Play } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/oferta/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle =
  "Stworzenie pierwszej wersji aplikacji za 29 500 zł | Karol Modelski"
const metaDescription =
  "Masz pomysł na aplikację? Pierwsza działająca wersja w 4 tygodnie. Poznaj zakres pakietu za 29 500 zł brutto, harmonogram, płatności i zasady współpracy."

const consultationUrl = "/rozmowa/"

const priceFacts = [
  { label: "Pierwsza wersja", value: "4 tygodnie" },
  { label: "Cały proces z odbiorem i poprawkami", value: "zwykle 6–8 tygodni" },
  { label: "Płatności", value: "40% / 40% / 20%" },
  { label: "Gwarancja techniczna", value: "3 miesiące" },
]

const conversationSteps = [
  "Poznam Twój pomysł i to, komu aplikacja ma służyć.",
  "Porozmawiamy o najważniejszej funkcji i możliwym pierwszym etapie.",
  "Sprawdzimy, czy projekt pasuje do pakietu za 29 500 zł brutto i terminu czterech tygodni prac nad pierwszą wersją.",
]

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageURL}#faq`,
  mainEntity: ofertaFaq.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: answer,
    },
  })),
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Oferta",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[faqSchema, breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="oferta" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-24">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Oferta</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-12">
          <div class="rise lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              Oferta · Pierwsza wersja aplikacji
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl xl:text-6xl">
              Masz pomysł na aplikację? Pomogę Ci zamienić go w działający
              produkt.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Nie musisz znać się na programowaniu ani szukać specjalistów.
              Pomogę Ci wybrać najważniejsze funkcje, dopracować pomysł i zajmę
              się całą realizacją.
            </p>

            <p class="mt-8 max-w-xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              Pierwsza działająca wersja w 4 tygodnie prac.
            </p>
            <p class="mt-1 max-w-xl text-base leading-relaxed text-pretty text-ink sm:text-lg">
              <strong class="font-semibold text-signal-ink">
                29 500 zł brutto
              </strong>{" "}
              za uzgodniony zakres.
            </p>

            <div class="mt-8 flex flex-col items-start gap-4">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Sprawdźmy, czy Twój pomysł pasuje do tego pakietu
                <ArrowRight />
              </a>
              <p class="text-sm leading-relaxed text-pretty text-ink-soft">
                Bezpłatna rozmowa · 20 minut · Bez zobowiązań
              </p>
              <p class="max-w-md border-t border-line pt-4 text-sm leading-relaxed text-pretty text-ink-soft">
                Możliwość podpisania NDA przed rozmową.
              </p>
            </div>
          </div>

          <aside class="rise lg:col-span-5" style="animation-delay:.12s">
            <div class="rounded-2xl border border-line bg-surface-muted p-6 sm:p-8 lg:sticky lg:top-24">
              <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                Pakiet pierwszej wersji
              </p>
              <p class="mt-3 font-heading text-4xl leading-none font-semibold text-signal-ink">
                29 500 zł{" "}
                <span class="text-base font-medium tracking-normal text-ink-soft">
                  brutto
                </span>
              </p>
              <p class="mt-2 text-sm leading-relaxed text-pretty text-ink-soft">
                Stała cena za wcześniej uzgodniony zakres.
              </p>

              <dl class="mt-6 border-t border-line">
                {priceFacts.map(({ label, value }) => (
                  <div class="flex items-baseline justify-between gap-4 border-b border-line py-3">
                    <dt class="text-sm leading-snug text-ink-soft">{label}</dt>
                    <dd class="text-right font-heading text-sm font-semibold text-ink">
                      {value}
                    </dd>
                  </div>
                ))}
              </dl>

              <a
                href="#pakiet"
                class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                Zobacz, co zawiera pakiet
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section
      id="mniejsza-wersja"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              01 · Dlaczego mniejsza wersja
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Dlaczego warto zacząć od mniejszej wersji?
            </h2>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Co zrobić najpierw? Ile to powinno kosztować? Jak sprawdzić, czy
              wszystkie funkcje są naprawdę potrzebne? I skąd wiedzieć, że efekt
              będzie zgodny z Twoją wizją?
            </p>
            <p class="mt-4 max-w-2xl font-heading text-xl leading-snug text-balance text-ink sm:text-2xl">
              Nie wszystko, co można zbudować, trzeba robić od razu.
            </p>

            <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Kiedy zaczynam rozmawiać z klientem o jego pomyśle, często okazuje
              się, że lista możliwości jest naprawdę długa.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Konta użytkowników, powiadomienia, płatności, rankingi,
              statystyki, kolejne wersje aplikacji...
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              I jasne, wiele z tych rzeczy może mieć sens. Tylko każda dodatkowa
              funkcja to więcej pracy, większy koszt i dłuższy czas realizacji.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Dlatego na początku proponuję coś prostszego.
            </p>

            <div class="relative mt-10 border-t border-line pt-8">
              <span
                class="absolute -top-px left-0 h-px w-20 bg-signal"
                aria-hidden="true"
              />
              <p class="max-w-3xl font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Najpierw ustalmy, co jest najważniejsze. Co musi działać, żebyś
                mógł pokazać swój pomysł innym i sprawdzić go w praktyce?
              </p>
              <p class="mt-3 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
                Od tego zaczniemy.
              </p>
            </div>

            <p class="mt-8 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Pozostałych pomysłów nie wyrzucamy. Zapisujemy je i wracamy do
              nich wtedy, kiedy mamy już działający produkt i więcej informacji.
            </p>

            <p class="mt-8 max-w-2xl border-l-2 border-signal pl-5 text-base leading-relaxed text-pretty text-ink sm:text-lg">
              Nie chodzi o to, żeby zrezygnować z Twojej wizji. Chodzi o to,
              żeby nie wydawać od razu całego budżetu na rzeczy, których jeszcze
              nie potrzebujesz.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="pakiet"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              02 · Pakiet
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Co dokładnie otrzymujesz za 29 500 zł?
            </h2>
            <p class="mt-4 max-w-2xl font-heading text-xl leading-snug text-balance text-ink sm:text-2xl">
              Pierwsza działająca wersja aplikacji, ale nie tylko.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Pomogę Ci uporządkować pomysł, dopracować najważniejsze założenia
              i przeprowadzę Cię przez realizację.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Nie musisz samodzielnie organizować programistów ani wiedzieć, jak
              rozwiązać wszystkie problemy techniczne.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              29 500 zł brutto — stała cena za wcześniej uzgodniony zakres.
            </p>

            <div class="mt-10 rounded-2xl border border-line bg-surface-muted p-6 sm:p-8">
              <div class="flex flex-col gap-3 border-b border-line pb-6 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
                <div>
                  <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                    W ramach pakietu
                  </p>
                  <p class="mt-2 font-heading text-2xl font-semibold text-balance text-ink sm:text-3xl">
                    10 elementów jednej realizacji
                  </p>
                </div>
                <p class="font-mono text-[11px] tracking-[0.14em] text-ink-soft uppercase">
                  29 500 zł brutto
                </p>
              </div>

              <ol class="mt-6">
                {ofertaPackage.map(({ title, description, effect }, index) => (
                  <li class="border-t border-line">
                    <details class="group py-4" open={index === 0}>
                      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 [&::-webkit-details-marker]:hidden">
                        <span class="flex items-baseline gap-3">
                          <span class="font-mono text-xs tracking-[0.16em] text-signal-ink">
                            {String(index + 1).padStart(2, "0")}
                          </span>
                          <span class="font-heading text-base leading-snug font-semibold text-balance text-ink sm:text-lg">
                            {title}
                          </span>
                        </span>
                        <ChevronDown
                          className="details-chevron mt-0.5 size-4 shrink-0 text-ink-soft"
                          aria-hidden="true"
                        />
                      </summary>
                      <div class="mt-2 space-y-3 pl-8 text-sm leading-relaxed text-pretty text-ink-soft">
                        {description.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                        <p class="text-ink">
                          <span class="font-mono text-[11px] tracking-[0.14em] text-signal-ink uppercase">
                            Efekt:
                          </span>{" "}
                          {effect}
                        </p>
                      </div>
                    </details>
                  </li>
                ))}
              </ol>

              <a
                href="/o-mnie/"
                class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
              >
                Poznaj osobę, która poprowadzi Twój projekt
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>

              <div class="mt-6 flex flex-col gap-2 border-t border-line pt-6 text-sm leading-relaxed text-pretty text-ink-soft">
                <p>
                  Zakres i cena są ustalane przed rozpoczęciem prac.{" "}
                  <a
                    href="#platnosci"
                    class="font-medium text-ink underline underline-offset-4 hover:no-underline"
                  >
                    Zobacz, jak wyglądają płatności
                  </a>
                  .
                </p>
                <p>
                  Nie każda aplikacja kwalifikuje się do tego pakietu.
                  Sprawdzamy to przed zawarciem umowy.
                </p>
              </div>
            </div>

            <div class="mt-10 max-w-2xl border-t border-line pt-8">
              <h3 class="font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                A co, jeśli w Twoim pomyśle są rzeczy, których jeszcze nie
                przewidziałeś?
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                To normalne. Podczas przygotowywania aplikacji często wychodzą
                na jaw pytania, na które wcześniej nie było potrzeby odpowiadać.
              </p>
              <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                Dlatego nie ograniczam się do zebrania listy funkcji. Pomagam
                również dopracować najważniejsze zasady działania i wyjaśnić
                kwestie, które mogłyby stać się problemem podczas programowania.
              </p>
              <p class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                Tak pracowaliśmy między innymi nad grą Numerabble, w której
                trzeba było przełożyć rozbudowane zasady gry planszowej na
                działającą aplikację.
              </p>
              <p class="mt-4">
                <a
                  href="/realizacje/"
                  class="inline-flex min-h-11 items-center text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                >
                  Zobacz, jak wyglądało to w praktyce — realizacja Numerabble.
                </a>
              </p>
            </div>

            <div class="mt-10 flex flex-col gap-5 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between sm:gap-10">
              <p class="max-w-xl font-heading text-xl leading-snug font-semibold text-balance text-ink sm:text-2xl">
                Podczas rozmowy sprawdzimy, czy Twój projekt mieści się w tym
                pakiecie.
              </p>
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full shrink-0 gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Porozmawiajmy o Twoim pomyśle
                <ArrowRight />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="po-czterech-tygodniach"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              03 · Po 4 tygodniach
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Co będziesz mieć po pierwszych 4 tygodniach?
            </h2>
            <p class="mt-4 max-w-2xl font-heading text-xl leading-snug text-balance text-ink sm:text-2xl">
              Coś, co możesz naprawdę uruchomić i pokazać innym.
            </p>

            <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Wyobraź sobie, że zamiast kolejny raz opowiadać znajomemu albo
              potencjalnemu partnerowi, jak ma działać Twoja aplikacja, po
              prostu wysyłasz mu link.
            </p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Może wejść, zobaczyć produkt i samodzielnie wypróbować jego
              najważniejszą funkcję.
            </p>

            <p class="mt-8 max-w-2xl text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
              Będziesz mógł:
            </p>
            <ul class="mt-4 max-w-2xl border-t border-line">
              {ofertaOutcomes.map((item) => (
                <li class="flex items-start gap-3 border-b border-line py-4">
                  <Check
                    className="mt-0.5 size-4 shrink-0 text-signal"
                    aria-hidden="true"
                  />
                  <span class="text-sm leading-relaxed text-pretty text-ink sm:text-base">
                    {item}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-8 max-w-2xl rounded-2xl border border-line bg-paper p-6 sm:p-8">
              <p class="text-base leading-relaxed text-pretty text-ink-soft">
                Nie obiecuję Ci, że aplikacja od razu zdobędzie tysiące
                użytkowników albo zacznie zarabiać. Sukces rynkowy zależy
                również od pomysłu, odbiorców i sposobu dotarcia do nich.
              </p>
              <p class="mt-4 font-heading text-lg leading-snug font-semibold text-balance text-ink sm:text-xl">
                Otrzymujesz działającą podstawę i możliwość rozpoczęcia
                sprawdzania swojego pomysłu.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="porownanie"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-3">
            <p class="font-mono text-xs tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
              04 · Porównanie
            </p>
          </div>

          <div class="lg:col-span-9">
            <h2 class="font-heading text-3xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-4xl">
              Projekt graficzny, prototyp czy działająca aplikacja — jaka jest
              różnica?
            </h2>

            <div class="mt-10 hidden md:block">
              <Table>
                <TableCaption className="sr-only">
                  Różnice między projektem graficznym, klikalnym prototypem,
                  pierwszą działającą wersją i pełną aplikacją
                </TableCaption>
                <TableHeader>
                  <TableRow className="border-line hover:bg-transparent">
                    <TableHead className="px-3 py-3 align-bottom text-xs font-medium tracking-[0.14em] whitespace-normal text-ink-soft uppercase sm:py-4">
                      Rozwiązanie
                    </TableHead>
                    <TableHead className="px-3 py-3 align-bottom text-xs font-medium tracking-[0.14em] whitespace-normal text-ink-soft uppercase sm:py-4">
                      Co otrzymujesz
                    </TableHead>
                    <TableHead className="px-3 py-3 align-bottom text-xs font-medium tracking-[0.14em] whitespace-normal text-ink-soft uppercase sm:py-4">
                      Do czego służy
                    </TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {ofertaComparison.map((option) => (
                    <TableRow className="border-line hover:bg-transparent">
