---
import type { CollectionEntry } from "astro:content"
import { getCollection, render } from "astro:content"
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import ArticleHeader from "@/components/article/ArticleHeader.astro"
import ReadingProgress from "@/components/article/ReadingProgress.astro"
import ArticleTOC from "@/components/article/ArticleTOC.astro"
import KeyTakeaways from "@/components/article/KeyTakeaways.astro"
import ArticleFAQ from "@/components/article/ArticleFAQ.astro"
import ArticleChecklistCTA from "@/components/article/ArticleChecklistCTA.astro"
import ArticleSources from "@/components/article/ArticleSources.astro"
import ArticleAuthor from "@/components/article/ArticleAuthor.astro"
import RelatedArticles from "@/components/article/RelatedArticles.astro"
import ArticleFinalCTA from "@/components/article/ArticleFinalCTA.astro"
import { wiedzaArticlePath, wiedzaCategoryLabel } from "@/data/wiedza"
import { wiedzaImageFor } from "@/data/wiedza-images"
import { countWords, getReadingTime } from "@/lib/reading-time"

export async function getStaticPaths() {
  const entries = await getCollection("wiedza")

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<"wiedza">
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL(wiedzaArticlePath(entry.id), siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const allEntries = await getCollection("wiedza")

const manualRelated = entry.data.related.flatMap((id) => {
  const item = allEntries.find((entryItem) => entryItem.id === id)
  return item && item.id !== entry.id ? [item] : []
})
const manualRelatedIds = new Set(manualRelated.map((item) => item.id))
const fallbackRelated = allEntries
  .filter((item) => item.id !== entry.id && !manualRelatedIds.has(item.id))
  .sort((a, b) => {
    const aSameCategory = a.data.category === entry.data.category ? 0 : 1
    const bSameCategory = b.data.category === entry.data.category ? 0 : 1
    return aSameCategory - bSameCategory || a.data.order - b.data.order
  })
const relatedEntries = [...manualRelated, ...fallbackRelated].slice(0, 3)

const tocLabel = (text: string) => text.replace(/^\d+\.\s*/, "")
const tocHeadings = headings.filter((heading) => heading.depth === 2)
const tocItems = tocHeadings.map((heading) => ({
  slug: heading.slug,
  label:
    entry.data.tocLabels[heading.slug] ??
    entry.data.tocLabels[heading.text] ??
    tocLabel(heading.text),
}))

if (entry.data.faq.length > 0) {
  tocItems.push({ slug: "faq", label: "Pytania i odpowiedzi" })
}

if (entry.data.sources.length > 0) {
  const sourcesSlug = "źródła-i-materiały-dodatkowe"
  if (!tocItems.some((item) => item.slug === sourcesSlug)) {
    tocItems.push({
      slug: sourcesSlug,
      label:
        entry.data.tocLabels[sourcesSlug] ?? "Źródła i materiały dodatkowe",
    })
  }
}

const wordCount = countWords(entry.body)
const readingTime = getReadingTime(entry.body)
const isDraft = wordCount === 0
const categoryLabel = wiedzaCategoryLabel(entry.data.category)
const cover = wiedzaImageFor(entry.id)

const articleSchema = {
  "@type": "Article",
  "@id": `${pageURL}#article`,
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: "pl-PL",
  datePublished: entry.data.publishedAt?.toISOString(),
  dateModified: entry.data.updatedAt?.toISOString(),
  articleSection: categoryLabel,
  wordCount: wordCount || undefined,
  timeRequired: readingTime ? `PT${readingTime}M` : undefined,
  author: {
    "@type": "Person",
    "@id": `${siteRoot}#person`,
    name: "Karol Modelski",
    url: siteRoot,
  },
  publisher: { "@id": `${siteRoot}#organization` },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${pageURL}#webpage` },
  image: {
    "@type": "ImageObject",
    url: cover
      ? new URL(cover.src.src, siteURL).toString()
      : new URL("/og-image.png", siteURL).toString(),
    width: cover?.src.width ?? 1200,
    height: cover?.src.height ?? 630,
  },
}

const faqSchema =
  entry.data.faq.length > 0
    ? [
        {
          "@type": "FAQPage",
          "@id": `${pageURL}#faq`,
          mainEntity: entry.data.faq.map(({ question, answer }) => ({
            "@type": "Question",
            name: question,
            acceptedAnswer: {
              "@type": "Answer",
              text: answer,
            },
          })),
        },
      ]
    : []

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Wiedza",
      item: new URL("/wiedza/", siteURL).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: entry.data.title,
      item: pageURL,
    },
  ],
}

const jsonLd = [articleSchema, ...faqSchema, breadcrumbSchema]
---

<Layout
  title={entry.data.metaTitle ?? `${entry.data.title} | Karol Modelski`}
  description={entry.data.description}
  ogType="article"
  articlePublishedTime={entry.data.publishedAt?.toISOString()}
  articleModifiedTime={entry.data.updatedAt?.toISOString()}
  articleSection={categoryLabel}
  noindex={isDraft}
  ogImage={cover?.src.src}
  ogImageAlt={cover?.alt}
  jsonLd={jsonLd}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="wiedza" showProgress={false} />

  <ReadingProgress />

  <main id="main">
    <article data-reading-progress-target class="pt-8 pb-16 sm:pt-10 sm:pb-20">
      <ArticleHeader
        entry={entry}
        categoryLabel={categoryLabel}
        readingTime={readingTime}
        cover={cover}
      />

      <div class="shell article-shell">
        <div class="mt-10 grid grid-cols-1 gap-12 xl:grid-cols-[15rem_minmax(0,43rem)] xl:justify-center xl:gap-16">
          <ArticleTOC variant="desktop" items={tocItems} />

          <div class="mx-auto w-full min-w-0 max-w-[43rem] xl:max-w-none">
            <ArticleTOC variant="mobile" items={tocItems} />

            <KeyTakeaways points={entry.data.keyTakeaways} />

            <div class="article-body mt-10">
              <Content />
            </div>

            <div class="mt-12 space-y-12">
              <ArticleFAQ faq={entry.data.faq} />

              {entry.data.download && (
                <ArticleChecklistCTA download={entry.data.download} />
              )}

              {entry.data.sources.length > 0 && (
                <ArticleSources
                  sources={entry.data.sources}
                  intro={entry.data.sourcesIntro}
                  note={entry.data.sourcesNote}
                />
              )}

              <ArticleAuthor />
            </div>
          </div>
        </div>
      </div>
    </article>

    <RelatedArticles entries={relatedEntries} />

    <ArticleFinalCTA />
  </main>

  <CompactFooter />

  <script is:inline>
    ;(() => {
      const entryBlocks = document.querySelectorAll(
        "[data-article-exercise], [data-article-brief]"
      )

      entryBlocks.forEach((block) => {
        const button = block.querySelector("[data-exercise-copy]")
        const status = block.querySelector("[data-exercise-status]")
        const fields = Array.from(
          block.querySelectorAll("textarea[id], input[id]")
        )

        if (!button || !fields.length) return

        button.hidden = false

        const getAnswerText = () =>
          fields
            .map((field) => {
              const value = field.value.trim()
              if (!value) return null
              const label = block.querySelector(`label[for="${field.id}"]`)
              return `${label ? label.textContent.trim() : field.name}: ${value}`
            })
            .filter(Boolean)
            .join("\n\n")

        const announce = (message) => {
          if (status) status.textContent = message
        }

        button.addEventListener("click", async () => {
          const text = getAnswerText()

          if (!text) {
            announce("Wpisz odpowiedzi, które chcesz skopiować.")
            fields[0]?.focus()
            return
          }

          try {
            if (!navigator.clipboard?.writeText) {
              throw new Error("Clipboard API unavailable")
            }
            await navigator.clipboard.writeText(text)
            announce("Skopiowano odpowiedzi.")
          } catch {
            const firstFilled = fields.find((field) => field.value.trim())
            const field = firstFilled ?? fields[0]
            field.focus()
            field.select()
            announce(
              "Nie udało się skopiować automatycznie. Zaznacz tekst i skopiuj ręcznie."
            )
          }
        })
      })

      document.querySelectorAll("[data-article-checklist]").forEach((box) => {
        const inputs = Array.from(box.querySelectorAll("input[type=checkbox]"))
        const status = box.querySelector("[data-checklist-status]")
        if (!inputs.length || !status) return

        const update = () => {
          const checked = inputs.filter((input) => input.checked).length
          status.textContent = `${checked} z ${inputs.length}`
        }

        inputs.forEach((input) => input.addEventListener("change", update))
        update()
      })

      const numberFormat = new Intl.NumberFormat("pl-PL", {
        maximumFractionDigits: 0,
      })

      const money = (value) => `${numberFormat.format(Math.round(value))} zł`

      document.querySelectorAll("[data-calculator]").forEach((calculator) => {
        const type = calculator.dataset.calculator
        const inputs = Array.from(calculator.querySelectorAll("[data-calc]"))
        const outputs = Array.from(
          calculator.querySelectorAll("[data-calc-output]")
        )
        if (!inputs.length || !outputs.length) return

        const read = (name) => {
          const input = calculator.querySelector(`[data-calc="${name}"]`)
          if (!input) return null
          const raw = input.value.trim().replace(",", ".")
          if (raw === "") return null
          const value = Number(raw)
          return Number.isFinite(value) && value >= 0 ? value : null
        }

        const write = (name, value) => {
          const output = calculator.querySelector(
            `[data-calc-output="${name}"]`
          )
          if (output) output.textContent = value === null ? "—" : money(value)
        }

        const update = () => {
          if (type === "hours-rate") {
            const hours = read("hours")
            const rate = read("rate")
            if (hours === null || rate === null) {
              write("net", null)
              write("gross", null)
              return
            }
            const net = hours * rate
            write("net", net)
            write("gross", net * 1.23)
          }

          if (type === "first-year") {
            const infra = read("infra")
            const services = read("services")
            const care = read("care")
            const oneTime = read("one-time") ?? 0
            if (infra === null || services === null || care === null) {
              write("monthly", null)
              write("annual", null)
              write("first-year", null)
              return
            }
            const monthly = infra + services + care
            write("monthly", monthly)
            write("annual", monthly * 12)
            write("first-year", monthly * 12 + oneTime)
          }

          if (type === "time-value") {
            const hours = read("hours")
            const rate = read("rate")
            const tools = read("tools") ?? 0
            const months = read("months") ?? 0
            if (hours === null || rate === null) {
              write("time-value", null)
              write("tools-total", null)
              write("total", null)
              return
            }
            const timeValue = hours * rate
            const toolsTotal = tools * months
            write("time-value", timeValue)
            write("tools-total", toolsTotal)
            write("total", timeValue + toolsTotal)
          }
        }

        inputs.forEach((input) => input.addEventListener("input", update))
        update()
      })
    })()
  </script>
</Layout>
