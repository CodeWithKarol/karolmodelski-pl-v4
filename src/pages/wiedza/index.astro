---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import SectionHeading from "@/components/section-heading.astro"
import EditorialArticleCard from "@/components/editorial-article-card.astro"
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import {
  WIEDZA_CATEGORIES,
  WIEDZA_BASE_PATH,
  wiedzaArticlePath,
} from "@/data/wiedza"
import { wiedzaImageFor } from "@/data/wiedza-images"
import { plural } from "@/lib/format"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight } from "lucide-react"
import checklistPreview from "@/assets/images/checklista-preview.png"
import portrait from "@/assets/images/karol-modelski-portrait.webp"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const entries = (await getCollection("wiedza")).sort(
  (a, b) => a.data.order - b.data.order
)
const featured = entries.find((entry) => entry.data.featured) ?? entries[0]
const articles = entries.filter((entry) => entry.id !== featured?.id)

const filters = [
  { id: "all", label: "Wszystkie", count: entries.length },
  ...WIEDZA_CATEGORIES.map((category) => ({
    id: category.id,
    label: category.label,
    count: entries.filter((entry) => entry.data.category === category.id)
      .length,
  })),
]

const consultationUrl = "/rozmowa/"

const jsonLd = [
  {
    "@type": "ItemList",
    "@id": `${new URL(Astro.url.pathname, siteURL)}#articles`,
    name: "Wiedza o tworzeniu aplikacji",
    numberOfItems: entries.length,
    itemListElement: entries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: entry.data.title,
      url: new URL(wiedzaArticlePath(entry.id), siteURL).toString(),
    })),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${new URL(Astro.url.pathname, siteURL)}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: new URL("/", siteURL).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Wiedza",
        item: new URL(`${WIEDZA_BASE_PATH}/`, siteURL).toString(),
      },
    ],
  },
]
---

<Layout
  title="Wiedza – poradniki o tworzeniu aplikacji | Karol Modelski"
  description="Od czego zacząć, ile to kosztuje i co przygotować? Poradniki o pomyśle, realizacji i tym, co sprawdzić po uruchomieniu aplikacji. Bez żargonu."
  jsonLd={jsonLd}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" current="wiedza" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-50"
      ></div>

      <div class="shell pt-10 pb-12 sm:pt-16 lg:pt-24 lg:pb-16">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Wiedza</li>
          </ol>
        </nav>

        <div class="mt-10 max-w-4xl lg:mt-14">
          <p class="flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] text-ink-soft uppercase">
            <span class="h-px w-8 bg-signal" aria-hidden="true" />
            Wiedza · Od pomysłu do aplikacji
          </p>

          <h1 class="mt-6 font-heading text-[clamp(2.5rem,1.2rem+3.2vw,3.75rem)] leading-[1.03] font-semibold tracking-tight text-balance">
            Wiedza, która pomaga zamienić pomysł w produkt.
          </h1>

          <p class="lede mt-6 max-w-2xl">
            Praktyczne poradniki o tworzeniu aplikacji, kosztach i współpracy z
            wykonawcami. Bez żargonu i bez obiecywania sukcesu.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-5">
            <p class="font-mono text-[11px] tracking-[0.14em] text-ink-soft uppercase">
              {entries.length}{" "}
              {plural(entries.length, "poradnik", "poradniki", "poradników")}
            </p>
            <a
              href="#poradniki"
              class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Przejdź do biblioteki
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="poradniki" class="scroll-mt-24 border-t border-line bg-paper">
      <div class="shell pb-16 sm:pb-20">
        <div
          data-wiedza-filters
          hidden
          role="group"
          aria-label="Filtruj poradniki według tematu"
          class="border-b border-line py-3"
        >
          <div class="flex items-center gap-5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {filters.map(({ id, label, count }) => (
              <button
                type="button"
                data-wiedza-filter={id}
                aria-pressed={id === "all" ? "true" : "false"}
                class="flex shrink-0 items-baseline gap-1.5 border-b-2 border-transparent py-2 text-sm text-ink-soft transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal aria-pressed:border-signal aria-pressed:text-ink"
              >
                {label}
                <span class="font-mono text-[10px] text-ink-soft">{count}</span>
              </button>
            ))}
            <p
              data-wiedza-count
              aria-live="polite"
              class="ml-auto hidden shrink-0 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase sm:block"
            >
              {entries.length}{" "}
              {plural(entries.length, "artykuł", "artykuły", "artykułów")}
            </p>
          </div>
        </div>

        <div data-featured-section class="pt-10 sm:pt-12">
          {featured && (
            <EditorialArticleCard
              entry={featured}
              image={wiedzaImageFor(featured.id)}
              variant="featured"
              priority
            />
          )}
        </div>

        <div class="mt-14 border-t border-line pt-8">
          <div class="border-b border-line pb-4">
            <h2 class="font-heading text-2xl leading-snug font-semibold tracking-tight">
              Poradniki o tworzeniu aplikacji
            </h2>
          </div>

          <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((entry, index) => (
              <Fragment>
                <EditorialArticleCard
                  entry={entry}
                  image={wiedzaImageFor(entry.id)}
                />

                {index === 2 && (
                  <div
                    data-checklist-module
                    class="border-y border-line bg-surface-muted px-5 py-8 sm:px-8 sm:py-10 md:col-span-2 lg:col-span-3"
                  >
                    <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-12 md:gap-12">
                      <div class="md:col-span-8">
                        <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
                          Bezpłatna checklista
                        </p>
                        <h3 class="mt-3 font-heading text-2xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-3xl">
                          Zanim zaczniesz czytać — uporządkuj własny pomysł.
                        </h3>
                        <p class="copy mt-3 text-sm sm:text-base">
                          12 pytań pomaga uporządkować pomysł, użytkowników,
                          budżet i ryzyka przed rozmową z wykonawcą.
                        </p>
                        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
                          <a
                            href="/checklista/"
                            class={cn(
                              buttonVariants({ size: "lg" }),
                              "h-auto min-h-11 gap-2 rounded-[6px] px-5 py-2.5 text-center text-sm text-balance whitespace-normal sm:text-base"
                            )}
                          >
                            Pobierz bezpłatną checklistę
                            <ArrowRight />
                          </a>
                          <p class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                            PDF · 4 strony · Bez rejestracji
                          </p>
                        </div>
                      </div>

                      <div class="md:col-span-4">
                        <a
                          href="/checklista/"
                          class="mx-auto block w-full max-w-[10rem] overflow-hidden rounded-lg border border-line bg-paper md:max-w-[13rem]"
                        >
                          <Image
                            src={checklistPreview}
                            alt="Pierwsza strona checklisty „12 pytań, zanim zaczniesz budować aplikację”"
                            widths={[240, 320, 480, 640]}
                            sizes="(min-width: 768px) 208px, 160px"
                            quality={80}
                            loading="lazy"
                            decoding="async"
                            class="h-auto w-full"
                          />
                        </a>
                      </div>
                    </div>
                  </div>
                )}
              </Fragment>
            ))}
          </div>
        </div>

        <p
          data-wiedza-empty
          hidden
          class="border-b border-line py-8 text-sm text-ink-soft"
        >
          Brak artykułów w tej kategorii.
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-surface-muted">
      <div class="shell py-12 sm:py-16">
        <div class="grid grid-cols-[7rem_minmax(0,1fr)] items-start gap-6 sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-center sm:gap-10">
          <Image
            src={portrait}
            alt="Karol Modelski"
            widths={[160, 240, 320, 480]}
            sizes="(min-width: 640px) 144px, 112px"
            quality={82}
            loading="lazy"
            decoding="async"
            class="aspect-[4/5] w-full rounded-lg border border-line object-cover"
          />
          <div>
            <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
              Autor
            </p>
            <h2 class="mt-2 font-heading text-2xl leading-snug font-semibold tracking-tight">
              Karol Modelski
            </h2>
            <p class="copy mt-2 text-sm sm:text-base">
              Techniczny partner pomysłodawców. Od ponad 7 lat tworzę
              oprogramowanie — wcześniej systemy dla banków i dużych firm. Piszę
              o zakresie, kosztach i realizacji pierwszej wersji.
            </p>
            <a
              href="/o-mnie/"
              class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Poznaj mnie i moje podejście
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="kontakt"
      class="force-dark on-ink section-y border-t border-line bg-ink text-paper"
    >
      <div class="shell">
        <div class="max-w-3xl">
          <SectionHeading
            eyebrow="Na koniec"
            title="Czas przełożyć wiedzę na Twój pomysł."
            lead="Opowiesz mi, co chcesz stworzyć. W 20 minut sprawdzimy pierwszy krok."
            tone="dark"
          />

          <div class="mt-8">
            <a
              href={consultationUrl}
              class={cn(
                buttonVariants({ size: "lg" }),
                "h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85 sm:w-auto"
              )}
            >
              Umów bezpłatną rozmowę
              <ArrowRight />
            </a>
            <p class="mt-4 text-sm leading-relaxed text-paper/60">
              Bezpłatna rozmowa · 20 minut · Bez zobowiązań
            </p>
          </div>

          <a
            href="/jak-pracuje/"
            class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-paper underline decoration-paper/25 underline-offset-4 transition-colors hover:decoration-signal"
          >
            Zobacz, jak pracuję
            <ArrowRight className="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <CompactFooter />

  <script is:inline>
    ;(() => {
      const filters = document.querySelector("[data-wiedza-filters]")
      if (!filters) return

      filters.hidden = false

      const buttons = Array.prototype.slice.call(
        filters.querySelectorAll("[data-wiedza-filter]")
      )
      const cards = Array.prototype.slice.call(
        document.querySelectorAll("[data-article-card]")
      )
      const count = document.querySelector("[data-wiedza-count]")
      const empty = document.querySelector("[data-wiedza-empty]")
      const featuredSection = document.querySelector("[data-featured-section]")
      const checklist = document.querySelector("[data-checklist-module]")
      const valid = new Set(
        buttons.map((button) => button.dataset.wiedzaFilter)
      )

      const plural = (n) => {
        if (n === 1) return "1 artykuł"
        if (n >= 2 && n <= 4) return n + " artykuły"
        return n + " artykułów"
      }

      const apply = (category, updateUrl = true) => {
        if (!valid.has(category)) category = "all"

        let visible = 0

        cards.forEach((card) => {
          const show = category === "all" || card.dataset.category === category
          card.hidden = !show
          if (show) visible++
        })

        buttons.forEach((button) => {
          const active = button.dataset.wiedzaFilter === category
          button.setAttribute("aria-pressed", String(active))
        })

        if (count) count.textContent = plural(visible)

        if (featuredSection) {
          featuredSection.hidden = !cards.some(
            (card) => featuredSection.contains(card) && !card.hidden
          )
        }

        if (checklist) checklist.hidden = category !== "all"
        if (empty) empty.hidden = visible !== 0

        if (updateUrl) {
          const url = new URL(window.location.href)
          if (category === "all") url.searchParams.delete("kategoria")
          else url.searchParams.set("kategoria", category)
          window.history.replaceState(null, "", url)
        }
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          apply(button.dataset.wiedzaFilter || "all")
        })
      })

      const initial =
        new URL(window.location.href).searchParams.get("kategoria") || "all"
      apply(initial, false)

      window.addEventListener("popstate", () => {
        const category =
          new URL(window.location.href).searchParams.get("kategoria") || "all"
        apply(category, false)
      })
    })()
  </script>
</Layout>
