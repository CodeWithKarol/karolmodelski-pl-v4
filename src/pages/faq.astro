---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import CompactFooter from "@/components/compact-footer.astro"
import FaqSearch from "@/components/faq/faq-search.astro"
import FaqAccordion from "@/components/faq/faq-accordion.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { faqAll, faqCategories, faqHighlights } from "@/data/faq-page"
import { ArrowRight } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/faq/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle =
  "FAQ – tworzenie aplikacji, cena, terminy i prawa | Karol Modelski"
const metaDescription =
  "Ile kosztuje pierwsza wersja aplikacji? Co otrzymasz po 4 tygodniach? Jak działa NDA i przekazanie praw? Poznaj odpowiedzi o cenę, zakres i współpracę."

const consultationUrl = "/rozmowa/"

const normalize = (value: string) =>
  value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/ł/g, "l")

const withSearch = <
  T extends { question: string; answer: string; items?: string[] },
>(
  item: T
) => ({
  ...item,
  search: normalize(
    [item.question, item.answer, ...(item.items ?? [])].join(" ")
  ),
})

const categories = faqCategories.map((category) => ({
  ...category,
  questions: category.questions.map(withSearch),
}))

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageURL}#faq`,
  mainEntity: faqAll.map(({ question, answer, items }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: [answer, ...(items ?? [])].join(" "),
    },
  })),
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "FAQ",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[faqSchema, breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-6 pb-10 sm:px-6 sm:pt-8 sm:pb-12">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">FAQ</li>
          </ol>
        </nav>

        <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-[11px] tracking-[0.18em] text-ink-soft uppercase">
              <span class="h-px w-6 bg-signal"></span>
              FAQ
            </p>

            <h1 class="mt-5 max-w-[18ch] font-heading text-[clamp(2.25rem,1.5rem+2.6vw,4rem)] leading-[1.04] font-semibold tracking-tight text-balance">
              Masz pytania o stworzenie aplikacji?
            </h1>

            <p class="mt-5 max-w-[36rem] text-[17px] leading-[1.65] text-pretty text-ink sm:text-lg">
              Znajdź odpowiedzi dotyczące kosztów, terminów, bezpieczeństwa
              pomysłu i przebiegu współpracy.
            </p>

            <p class="mt-4 font-mono text-[11px] tracking-[0.14em] text-ink-soft uppercase">
              29 pytań · 6 kategorii
            </p>
          </div>

          <div class="lg:col-span-5 lg:pt-1">
            <FaqSearch
              total={faqAll.length}
              categories={faqCategories.length}
            />

            <div class="mt-8 border-t border-line pt-5">
              <p class="font-mono text-[10px] tracking-[0.16em] text-ink-soft uppercase">
                Najczęstsze obawy
              </p>
              <ul class="mt-3">
                {faqHighlights.map(({ question, target }) => (
                  <li class="border-b border-line last:border-b-0">
                    <a
                      href={`#${target}`}
                      class="group flex min-h-11 items-start justify-between gap-4 py-3 text-sm leading-relaxed text-pretty text-ink transition-colors hover:text-signal-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                    >
                      {question}
                      <ArrowRight
                        className="mt-0.5 size-4 shrink-0 text-ink-soft transition-transform group-hover:translate-x-0.5"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="biblioteka"
      class="border-t border-line bg-surface-muted px-4 py-10 sm:px-6 sm:py-14"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start lg:gap-16">
          <aside class="lg:col-span-3">
            <div class="lg:sticky lg:top-24">
              <p class="font-mono text-[10px] tracking-[0.16em] text-ink-soft uppercase">
                Kategorie
              </p>
              <div class="mt-3 flex flex-wrap gap-2 lg:flex-col lg:gap-1">
                <button
                  type="button"
                  data-faq-category="all"
                  aria-pressed="true"
                  class="inline-flex min-h-9 items-center gap-2 rounded-full border border-line px-3 text-sm text-ink transition-colors aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper lg:w-full lg:justify-between lg:rounded-md lg:border-transparent lg:px-3 lg:py-2 lg:text-ink-soft lg:aria-pressed:border-transparent lg:aria-pressed:bg-secondary lg:aria-pressed:font-medium lg:aria-pressed:text-ink"
                >
                  Wszystkie
                  <span class="font-mono text-[10px] opacity-70">
                    {faqAll.length}
                  </span>
                </button>
                {categories.map((category) => (
                  <button
                    type="button"
                    data-faq-category={category.id}
                    aria-pressed="false"
                    class="inline-flex min-h-9 items-center gap-2 rounded-full border border-line px-3 text-sm text-ink transition-colors aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper lg:w-full lg:justify-between lg:rounded-md lg:border-transparent lg:px-3 lg:py-2 lg:text-ink-soft lg:aria-pressed:border-transparent lg:aria-pressed:bg-secondary lg:aria-pressed:font-medium lg:aria-pressed:text-ink"
                  >
                    {category.navLabel}
                    <span class="font-mono text-[10px] opacity-70">
                      {category.questions.length}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          </aside>

          <div class="lg:col-span-9">
            <div
              data-faq-empty
              hidden
              class="rounded-lg border border-line bg-paper p-6"
            >
              <p class="font-heading text-lg leading-snug font-semibold text-ink">
                Brak wyników
              </p>
              <p
                class="mt-2 text-sm leading-relaxed text-ink-soft"
                data-faq-empty-text
              >
                Spróbuj innego słowa albo wyczyść filtry.
              </p>
              <button
                type="button"
                data-faq-reset
                class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-md border border-ink px-4 text-sm font-medium text-ink transition-colors hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
              >
                Wyczyść filtry
              </button>
            </div>

            <div class="space-y-12">
              {categories.map((category) => (
                <FaqAccordion
                  id={category.id}
                  title={category.title}
                  link={category.link}
                  questions={category.questions}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="kontakt"
      class="on-ink border-t border-line bg-ink px-4 py-12 text-paper sm:px-6 sm:py-16"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-8">
            <h2 class="max-w-2xl font-heading text-[clamp(1.875rem,1.3rem+2vw,3rem)] leading-[1.08] font-semibold tracking-tight text-balance">
              Porozmawiajmy o Twoim pomyśle.
            </h2>
            <p class="mt-4 max-w-[38rem] text-[17px] leading-[1.65] text-pretty text-paper/75 sm:text-lg">
              Nie każdą sytuację da się opisać w kilku zdaniach. Jeśli masz
              pytanie dotyczące swojego projektu, możemy omówić je podczas
              krótkiej rozmowy.
            </p>

            <a
              href={consultationUrl}
              data-faq-consultation
              class={cn(
                buttonVariants({ size: "lg" }),
                "mt-6 h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-ink hover:bg-paper/85 sm:w-auto"
              )}
            >
              Umów bezpłatną rozmowę
              <ArrowRight aria-hidden="true" />
            </a>

            <p class="mt-4 text-sm leading-relaxed text-paper/60">
              20 minut · Online · Bez zobowiązań
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <CompactFooter />

  <script is:inline>
    ;(() => {
      window.dataLayer = window.dataLayer || []
      window.dataLayer.push({ event: "faq_view", questions: 29 })

      document.addEventListener(
        "toggle",
        (event) => {
          const details = event.target
          if (!(details instanceof HTMLDetailsElement)) return
          if (!details.matches("[data-faq-item]")) return
          window.dataLayer.push({
            event: details.open ? "faq_open" : "faq_close",
            question: details.id,
          })
        },
        true
      )

      document.addEventListener("click", (event) => {
        const target = event.target
        if (!target || !target.closest) return
        const link = target.closest("a[href]")
        if (!link) return
        const href = link.getAttribute("href") || ""

        if (href.startsWith("/oferta/")) {
          window.dataLayer.push({ event: "faq_offer_click", source: "faq" })
        }
        if (href.startsWith("/rozmowa/")) {
          window.dataLayer.push({
            event: "faq_consultation_click",
            source: "faq",
          })
        }
      })
    })()
  </script>
</Layout>
