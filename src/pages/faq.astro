---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { plural } from "@/lib/format"
import { faqAll, faqCategories, faqHighlights } from "@/data/faq-page"
import { ArrowRight, ChevronDown } from "lucide-react"

const siteURL = Astro.site ?? new URL("https://www.karolmodelski.pl")
const pageURL = new URL("/faq/", siteURL).toString()
const siteRoot = new URL("/", siteURL).toString()

const metaTitle =
  "FAQ – tworzenie aplikacji, cena, terminy i prawa | Karol Modelski"
const metaDescription =
  "Ile kosztuje pierwsza wersja aplikacji? Co otrzymasz po 4 tygodniach? Jak działa NDA i przekazanie praw? Poznaj odpowiedzi na najczęstsze pytania."

const consultationUrl = "/rozmowa/"

const countLabel = (count: number) =>
  `${count} ${plural(count, "pytanie", "pytania", "pytań")}`

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageURL}#faq`,
  mainEntity: faqAll.map(({ question, answer, items }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: [answer, ...(items ?? [])].join(" "),
    },
  })),
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${pageURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Strona główna",
      item: siteRoot,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "FAQ",
      item: pageURL,
    },
  ],
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[faqSchema, breadcrumbSchema]}
>
  <a
    href="#main"
    class="fixed top-4 left-4 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-transform focus:translate-y-0 focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:outline-none motion-reduce:transition-none"
  >
    Przejdź do treści
  </a>

  <SiteHeader variant="page" />

  <main id="main">
    <section class="relative overflow-hidden bg-paper px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-20">
      <div
        aria-hidden="true"
        class="grain pointer-events-none absolute inset-0 -z-10 opacity-60"
      ></div>

      <div class="relative mx-auto max-w-[75rem]">
        <nav aria-label="Ścieżka nawigacji">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            <li>
              <a class="transition-colors hover:text-ink" href="/">
                Strona główna
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">FAQ</li>
          </ol>
        </nav>

        <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="rise lg:col-span-7">
            <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-ink-soft uppercase">
              <span class="h-px w-8 bg-signal"></span>
              FAQ · Realizacja aplikacji
            </p>

            <h1 class="mt-6 font-heading text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">
              Najczęstsze pytania o stworzenie własnej aplikacji
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-ink sm:text-xl">
              Masz pomysł, ale nie wiesz, od czego zacząć? Zastanawiasz się nad
              kosztami, terminami albo tym, czy ktoś nie wykorzysta Twojego
              pomysłu?
            </p>

            <p class="mt-4 max-w-xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Rozumiem. Kiedy po raz pierwszy zlecasz stworzenie aplikacji,
              trudno wiedzieć, o co właściwie zapytać.
            </p>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Dlatego zebrałem tutaj odpowiedzi na pytania, które najczęściej
              pojawiają się podczas rozmów o realizacji nowych produktów.
            </p>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Bez technicznego żargonu i obiecywania rzeczy, których nie można
              zagwarantować.
            </p>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-pretty text-ink-soft sm:text-lg">
              Jeżeli nie znajdziesz odpowiedzi na swoje pytanie, możemy po
              prostu porozmawiać.
            </p>

            <div class="mt-8 flex flex-col items-start gap-4">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] px-6 py-3 text-center text-base text-balance whitespace-normal sm:w-auto"
                )}
              >
                Umów bezpłatną rozmowę
                <ArrowRight />
              </a>
              <p class="text-sm leading-relaxed text-pretty text-ink-soft">
                20 minut · Online · Bez zobowiązań
              </p>
            </div>
          </div>

          <div class="rise lg:col-span-5" style="animation-delay:.12s">
            <div class="rounded-2xl border border-line bg-surface-muted p-6 sm:p-8">
              <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
                Najczęstsze obawy
              </p>
              <p class="mt-3 font-heading text-xl leading-snug font-semibold text-balance text-ink">
                Od czego zaczniemy rozwiewać wątpliwości?
              </p>

              <ul class="mt-5 border-t border-line">
                {faqHighlights.map(({ question, target }) => (
                  <li class="border-b border-line">
                    <a
                      href={`#${target}`}
                      class="group flex min-h-11 items-start justify-between gap-4 py-4"
                    >
                      <span class="text-sm leading-relaxed text-pretty text-ink">
                        {question}
                      </span>
                      <ArrowRight
                        className="mt-0.5 size-4 shrink-0 text-ink-soft transition-transform group-hover:translate-x-1"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="spis"
      class="border-t border-line bg-surface-muted px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem] lg:grid lg:grid-cols-12 lg:gap-x-16">
        <nav
          aria-labelledby="tematy-faq"
          data-faq-toc
          class="sticky top-16 z-30 -mx-4 border-b border-line bg-surface-muted px-4 py-2 sm:-mx-6 sm:px-6 lg:top-24 lg:col-span-3 lg:mx-0 lg:self-start lg:rounded-2xl lg:border lg:bg-paper lg:p-5"
        >
          <p
            id="tematy-faq"
            class="sr-only lg:not-sr-only lg:font-mono lg:text-[11px] lg:tracking-[0.16em] lg:text-ink-soft lg:uppercase"
          >
            Jakiego tematu dotyczy Twoje pytanie?
          </p>

          <details open data-faq-toc-panel class="lg:mt-4">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden lg:hidden">
              <span class="flex min-w-0 items-baseline gap-2">
                <span class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                  Temat
                </span>
                <span
                  class="truncate text-sm font-medium text-ink"
                  data-faq-toc-label
                >
                  {faqCategories[0].navLabel}
                </span>
              </span>
              <ChevronDown
                className="details-chevron size-4 shrink-0 text-ink-soft"
                aria-hidden="true"
              />
            </summary>

            <div class="pt-1 lg:pt-0">
              <ul class="grid grid-cols-2 gap-2 lg:grid-cols-1">
                {faqCategories.map((category) => (
                  <li>
                    <a
                      href={`#${category.id}`}
                      class="flex min-h-11 items-center justify-between gap-2 rounded-lg border border-line bg-paper px-3 text-sm text-ink-soft transition-colors hover:bg-secondary hover:text-ink aria-[current=true]:border-ink aria-[current=true]:bg-ink aria-[current=true]:text-paper lg:min-h-0 lg:w-full lg:items-baseline lg:gap-3 lg:border-transparent lg:bg-transparent lg:px-3 lg:py-2 lg:aria-[current=true]:border-transparent lg:aria-[current=true]:bg-secondary lg:aria-[current=true]:text-ink"
                    >
                      <span class="leading-snug">{category.navLabel}</span>
                      <span class="hidden font-mono text-[10px] text-ink-soft lg:inline">
                        {category.questions.length}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>

              <a
                href={consultationUrl}
                class="mt-2 flex min-h-11 items-center justify-center gap-2 rounded-lg border border-ink text-sm font-medium text-ink lg:hidden"
              >
                Umów rozmowę
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>

              <div class="hidden lg:mt-5 lg:block lg:border-t lg:border-line lg:pt-4">
                <p class="text-sm leading-relaxed text-pretty text-ink-soft">
                  Nie ma Twojego pytania?
                </p>
                <a
                  href={consultationUrl}
                  class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                >
                  Umów rozmowę
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              </div>
            </div>
          </details>
        </nav>

        <div class="mt-10 space-y-12 lg:col-span-9 lg:mt-0">
          {faqCategories.map((category) => (
            <section
              id={category.id}
              class="border-t border-line pt-10 first:border-t-0 first:pt-0"
            >
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h2 class="font-heading text-2xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-3xl">
                  {category.title}
                </h2>
                <span class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
                  {countLabel(category.questions.length)}
                </span>
              </div>

              <div class="mt-5 divide-y divide-line border-y border-line">
                {category.questions.map(({ id, question, answer, items }) => (
                  <details
                    id={id}
                    class="group scroll-mt-[9rem] py-5 lg:scroll-mt-24"
                  >
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
                      <h3 class="font-heading text-base leading-snug font-semibold text-balance text-ink sm:text-lg">
                        {question}
                      </h3>
                      <ChevronDown
                        className="details-chevron mt-0.5 size-5 shrink-0 text-ink-soft"
                        aria-hidden="true"
                      />
                    </summary>

                    <div class="mt-3 max-w-2xl space-y-3 text-sm leading-relaxed text-pretty text-ink-soft sm:text-base">
                      {answer.split("\n\n").map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}

                      {items && items.length > 0 && (
                        <ul class="list-disc space-y-2 pl-5">
                          {items.map((item) => (
                            <li class="pl-1">{item}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </details>
                ))}
              </div>

              {category.link && (
                <a
                  href={category.link.href}
                  class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
                >
                  {category.link.label}
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              )}
            </section>
          ))}
        </div>
      </div>
    </section>

    <section
      id="kontakt"
      class="border-t border-line bg-paper px-4 py-16 sm:px-6 sm:py-24"
    >
      <div class="mx-auto max-w-[75rem]">
        <div class="on-ink relative overflow-hidden rounded-2xl bg-ink px-6 py-10 text-paper sm:px-10 sm:py-12">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-32 -right-24 size-80 rounded-full bg-signal/20 blur-3xl"
          ></span>

          <div class="relative max-w-2xl">
            <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] text-paper/60 uppercase">
              <span class="h-px w-5 bg-signal" aria-hidden="true" />
              Masz jeszcze jakieś pytania?
            </p>
            <h2 class="mt-4 font-heading text-2xl leading-tight font-semibold tracking-tight text-balance sm:text-3xl">
              Porozmawiajmy o Twoim pomyśle.
            </h2>

            <div class="mt-4 space-y-3 text-base leading-relaxed text-pretty text-paper/75 sm:text-lg">
              <p>
                Być może Twój pomysł jest trochę inny niż projekty, o których
                tutaj piszę. Może nie jesteś pewien, czy wybrałeś właściwy
                sposób realizacji. A może po prostu chcesz porozmawiać z kimś,
                kto zna się na technologii i potrafi wyjaśnić wszystko po
                ludzku.
              </p>
              <p>Właśnie od tego możemy zacząć.</p>
            </div>

            <div class="mt-8">
              <a
                href={consultationUrl}
                class={cn(
                  buttonVariants({ size: "lg" }),
                  "h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85 sm:w-auto sm:py-0 sm:whitespace-nowrap"
                )}
              >
                Umów bezpłatną rozmowę o swoim pomyśle
                <ArrowRight />
              </a>
              <p class="mt-4 text-sm leading-relaxed text-paper/55">
                20 minut · Online · Bez zobowiązań
              </p>
            </div>

            <p class="mt-6 border-t border-paper/15 pt-5 text-sm leading-relaxed text-pretty text-paper/60">
              Nie musisz mieć gotowej dokumentacji ani wiedzieć, jak zbudować
              aplikację. A jeśli przed rozmową chcesz zabezpieczyć szczegóły
              swojego rozwiązania, możemy najpierw podpisać NDA.
            </p>

            <p class="mt-6 font-heading text-lg font-semibold text-paper">
              Karol Modelski
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script is:inline>
    ;(() => {
      const toc = document.querySelector("[data-faq-toc]")

      if (toc) {
        const links = Array.from(toc.querySelectorAll('a[href^="#"]'))
        const targets = links
          .map((link) => document.getElementById(link.hash.slice(1)))
          .filter(Boolean)
        const panel = toc.querySelector("[data-faq-toc-panel]")
        const label = toc.querySelector("[data-faq-toc-label]")
        const desktop = window.matchMedia("(min-width: 64rem)")

        if (panel && !desktop.matches) panel.open = false

        desktop.addEventListener("change", (event) => {
          if (panel) panel.open = event.matches
          schedule()
        })

        const setActive = (id) => {
          const active = links.find((link) => link.hash.slice(1) === id)

          links.forEach((link) => {
            if (link === active) {
              link.setAttribute("aria-current", "true")
            } else {
              link.removeAttribute("aria-current")
            }
          })

          const activeLabel = active?.querySelector("span")?.textContent?.trim()

          if (label && activeLabel) label.textContent = activeLabel
        }
        let frame = 0

        const update = () => {
          frame = 0
          if (!targets.length) return

          const line = desktop.matches
            ? (document.querySelector("header")?.offsetHeight ?? 64) + 32
            : toc.getBoundingClientRect().bottom + 24

          let current = targets[0].id

          targets.forEach((target) => {
            if (target.getBoundingClientRect().top <= line) {
              current = target.id
            }
          })

          setActive(current)
        }

        const schedule = () => {
          if (!frame) frame = requestAnimationFrame(update)
        }

        links.forEach((link) => {
          link.addEventListener("click", () => {
            setActive(link.hash.slice(1))
            if (panel && !desktop.matches) panel.open = false
          })
        })

        window.addEventListener("scroll", schedule, { passive: true })
        window.addEventListener("resize", schedule, { passive: true })
        update()
      }

      const openFromHash = () => {
        const id = decodeURIComponent(window.location.hash.slice(1))
        if (!id) return

        const el = document.getElementById(id)
        if (!el || el.tagName !== "DETAILS") return

        el.open = true
        requestAnimationFrame(() => {
          el.scrollIntoView({ block: "start" })
        })
      }

      window.addEventListener("hashchange", openFromHash)
      openFromHash()
    })()
  </script>
</Layout>
