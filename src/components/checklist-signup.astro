---
import { mailerLiteFormId } from "@/data/mailing"
import { Download } from "lucide-react"

const pdfPath = "/checklista/12-pytan-przed-budowa-aplikacji.pdf"
---

<div>
  <p class="text-base leading-relaxed text-pretty font-medium text-ink sm:text-lg">
    Pobierz checklistę bez podawania adresu e-mail:
  </p>
  <a
    href={pdfPath}
    download
    data-checklist-download
    class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
  >
    Pobierz PDF — 12 pytań, 4 strony
    <Download className="size-4" aria-hidden="true" />
  </a>

  <p class="mt-4 max-w-xl text-sm leading-relaxed text-pretty text-ink-soft">
    Jeżeli chcesz także otrzymywać moje wiadomości e-mail, możesz dobrowolnie
    zapisać się do newslettera poniżej. Nie musisz się zapisywać, żeby pobrać
    checklistę.
  </p>

  <div class="ml-embedded mt-6 w-fit" data-form={mailerLiteFormId}></div>
</div>
