---
interface Column {
  status: string
  tone: "done" | "tested" | "considered"
  items: string[]
}

interface Props {
  id?: string
  label: string
  title: string
  columns: Column[]
  note?: string
}

const { id = "rozwoj", label, title, columns, note } = Astro.props

const dotClass: Record<Column["tone"], string> = {
  done: "bg-signal",
  tested: "bg-signal/50",
  considered: "bg-line",
}
---

<section
  id={id}
  class="border-t border-line bg-paper px-4 py-12 sm:px-6 sm:py-16"
>
  <div class="mx-auto max-w-[75rem]">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-3">
        <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
          {label}
        </p>
      </div>

      <div class="lg:col-span-9">
        <h2 class="max-w-[26ch] font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
          {title}
        </h2>

        <div class="mt-8 grid grid-cols-1 gap-8 border-t border-line pt-8 sm:grid-cols-3 sm:gap-10">
          {columns.map(({ status, tone, items }) => (
            <div>
              <h3 class="flex items-center gap-2.5 font-mono text-[10px] tracking-[0.16em] text-ink-soft uppercase">
                <span
                  class:list={["size-2 rounded-full", dotClass[tone]]}
                  aria-hidden="true"
                />
                {status}
              </h3>
              <ul class="mt-4 space-y-2.5">
                {items.map((item) => (
                  <li class="text-sm leading-relaxed text-pretty text-ink">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {note && (
          <p class="mt-8 max-w-[42rem] text-sm leading-relaxed text-ink-soft">
            {note}
          </p>
        )}
      </div>
    </div>
  </div>
</section>
