---
interface Props {
  id?: string
  label: string
  title: string
  intro: string
  questions: string[]
  note?: string
}

const { id = "reakcje", label, title, intro, questions, note } = Astro.props
---

<section
  id={id}
  class="border-t border-line bg-surface-muted px-4 py-12 sm:px-6 sm:py-16"
>
  <div class="mx-auto max-w-[75rem]">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-3">
        <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
          {label}
        </p>
      </div>

      <div class="lg:col-span-9">
        <h2 class="max-w-[26ch] font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
          {title}
        </h2>
        <p class="mt-4 max-w-[40rem] text-[16px] leading-[1.7] text-pretty text-ink-soft">
          {intro}
        </p>

        <ol class="mt-8 grid grid-cols-1 gap-x-10 border-t border-line sm:grid-cols-2">
          {questions.map((question, index) => (
            <li class="flex items-start gap-4 border-b border-line py-4">
              <span
                class="font-mono text-[11px] text-signal-ink tabular-nums"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="text-sm leading-relaxed text-pretty text-ink sm:text-[15px]">
                {question}
              </span>
            </li>
          ))}
        </ol>

        {note && (
          <p class="mt-8 max-w-[42rem] text-sm leading-relaxed text-ink-soft">
            {note}
          </p>
        )}

        <slot />
      </div>
    </div>
  </div>
</section>
