---
interface Stage {
  week: string
  title: string
  text: string
}

interface Props {
  id?: string
  label: string
  title: string
  intro: string
  stages: Stage[]
  note?: string
}

const { id = "harmonogram", label, title, intro, stages, note } = Astro.props
---

<section
  id={id}
  class="border-t border-line bg-surface-muted px-4 py-12 sm:px-6 sm:py-16"
>
  <div class="mx-auto max-w-[75rem]">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-3">
        <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
          {label}
        </p>
      </div>

      <div class="lg:col-span-9">
        <h2 class="max-w-[26ch] font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
          {title}
        </h2>
        <p class="mt-4 max-w-[40rem] text-[16px] leading-[1.7] text-pretty text-ink-soft">
          {intro}
        </p>

        <ol class="mt-8 border-t border-line">
          {stages.map(({ week, title: stageTitle, text }, index) => (
            <li class="grid grid-cols-[4.5rem_1fr] gap-x-5 gap-y-2 border-b border-line py-6 sm:grid-cols-[7rem_1fr] sm:items-baseline sm:gap-8">
              <div>
                <span class="block font-mono text-[10px] tracking-[0.14em] text-signal-ink uppercase">
                  {week}
                </span>
                <span
                  class="mt-1 block font-mono text-[10px] text-ink-soft tabular-nums"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <div>
                <h3 class="font-heading text-lg leading-snug font-semibold text-ink">
                  {stageTitle}
                </h3>
                <p class="mt-1.5 max-w-[38rem] text-sm leading-relaxed text-pretty text-ink-soft">
                  {text}
                </p>
              </div>
            </li>
          ))}
        </ol>

        {note && (
          <p class="mt-8 max-w-[42rem] text-sm leading-relaxed text-ink-soft">
            {note}
          </p>
        )}
      </div>
    </div>
  </div>
</section>
