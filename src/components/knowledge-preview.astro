---
import { Image } from "astro:assets"
import { ArrowRight } from "lucide-react"
import { getCollection } from "astro:content"
import SectionHeading from "@/components/section-heading.astro"
import { getReadingTime } from "@/lib/reading-time"
import { wiedzaArticlePath, wiedzaCategoryLabel } from "@/data/wiedza"
import { wiedzaImageFor } from "@/data/wiedza-images"

const entries = (await getCollection("wiedza")).sort(
  (a, b) => a.data.order - b.data.order
)
const highlights = entries.slice(0, 3)

const summaryFor = (entry: (typeof entries)[number]) => {
  const text = (entry.data.cardDescription ?? entry.data.description)
    .replace(/\s+/g, " ")
    .trim()
  return text.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? text
}
---

{highlights.length > 0 && (
  <section class="section-y border-t border-line bg-surface-muted">
    <div class="shell">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          eyebrow="09 · Wiedza"
          title="Zanim zaczniesz budować aplikację."
          class="max-w-2xl"
        />
        <a
          href="/wiedza/"
          class="inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
        >
          Wszystkie artykuły
          <ArrowRight className="size-4" aria-hidden="true" />
        </a>
      </div>

      <ul class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-3">
        {highlights.map((entry) => {
          const image = wiedzaImageFor(entry.id)
          return (
            <li class="border-t border-line pt-5">
              <a
                href={wiedzaArticlePath(entry.id)}
                class="group grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal sm:block"
              >
                {image && (
                  <div class="overflow-hidden rounded-lg border border-line">
                    <Image
                      src={image.src}
                      alt={image.alt}
                      widths={[320, 480, 640, 800]}
                      sizes="(min-width: 768px) 30vw, 120px"
                      quality={80}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover"
                    />
                  </div>
                )}
                <div>
                  <p class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase sm:mt-4">
                    {wiedzaCategoryLabel(entry.data.category)}
                    {getReadingTime(entry.body)
                      ? ` · ${getReadingTime(entry.body)} min`
                      : ""}
                  </p>
                  <h3 class="mt-3 font-heading text-lg leading-snug font-semibold text-balance underline-offset-4 group-hover:underline">
                    {entry.data.title}
                  </h3>
                  <p class="copy mt-2 text-sm">{summaryFor(entry)}</p>
                </div>
              </a>
            </li>
          )
        })}
      </ul>
    </div>
  </section>
)}
