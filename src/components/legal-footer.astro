---
const year = 2026
const links = [
  { label: "Polityka prywatności", href: "/polityka-prywatnosci/" },
  { label: "FAQ", href: "/faq/" },
  { label: "Oferta", href: "/oferta/" },
  { label: "Rozmowa", href: "/rozmowa/" },
]
---

<footer class="on-ink border-t border-paper/15 bg-footer px-4 py-10 text-paper sm:px-6 sm:py-12">
  <div class="shell">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <img
          src="/logo-compact-on-dark.svg"
          alt="Karol Modelski"
          width="865"
          height="152"
          class="h-8 w-auto dark:hidden"
        />
        <img
          src="/logo-compact.svg"
          alt=""
          aria-hidden="true"
          width="865"
          height="152"
          class="hidden h-8 w-auto dark:block"
        />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-paper/70">
          Dokumenty prawne, informacje o przetwarzaniu danych i kontakt w
          sprawach prywatności.
        </p>
        <a
          href="mailto:kontakt@karolmodelski.pl"
          class="mt-4 inline-flex min-h-11 items-center text-sm font-medium text-paper underline decoration-paper/25 underline-offset-4 transition-colors hover:decoration-signal"
        >
          kontakt@karolmodelski.pl
        </a>
      </div>

      <div class="lg:col-span-3">
        <h2 class="font-mono text-[10px] tracking-[0.18em] text-paper/60 uppercase">
          Dokumenty i serwis
        </h2>
        <ul class="mt-3 space-y-1">
          {links.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="inline-flex min-h-11 items-center text-sm text-paper/80 underline-offset-4 transition-colors hover:text-paper hover:underline"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h2 class="font-mono text-[10px] tracking-[0.18em] text-paper/60 uppercase">
          Dane firmy
        </h2>
        <address class="mt-3 text-sm leading-relaxed text-paper/70 not-italic">
          Karol Modelski
          <br />
          ul. Mieczysława Karłowicza 1/40
          <br />
          58-506 Jelenia Góra
        </address>
        <p class="mt-3 font-mono text-xs leading-relaxed text-paper/60">
          NIP 6112800950 · REGON 383132957
        </p>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-paper/15 pt-5 font-mono text-xs text-paper/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Karol Modelski · Wszelkie prawa zastrzeżone.</p>
      <div class="flex flex-wrap items-center gap-x-5">
        <a
          href="/polityka-prywatnosci/"
          class="inline-flex min-h-11 items-center underline-offset-4 transition-colors hover:text-paper hover:underline"
        >
          Polityka prywatności
        </a>
        <p class="inline-flex min-h-11 items-center">NIP 6112800950</p>
      </div>
    </div>
  </div>
</footer>
