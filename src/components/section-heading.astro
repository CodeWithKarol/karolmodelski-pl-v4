---
interface Props {
  /** Numer i krótka etykieta, np. „01 · Realizacja”. */
  eyebrow?: string
  title: string
  lead?: string
  tone?: "light" | "dark"
  /** Dodatkowe klasy dla nagłówka (szerokość, marginesy). */
  class?: string
}

const { eyebrow, title, lead, tone = "light", class: className } = Astro.props
---

<div class:list={["max-w-3xl", className]}>
  {eyebrow && (
    <p
      class:list={[
        "flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] uppercase",
        tone === "dark" ? "text-paper/60" : "text-ink-soft",
      ]}
    >
      <span class="h-px w-6 shrink-0 bg-signal" aria-hidden="true" />
      {eyebrow}
    </p>
  )}
  <h2
    class:list={[
      "mt-5 font-heading text-[clamp(1.75rem,1.2rem+2.2vw,3.25rem)] leading-[1.08] font-semibold tracking-tight text-balance",
      tone === "dark" ? "text-paper" : "text-ink",
    ]}
  >
    {title}
  </h2>
  {lead && (
    <p
      class:list={[
        "mt-5 text-lg leading-relaxed text-pretty sm:text-xl",
        tone === "dark" ? "text-paper/80" : "text-ink-soft",
      ]}
    >
      {lead}
    </p>
  )}
</div>
