---
import { Check } from "lucide-react"

interface Props {
  id?: string
  label: string
  title: string
  items: string[]
}

const { id = "zakres", label, title, items } = Astro.props
---

<section
  id={id}
  class="border-t border-line bg-paper px-4 py-12 sm:px-6 sm:py-16"
>
  <div class="mx-auto max-w-[75rem]">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-3">
        <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
          {label}
        </p>
      </div>

      <div class="lg:col-span-9">
        <h2 class="font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
          {title}
        </h2>

        <ul class="mt-8 grid grid-cols-1 gap-x-10 border-t border-line md:grid-cols-2">
          {items.map((item) => (
            <li class="flex items-start gap-3 border-b border-line py-4">
              <Check
                className="mt-0.5 size-4 shrink-0 text-signal"
                aria-hidden="true"
              />
              <span class="text-[15px] leading-relaxed text-pretty text-ink sm:text-base">
                {item}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
