---
interface Item {
  label: string
  text: string
}

interface Props {
  id?: string
  label: string
  title: string
  items: Item[]
}

const { id = "wyzwanie", label, title, items } = Astro.props
---

<section
  id={id}
  class="border-t border-line bg-paper px-4 py-12 sm:px-6 sm:py-16"
>
  <div class="mx-auto max-w-[75rem]">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-3">
        <p class="font-mono text-[10px] tracking-[0.2em] text-ink-soft uppercase lg:sticky lg:top-24">
          {label}
        </p>
      </div>

      <div class="lg:col-span-9">
        <h2 class="font-heading text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.12] font-semibold tracking-tight text-balance">
          {title}
        </h2>

        <ol class="mt-8 grid grid-cols-1 gap-8 border-t border-line pt-8 sm:grid-cols-3 sm:gap-10">
          {items.map(({ label: itemLabel, text }, index) => (
            <li class="border-line">
              <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
                  {itemLabel}
                </span>
                <span
                  class="font-mono text-[11px] text-ink-soft tabular-nums"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <p class="mt-3 text-[15px] leading-[1.65] text-pretty text-ink sm:text-base">
                {text}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
