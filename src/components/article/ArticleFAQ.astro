---
import { ChevronDown } from "lucide-react"

interface Props {
  faq: { question: string; answer: string }[]
}

const { faq } = Astro.props
---

{faq.length > 0 && (
  <section aria-labelledby="faq" class="border-t border-line pt-8">
    <h2
      id="faq"
      class="scroll-mt-28 font-heading text-[1.75rem] leading-tight font-semibold tracking-tight sm:text-[2rem]"
    >
      Najczęstsze pytania
    </h2>
    <div class="mt-5 divide-y divide-line border-y border-line">
      {faq.map(({ question, answer }) => (
        <details class="group">
          <summary class="flex min-h-12 cursor-pointer list-none items-start justify-between gap-6 py-4 [&::-webkit-details-marker]:hidden">
            <span class="font-heading text-[16px] leading-snug font-semibold text-balance text-ink sm:text-[17px]">
              {question}
            </span>
            <ChevronDown
              className="mt-0.5 size-5 shrink-0 text-ink-soft transition-transform group-open:rotate-180 motion-reduce:transition-none"
              aria-hidden="true"
            />
          </summary>
          <p class="max-w-2xl pb-4 text-[15px] leading-[1.7] text-pretty text-ink-soft">
            {answer}
          </p>
        </details>
      ))}
    </div>
  </section>
)}
