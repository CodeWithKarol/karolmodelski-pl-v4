---
import type { CollectionEntry } from "astro:content"
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import { formatDate } from "@/lib/format"
import portrait from "@/assets/images/karol-modelski-portrait.webp"

interface Props {
  entry: CollectionEntry<"wiedza">
  categoryLabel: string
  readingTime: number | null
  cover?: { src: ImageMetadata; alt: string }
}

const { entry, categoryLabel, readingTime, cover } = Astro.props

const publishedAt = entry.data.publishedAt
const updatedAt = entry.data.updatedAt
const showUpdatedAt =
  updatedAt && publishedAt
    ? updatedAt.getTime() > publishedAt.getTime()
    : Boolean(updatedAt)
---

<header>
  <div class="shell article-shell">
    <nav aria-label="Ścieżka nawigacji">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
        <li>
          <a class="transition-colors hover:text-ink" href="/">
            Strona główna
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a class="transition-colors hover:text-ink" href="/wiedza/">
            Wiedza
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a
            class="transition-colors hover:text-ink"
            href={`/wiedza/?kategoria=${entry.data.category}#poradniki`}
          >
            {categoryLabel}
          </a>
        </li>
      </ol>
    </nav>

    <div class="mt-8 max-w-4xl sm:mt-10">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
        <span>{categoryLabel}</span>
        {readingTime && (
          <>
            <span class="h-px w-4 bg-line" aria-hidden="true"></span>
            <span class="text-ink-soft">{readingTime} min czytania</span>
          </>
        )}
      </p>

      <h1 class="mt-5 font-heading text-[clamp(2.5rem,1.7rem+2.3vw,4rem)] leading-[1.04] font-semibold tracking-tight text-balance">
        {entry.data.h1 ?? entry.data.title}
      </h1>

      <p class="mt-5 max-w-3xl text-[1.1875rem] leading-[1.6] text-pretty text-ink-soft sm:text-[1.3125rem]">
        {entry.data.lead ?? entry.data.description}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 border-y border-line py-4">
        <div class="flex items-center gap-3">
          <Image
            src={portrait}
            alt="Karol Modelski"
            widths={[80, 120, 160]}
            sizes="40px"
            quality={82}
            loading="eager"
            decoding="async"
            class="size-10 rounded-full border border-line object-cover"
          />
          <div>
            <p class="text-sm font-medium text-ink">Karol Modelski</p>
            <p class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
              Autor
            </p>
          </div>
        </div>

        {(publishedAt || updatedAt) && (
          <>
            <div
              class="hidden h-8 w-px bg-line sm:block"
              aria-hidden="true"
            ></div>
            <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[10px] tracking-[0.1em] text-ink-soft uppercase">
              {publishedAt && (
                <p>
                  Opublikowano{" "}
                  <time datetime={publishedAt.toISOString()}>
                    {formatDate(publishedAt)}
                  </time>
                </p>
              )}
              {showUpdatedAt && updatedAt && (
                <p>
                  Zaktualizowano{" "}
                  <time datetime={updatedAt.toISOString()}>
                    {formatDate(updatedAt)}
                  </time>
                </p>
              )}
            </div>
          </>
        )}
      </div>
    </div>
  </div>

  {cover && (
    <div class="shell article-shell mt-8 sm:mt-10">
      <Image
        src={cover.src}
        alt={cover.alt}
        widths={[640, 960, 1280, 1448]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        quality={82}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/3] w-full rounded-lg border border-line object-cover sm:aspect-[16/9]"
      />
    </div>
  )}
</header>
