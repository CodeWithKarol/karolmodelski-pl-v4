---
import { Image } from "astro:assets"
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import checklistPreview from "@/assets/images/checklista-preview.png"

interface Props {
  download: {
    title: string
    description: string
    href: string
    label: string
    meta?: string
    note?: string
  }
}

const { download } = Astro.props
---

<aside
  data-article-download
  class="border-y border-line bg-surface-muted px-5 py-7 sm:px-8 sm:py-8"
>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-[minmax(0,1fr)_7rem] sm:items-center sm:gap-8">
    <div>
      <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
        Bezpłatna checklista
      </p>
      <h2 class="mt-3 font-heading text-2xl leading-[1.15] font-semibold tracking-tight text-balance">
        {download.title}
      </h2>
      <p class="mt-2 text-[15px] leading-relaxed text-pretty text-ink-soft">
        {download.description}
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a
          href={download.href}
          class={cn(
            buttonVariants({ size: "lg" }),
            "h-auto min-h-11 gap-2 rounded-[6px] px-5 py-2.5 text-center text-sm text-balance whitespace-normal"
          )}
        >
          {download.label}
          <ArrowRight aria-hidden="true" />
        </a>
        {download.meta && (
          <p class="font-mono text-[10px] tracking-[0.14em] text-ink-soft uppercase">
            {download.meta}
          </p>
        )}
      </div>

      {download.note && (
        <p class="mt-3 text-[13px] leading-relaxed text-ink-soft">
          {download.note}
        </p>
      )}
    </div>

    <div
      aria-hidden="true"
      class="mx-auto w-full max-w-[7rem] overflow-hidden rounded-lg border border-line bg-paper sm:mx-0"
    >
      <Image
        src={checklistPreview}
        alt=""
        widths={[160, 240, 320]}
        sizes="112px"
        quality={80}
        loading="lazy"
        decoding="async"
        class="h-auto w-full"
      />
    </div>
  </div>
</aside>
