---
import { Image } from "astro:assets"
import SectionHeading from "@/components/section-heading.astro"
import laptopDesk from "@/assets/images/numerabble-laptop-desk.webp"

const outcomes = [
  {
    title: "Sprawdzisz najważniejszą funkcję",
    description: "Sam, bez pośredników i wersji demonstracyjnych.",
  },
  {
    title: "Pokażesz produkt innym",
    description: "Wyślesz link partnerowi lub pierwszym testerom.",
  },
  {
    title: "Zobaczysz pierwsze zachowania",
    description: "Podstawowa analityka pokaże, z czego korzystają.",
  },
  {
    title: "Podejmiesz decyzję o kolejnym kroku",
    description: "Na podstawie doświadczeń, nie założeń.",
  },
]
---

<section id="efekt" class="section-y border-t border-line bg-surface-muted">
  <div class="shell">
    <SectionHeading
      eyebrow="03 · Po 4 tygodniach"
      title="Po 4 tygodniach masz produkt, który działa."
      lead="Pierwsza wersja w uzgodnionym zakresie — do uruchomienia w przeglądarce."
    />

    <div
      id="otrzymujesz"
      class="mt-12 grid grid-cols-1 gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-7">
        <ol class="grid grid-cols-1 gap-x-10 gap-y-0 md:grid-cols-2">
          {outcomes.map(({ title, description }, index) => (
            <li class="border-t border-line py-6 lg:py-8">
              <span class="font-mono text-xs tracking-[0.16em] text-signal-ink">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-3 font-heading text-lg leading-snug font-semibold text-balance">
                {title}
              </h3>
              <p class="copy mt-2 text-sm">{description}</p>
            </li>
          ))}
        </ol>

        <p class="mt-8 max-w-2xl border-t border-line pt-6 text-base leading-relaxed text-pretty text-ink-soft">
          Nie obiecuję sukcesu rynkowego.{" "}
          <span class="font-medium text-ink">
            Daję działający produkt i narzędzia do sprawdzenia pomysłu.
          </span>
        </p>
      </div>

      <figure class="mx-auto w-full max-w-xl lg:col-span-5 lg:max-w-none">
        <Image
          src={laptopDesk}
          alt="Numerabble uruchomiony na laptopie, obok notatnik ze szkicem interfejsu"
          widths={[480, 640, 800, 1086, 1448]}
          sizes="(min-width: 1024px) 40vw, calc(100vw - 2rem)"
          quality={82}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-xl border border-line object-cover"
        />
      </figure>
    </div>
  </div>
</section>
