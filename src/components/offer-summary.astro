---
import { ArrowRight, Check } from "lucide-react"
import SectionHeading from "@/components/section-heading.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"

const scope = [
  "Plan pierwszej wersji — wybór najważniejszej funkcji, zasady działania i kryteria odbioru",
  "Projekt wyglądu i sposób obsługi kluczowych ekranów",
  "Działająca aplikacja w przeglądarce, prosta strona produktu i podstawowa analityka",
  "Plan pierwszych testów, koordynacja realizacji i trzy punkty kontrolne",
  "Testy techniczne, poprawki, przekazanie kodu, dostępów i praw oraz podsumowanie kolejnych kroków",
]
---

<section id="oferta" class="section-y border-t border-line bg-paper">
  <div class="shell">
    <SectionHeading
      eyebrow="04 · Oferta"
      title="Jeden zakres. Jedna cena. Pierwsza wersja w 4 tygodnie."
      lead="Zakres potrzebny do uruchomienia pierwszej wersji — od pomysłu po działającą aplikację."
      class="max-w-4xl"
    />

    <div class="mt-12 grid grid-cols-1 gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="font-mono text-[11px] tracking-[0.16em] text-signal-ink uppercase">
          Pierwsza działająca wersja aplikacji
        </p>
        <p class="mt-3 font-heading text-[clamp(2.5rem,1.8rem+2.4vw,3.5rem)] leading-none font-semibold tracking-tight text-signal-ink">
          29 500 zł
          <span class="ml-2 text-base font-medium tracking-normal text-ink-soft">
            brutto
          </span>
        </p>
        <p class="mt-3 text-sm leading-relaxed font-medium text-ink">
          4 tygodnie do pierwszej wersji · zwykle 6–8 tygodni całego procesu
        </p>

        <p class="mt-8 font-heading text-base font-semibold">W pakiecie:</p>
        <ul class="mt-4 grid grid-cols-1 gap-3">
          {scope.map((item) => (
            <li class="flex items-start gap-3">
              <Check
                className="mt-1 size-4 shrink-0 text-signal"
                aria-hidden="true"
              />
              <span class="text-[0.9375rem] leading-relaxed text-pretty text-ink">
                {item}
              </span>
            </li>
          ))}
        </ul>

        <div id="rozliczenie" class="mt-8 border-t border-line pt-5">
          <p class="text-sm leading-relaxed text-pretty text-ink-soft">
            Płatność w 3 etapach (40% / 40% / 20%) · 3 miesiące gwarancji
            technicznej na warunkach zapisanych w umowie.
          </p>
          <a
            href="/oferta/#platnosci"
            class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
          >
            Zobacz harmonogram płatności
            <ArrowRight className="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-xl border border-line bg-surface-muted p-6 sm:p-8">
          <h3 class="font-heading text-xl leading-snug font-semibold text-balance">
            Sprawdźmy, czy Twój pomysł pasuje do pakietu.
          </h3>
          <p class="copy mt-3 text-sm">
            Wstępnie ocenimy zakres i powiemy wprost, jeśli projekt wymaga
            innego podejścia.
          </p>

          <a
            href="/rozmowa/"
            class={cn(
              buttonVariants({ size: "lg" }),
              "mt-6 h-auto min-h-12 w-full gap-2 rounded-[6px] px-5 py-3 text-center text-sm text-balance whitespace-normal sm:text-base"
            )}
          >
            Umów bezpłatną rozmowę
            <ArrowRight />
          </a>
          <p class="mt-3 text-center text-sm leading-relaxed text-ink-soft">
            Bezpłatna rozmowa · 20 minut · Bez zobowiązań
          </p>

          <div class="mt-6 border-t border-line pt-5">
            <a
              href="/oferta/"
              class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
            >
              Pełny zakres oferty
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>

        <p class="mt-4 text-xs leading-relaxed text-pretty text-ink-soft">
          Nie każda aplikacja kwalifikuje się do tego pakietu. Sprawdzamy to
          przed rozpoczęciem współpracy.
        </p>
      </div>
    </div>
  </div>
</section>
