---
import { ArrowRight, Mail, MessageCircle } from "lucide-react"

const pageLinks = [
  { label: "Oferta", href: "/oferta/" },
  { label: "Jak pracuję", href: "/jak-pracuje/" },
  { label: "Realizacje", href: "/realizacje/" },
  { label: "FAQ", href: "/faq/" },
  { label: "Wiedza", href: "/wiedza/" },
  { label: "O mnie", href: "/o-mnie/" },
]

const principles = [
  "NDA przed szczegółową rozmową",
  "Stała cena za uzgodniony zakres",
  "Płatności 40% / 40% / 20%",
  "Kod i prawa w zakresie określonym w umowie",
  "3 miesiące gwarancji technicznej",
]
---

<footer class="on-ink border-t border-paper/15 bg-footer px-4 py-12 text-paper sm:px-6 sm:py-16">
  <div class="shell">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <img
          src="/logo-compact-on-dark.svg"
          alt="Karol Modelski — Consulting Technologiczny"
          width="865"
          height="152"
          class="h-9 w-auto dark:hidden"
        />
        <img
          src="/logo-compact.svg"
          alt=""
          aria-hidden="true"
          width="865"
          height="152"
          class="hidden h-9 w-auto dark:block"
        />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-paper/70">
          Zamieniam pomysły w działające aplikacje — od zakresu po przekazanie
          kodu i praw.
        </p>
        <a
          href="/rozmowa/"
          class="mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-paper underline decoration-paper/25 underline-offset-4 transition-colors hover:decoration-signal"
        >
          Umów bezpłatną rozmowę
          <ArrowRight className="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="lg:col-span-4">
        <h2 class="font-mono text-[11px] tracking-[0.18em] text-paper/60 uppercase">
          Kontakt
        </h2>
        <ul class="mt-4 space-y-1">
          <li>
            <a
              href="mailto:kontakt@karolmodelski.pl"
              class="inline-flex min-h-11 items-center gap-2 text-sm underline-offset-4 hover:text-signal-bright hover:underline"
            >
              <Mail className="size-4 shrink-0 text-paper/60" />
              kontakt@karolmodelski.pl
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/48664598563"
              class="inline-flex min-h-11 items-center gap-2 text-sm underline-offset-4 hover:text-signal-bright hover:underline"
            >
              <MessageCircle className="size-4 shrink-0 text-paper/60" />
              +48 664 598 563
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/karol-modelski/"
              rel="me noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center text-sm underline-offset-4 hover:text-signal-bright hover:underline"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://g.page/r/CZSVfAGtTiIzEBM"
              rel="me noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center text-sm underline-offset-4 hover:text-signal-bright hover:underline"
            >
              Wizytówka w Google
            </a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h2 class="font-mono text-[11px] tracking-[0.18em] text-paper/60 uppercase">
          Strona
        </h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-6">
          {pageLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="inline-flex min-h-11 items-center text-sm underline-offset-4 hover:text-signal-bright hover:underline"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-1 border-t border-paper/15 pt-5 font-mono text-[11px] leading-relaxed tracking-[0.12em] text-paper/60 uppercase">
      {principles.map((principle) => (
        <li>{principle}</li>
      ))}
    </ul>

    <p class="mt-3 max-w-2xl text-xs leading-relaxed text-paper/60">
      Faktury VAT. Koszty zewnętrzne (domena, serwery, usługi) i licencje
      komponentów zewnętrznych ustalamy osobno.
    </p>

    <div class="mt-6 flex flex-col gap-2 border-t border-paper/15 pt-5 font-mono text-xs text-paper/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Karol Modelski · Wszelkie prawa zastrzeżone.</p>
      <div class="flex flex-wrap items-center gap-x-5">
        <a
          href="/polityka-prywatnosci/"
          class="inline-flex min-h-11 items-center underline-offset-4 transition-colors hover:text-signal-bright hover:underline"
        >
          Polityka prywatności
        </a>
        <p class="inline-flex min-h-11 items-center">NIP 6112800950</p>
      </div>
    </div>
  </div>
</footer>
