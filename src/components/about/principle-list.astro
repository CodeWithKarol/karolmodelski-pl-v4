---
interface Principle {
  title: string
  description: string
}

interface Props {
  items: Principle[]
}

const { items } = Astro.props
---

<ol class="grid grid-cols-1 gap-x-12 md:grid-cols-2">
  {items.map((item, index) => (
    <li class="border-t border-line py-7">
      <span
        class="font-heading text-3xl leading-none font-semibold text-signal-ink sm:text-4xl"
        aria-hidden="true"
      >
        {String(index + 1).padStart(2, "0")}
      </span>
      <h3 class="mt-3 font-heading text-xl leading-snug font-semibold text-balance text-ink">
        {item.title}
      </h3>
      <p class="mt-2 max-w-md text-[15px] leading-[1.65] text-pretty text-ink-soft">
        {item.description}
      </p>
    </li>
  ))}
</ol>
