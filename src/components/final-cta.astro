---
import { ArrowRight } from "lucide-react"
import SectionHeading from "@/components/section-heading.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
---

<section
  id="kontakt"
  class="on-ink section-y border-t border-line bg-ink text-paper"
>
  <div class="shell">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHeading
          eyebrow="10 · Kontakt"
          title="Twój pomysł nie musi zostać pomysłem."
          lead="Opowiesz mi o nim własnymi słowami. W 20 minut sprawdzimy, czy pierwsza wersja pasuje do pakietu."
          tone="dark"
        />
      </div>

      <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
        <a
          href="/rozmowa/"
          class={cn(
            buttonVariants({ size: "lg" }),
            "h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85"
          )}
        >
          Umów bezpłatną rozmowę
          <ArrowRight />
        </a>
        <p class="mt-3 text-sm leading-relaxed text-paper/60">
          20 minut · Online · Bez zobowiązań
        </p>

        <div class="mt-6 border-t border-paper/15 pt-5 text-sm leading-relaxed text-paper/60">
          <p>
            Wolisz napisać?{" "}
            <a
              href="mailto:kontakt@karolmodelski.pl"
              class="font-medium text-paper underline underline-offset-4 hover:no-underline"
            >
              kontakt@karolmodelski.pl
            </a>
          </p>
          <p class="mt-3">
            Nie musisz przygotowywać dokumentacji. Jeśli zależy Ci na poufności,
            możemy najpierw podpisać NDA.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
