---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  image?: { src: ImageMetadata; alt: string }
  order: number
  category: string
  sizes: string
  priority?: boolean
}

const { image, order, category, sizes, priority = false } = Astro.props
---

{image ? (
  <div class="overflow-hidden rounded-lg border border-line bg-surface-muted">
    <Image
      src={image.src}
      alt={image.alt}
      widths={[400, 600, 800, 1000, 1200]}
      sizes={sizes}
      quality={82}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      decoding="async"
      class="aspect-[3/2] w-full object-cover"
    />
  </div>
) : (
  <div
    aria-hidden="true"
    class="relative flex aspect-[3/2] flex-col justify-between overflow-hidden rounded-lg border border-line bg-surface-muted p-4 sm:p-5"
  >
    <div class="flex items-start justify-between gap-4">
      <span class="font-mono text-[10px] tracking-[0.14em] text-signal-ink uppercase">
        {category}
      </span>
      <span class="font-mono text-[10px] text-ink-soft">
        {String(order).padStart(2, "0")}
      </span>
    </div>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -right-8 -bottom-10 size-36 rounded-full border border-line"
    />
    <div class="relative">
      <span class="block h-px w-10 bg-signal" />
      <p class="mt-3 font-mono text-[9px] tracking-[0.12em] text-ink-soft uppercase">
        Okładka wkrótce
      </p>
    </div>
  </div>
)}
