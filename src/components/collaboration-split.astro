---
import { ArrowRight } from "lucide-react"
import SectionHeading from "@/components/section-heading.astro"

const questions = [
  "Kto naprawdę zrozumie, co chcę stworzyć?",
  "Jak zabezpieczyć pomysł, zanim komuś go powiem?",
  "Od czego zacząć, żeby nie budować wszystkiego naraz?",
]

const steps = [
  {
    label: "Ty",
    title: "Opowiadasz o pomyśle",
    description: "Własnymi słowami. Notatki i szkice wystarczą.",
  },
  {
    label: "Ty i ja",
    title: "Wspólnie ustalamy zakres",
    description: "Wybieramy najważniejszą funkcję, resztę odkładamy.",
  },
  {
    label: "Ja",
    title: "Prowadzę realizację",
    description:
      "Organizuję zespół i techniczną stronę projektu. Ty oceniasz efekty.",
  },
]
---

<section id="problemy" class="section-y border-t border-line bg-paper">
  <div class="shell">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="02 · Problem i współpraca"
          title="Masz pomysł, ale nie wiesz, komu go powierzyć?"
          lead="To pytanie słyszę najczęściej. Odpowiedź zaczyna się od uporządkowania pomysłu, nie od wyboru technologii."
        />

        <ol class="mt-10 border-t border-line">
          {questions.map((question, index) => (
            <li class="flex items-baseline gap-4 border-b border-line py-4 sm:gap-5">
              <span
                class="font-mono text-xs tracking-[0.16em] text-signal-ink"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="font-heading text-lg leading-snug font-semibold text-balance text-ink">
                {question}
              </p>
            </li>
          ))}
        </ol>
      </div>

      <div
        id="model"
        class="lg:col-span-6 lg:col-start-7 lg:border-l lg:border-line lg:pl-12"
      >
        <p class="font-mono text-[11px] tracking-[0.18em] text-ink-soft uppercase">
          Jak to wygląda w praktyce
        </p>

        <ol class="mt-6">
          {steps.map(({ label, title, description }, index) => (
            <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4 border-t border-line py-5 sm:grid-cols-[3rem_minmax(0,1fr)] sm:gap-6">
              <span class="font-mono text-xs text-ink-soft">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <p class="font-mono text-[10px] tracking-[0.16em] text-signal-ink uppercase">
                  {label}
                </p>
                <h3 class="mt-1.5 font-heading text-lg leading-snug font-semibold text-balance sm:text-xl">
                  {title}
                </h3>
                <p class="copy mt-1.5 text-sm">{description}</p>
              </div>
            </li>
          ))}
        </ol>

        <p class="mt-6 flex items-start gap-3 font-heading text-lg leading-snug text-balance text-ink">
          <span class="mt-2.5 h-px w-6 shrink-0 bg-signal" aria-hidden="true" />
          <span>
            Ty podejmujesz decyzje o produkcie. Ja odpowiadam za realizację.
          </span>
        </p>

        <a
          href="/jak-pracuje/"
          class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-signal"
        >
          Zobacz, jak wygląda cała współpraca
          <ArrowRight className="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
