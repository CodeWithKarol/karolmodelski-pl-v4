---
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ArrowRight } from "lucide-react"

interface Props {
  title?: string
  description?: string
  secondaryPrefix?: string
  secondaryLabel?: string
}

const {
  title = "Masz pomysł na aplikację? Sprawdźmy, od czego warto zacząć.",
  description = "Opowiedz mi o swoim pomyśle podczas bezpłatnej, 20-minutowej rozmowy.\n\nWspólnie sprawdzimy, czy da się zbudować jego pierwszą działającą wersję w 4 tygodnie i czy projekt pasuje do pakietu za 29 500 zł brutto.",
  secondaryPrefix = "",
  secondaryLabel = "Zobacz, jak pracuję",
} = Astro.props

const consultationUrl = "https://calendly.com/kontakt-karolmodelski/konsultacja"
---

<section class="border-t border-line bg-paper px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-[75rem]">
    <div class="on-ink relative overflow-hidden rounded-2xl bg-ink px-6 py-10 text-paper sm:px-10 sm:py-12">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -top-32 -right-24 size-80 rounded-full bg-signal/20 blur-3xl"
      ></span>

      <div class="relative max-w-2xl">
        <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] text-paper/60 uppercase">
          <span class="h-px w-5 bg-signal" aria-hidden="true" />
          Bezpłatna rozmowa
        </p>
        <h2 class="mt-4 font-heading text-2xl leading-tight font-semibold tracking-tight text-balance sm:text-3xl">
          {title}
        </h2>
        <div class="mt-4 space-y-3 text-base leading-relaxed text-pretty text-paper/75 sm:text-lg">
          {description.split("\n\n").map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="mt-8">
          <a
            href={consultationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={cn(
              buttonVariants({ size: "lg" }),
              "h-auto min-h-12 w-full gap-2 rounded-[6px] bg-paper px-6 py-3 text-center text-base text-balance whitespace-normal text-ink hover:bg-paper/85 sm:w-auto sm:py-0 sm:whitespace-nowrap"
            )}
          >
            Umów bezpłatną rozmowę
            <ArrowRight />
          </a>

          <p class="mt-4 text-sm leading-relaxed text-paper/55">
            20 minut · Bez zobowiązań · Bez technicznego żargonu
          </p>

          <a
            href="/#proces"
            class="group mt-3 inline-flex min-h-11 flex-wrap items-center gap-x-1.5 text-sm leading-relaxed text-paper/55 transition-colors hover:text-paper"
          >
            {secondaryPrefix && <span>{secondaryPrefix}</span>}
            <span class="underline decoration-paper/25 underline-offset-4 transition-colors group-hover:decoration-signal">
              {secondaryLabel}
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
