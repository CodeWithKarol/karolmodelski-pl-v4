{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/projektowanie-mvp", "destination": "/#proces", "permanent": true },
    {
      "source": "/aplikacje-internetowe-dla-firm",
      "destination": "/#otrzymujesz",
      "permanent": true
    },
    {
      "source": "/doradztwo-techniczne-dla-firm",
      "destination": "/#model",
      "permanent": true
    },
    { "source": "/blog/strategia-it", "destination": "/#model", "permanent": true },
    {
      "source": "/blog/aplikacje-dla-firm",
      "destination": "/#otrzymujesz",
      "permanent": true
    },
    {
      "source": "/blog/szybka-wersja-startowa",
      "destination": "/#proces",
      "permanent": true
    },
    {
      "source": "/blog/bezinwazyjna-modernizacja-systemow",
      "destination": "/#model",
      "permanent": true
    },
    {
      "source": "/blog/ile-trwa-tworzenie-aplikacji",
      "destination": "/#proces",
      "permanent": true
    },
    {
      "source": "/blog/czy-chatgpt-zrobi-aplikacje",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/blog/czy-taniej-jest-stworzyc-aplikacje-samemu",
      "destination": "/#porownanie",
      "permanent": true
    },
    {
      "source": "/blog/jak-stworzyc-aplikacje-ktora-zarabia",
      "destination": "/#proces",
      "permanent": true
    },
    {
      "source": "/blog/jakie-narzedzia-do-modernizacji-aplikacji-webowych",
      "destination": "/#model",
      "permanent": true
    },
    {
      "source": "/blog/jak-wybrac-dostawce-modernizacji-aplikacji",
      "destination": "/#porownanie",
      "permanent": true
    },
    {
      "source": "/blog/ile-kosztuje-stworzenie-aplikacji-dla-firmy",
      "destination": "/#rozliczenie",
      "permanent": true
    },
    {
      "source": "/blog/czy-stworzenie-aplikacji-dla-firmy-jest-trudne",
      "destination": "/#problemy",
      "permanent": true
    },
    { "source": "/blog", "destination": "/", "permanent": true },
    { "source": "/blog/:slug*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://www.facebook.com https://*.facebook.com; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://*.facebook.net; connect-src 'self' https://www.facebook.com https://*.facebook.com https://connect.facebook.net https://*.facebook.net; form-action 'self' https://www.facebook.com https://*.facebook.com; frame-src 'self' https://www.facebook.com https://*.facebook.com https://connect.facebook.net https://*.facebook.net; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
